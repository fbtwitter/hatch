<Page
    x:Class="Hatch.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Hatch.ViewModels"
    xmlns:local="using:Hatch.Views"
    xmlns:converters="using:Hatch.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="StatTileStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="MinHeight" Value="104"/>
        </Style>

        <Style x:Key="StatTileButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}"/>
            <Setter Property="Padding" Value="20"/>
            <!-- 104 fit the old 2-line tiles (Value + Label). My Day now stacks 4 lines
                 (Title, Value, SecondaryValue "0%", Description) — UniformGridLayout's
                 uniform cell height did not grow to fit it, so the extra content was
                 clipped by VerticalContentAlignment=Center instead of the tile growing:
                 the two outer lines (Title, Description) fell outside the cell while the
                 two inner ones (Value, SecondaryValue) stayed visible. Must match
                 UniformGridLayout.MinItemHeight below. -->
            <Setter Property="MinHeight" Value="140"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TaskRowButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="StatIconBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <DataTemplate x:Key="TaskRowTemplate" x:DataType="vm:UpcomingTaskInfo">
            <!-- Tag carries the item: ItemsRepeater does not set DataContext on
                 x:Bind-compiled templates, so the Click handler reads Tag instead. -->
            <Button Style="{StaticResource TaskRowButtonStyle}"
                    Tag="{x:Bind}"
                    AutomationProperties.Name="{x:Bind Title}"
                    Click="TaskRow_Click">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind Title}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Detail}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20">

            <StackPanel Spacing="4">
                <TextBlock x:Uid="Stats_TitleText" Text="Summary" Style="{ThemeResource TitleLargeTextBlockStyle}"/>
            </StackPanel>

            <!-- Responsive KPI grid — UniformGridLayout reflows the column count to fill
                 whatever width is available, instead of a fixed column count. -->
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tiles}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="220" MinItemHeight="140"
                                       MinRowSpacing="16" MinColumnSpacing="16"
                                       ItemsStretch="Fill"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatTileInfo">
                        <!-- Tiles without a NavTag stay visually identical but are inert:
                             not clickable, not in the tab order. None currently ship
                             without one, but Tile_Click / HasNav still guard for it. -->
                        <Button Style="{StaticResource StatTileButtonStyle}"
                                Tag="{x:Bind}"
                                AutomationProperties.Name="{x:Bind AutomationName}"
                                IsHitTestVisible="{x:Bind local:StatsPage.HasNav(NavTag)}"
                                IsTabStop="{x:Bind local:StatsPage.HasNav(NavTag)}"
                                Click="Tile_Click"
                                Translation="0,0,16">
                            <Button.Shadow>
                                <ThemeShadow/>
                            </Button.Shadow>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource StatIconBadgeStyle}"
                                        Background="{x:Bind BadgeBackground}">
                                    <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="18"
                                              Foreground="{x:Bind IconForeground}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                               Text="{x:Bind Value}"
                                               Style="{ThemeResource TitleTextBlockStyle}"/>
                                    <TextBlock Text="{x:Bind SecondaryValue}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{x:Bind local:StatsPage.SecondaryValueVisibility(SecondaryValue)}"/>
                                    <TextBlock Text="{x:Bind Description}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="WrapWholeWords"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- Today — the daily-agenda glance: what's actually due right now, grouped
                 apart from Upcoming so it reads as "do these today" not "coming up" -->
            <StackPanel Spacing="12">
                <TextBlock x:Uid="Stats_TodayHeader" Text="Today" Style="{ThemeResource BodyStrongTextBlockStyle}"/>

                <Border Style="{StaticResource StatTileStyle}" Padding="4" MinHeight="0"
                        Visibility="{x:Bind ViewModel.HasTodayTasks, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.TodayTasks}"
                                   ItemTemplate="{StaticResource TaskRowTemplate}"/>
                </Border>

                <Border Style="{StaticResource StatTileStyle}" MinHeight="0"
                        Visibility="{x:Bind ViewModel.HasTodayTasks, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}">
                    <TextBlock x:Uid="Stats_EmptyToday" Text="Nothing due today."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" Padding="8"/>
                </Border>
            </StackPanel>

            <!-- Upcoming — next non-overdue due tasks, most actionable forward-looking info -->
            <StackPanel Spacing="12">
                <TextBlock x:Uid="Stats_UpcomingHeader" Text="Upcoming" Style="{ThemeResource BodyStrongTextBlockStyle}"/>

                <Border Style="{StaticResource StatTileStyle}" Padding="4" MinHeight="0"
                        Visibility="{x:Bind ViewModel.HasUpcomingTasks, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.UpcomingTasks}"
                                   ItemTemplate="{StaticResource TaskRowTemplate}"/>
                </Border>

                <Border Style="{StaticResource StatTileStyle}" MinHeight="0"
                        Visibility="{x:Bind ViewModel.HasUpcomingTasks, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}">
                    <TextBlock x:Uid="Stats_EmptyUpcoming" Text="Nothing due soon."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" Padding="8"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
