<Page
    x:Class="Hatch.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Hatch.ViewModels"
    xmlns:local="using:Hatch.Views"
    xmlns:converters="using:Hatch.Converters"
    Background="Transparent">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="MinHeight" Value="104"/>
        </Style>

        <Style x:Key="StatTileButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}"/>
            <Setter Property="Padding" Value="16"/>
            <!-- 124, not 112: at 112 a descender (the 'y' in "today") rendered a hair past
                 its line box and got clipped flat by the tile's own bounds. -->
            <Setter Property="MinHeight" Value="124"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TaskRowButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <DataTemplate x:Key="TaskRowTemplate" x:DataType="vm:UpcomingTaskInfo">
            <!-- Tag carries the item: ItemsRepeater does not set DataContext on
                 x:Bind-compiled templates, so the Click handler reads Tag instead. -->
            <Button Style="{StaticResource TaskRowButtonStyle}"
                    Tag="{x:Bind}"
                    AutomationProperties.Name="{x:Bind Title}"
                    Click="TaskRow_Click">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind Title}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Detail}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <!-- ScrollViewer spans the full page so its scrollbar tracks the window edge (PowerToys-style);
         the cap lives on the StackPanel inside it so content is centered under that scrollbar. -->
    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" MaxWidth="{StaticResource PageMaxRowWidth}" HorizontalAlignment="Stretch">

            <TextBlock x:Uid="Stats_TitleText" Text="Summary" Style="{ThemeResource TitleLargeTextBlockStyle}"/>

            <!-- My Day hero — the day's progress, promoted out of the tile grid to a wide
                 card with a determinate ring. -->
            <Button Style="{StaticResource StatTileButtonStyle}"
                    Background="{x:Bind ViewModel.MyDay.Background, Mode=OneWay}"
                    MinHeight="0"
                    AutomationProperties.Name="{x:Bind ViewModel.MyDay.AutomationName, Mode=OneWay}"
                    Click="MyDayHero_Click">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Planned: ring with the percentage in the middle -->
                    <Grid Grid.Column="0" Width="72" Height="72"
                          Visibility="{x:Bind ViewModel.MyDay.HasPlan, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                        <ProgressRing IsIndeterminate="False"
                                      Value="{x:Bind ViewModel.MyDay.RingValue, Mode=OneWay}"
                                      Width="72" Height="72"
                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.MyDay.CenterLabel, Mode=OneWay}"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Nothing planned: just the My Day glyph -->
                    <FontIcon Grid.Column="0" Glyph="{x:Bind ViewModel.MyDay.IconGlyph, Mode=OneWay}"
                              FontSize="32"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              Visibility="{x:Bind ViewModel.MyDay.HasPlan, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.MyDay.Title, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.MyDay.Detail, Mode=OneWay}"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   TextWrapping="WrapWholeWords"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Due today / Overdue / Starred — tinted by meaning via the container fill. -->
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tiles}">
                <ItemsRepeater.Layout>
                    <!-- MinItemWidth kept tiny + MaximumRowsOrColumns=3 so the three tiles
                         always stay one row of thirds, never reflowing to a 2+1 at narrow
                         widths. -->
                    <UniformGridLayout MinItemWidth="1" MinItemHeight="124"
                                       MaximumRowsOrColumns="3"
                                       MinRowSpacing="16" MinColumnSpacing="16"
                                       ItemsStretch="Fill"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatTileInfo">
                        <Button Style="{StaticResource StatTileButtonStyle}"
                                Background="{x:Bind ContainerBackground}"
                                Tag="{x:Bind}"
                                AutomationProperties.Name="{x:Bind AutomationName}"
                                Click="Tile_Click"
                                Translation="0,0,16">
                            <Button.Shadow>
                                <ThemeShadow/>
                            </Button.Shadow>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="14"
                                              Foreground="{x:Bind IconForeground}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind Title}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                           Text="{x:Bind Value}"
                                           Style="{ThemeResource TitleTextBlockStyle}"
                                           FontSize="32"/>
                                <TextBlock Text="{x:Bind Description}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- This week — a quiet momentum glance: one bar per day, height by tasks
                 completed, today accented. No desktop equivalent before now (see
                 SummaryStats.cs). -->
            <Border Style="{StaticResource StatCardStyle}"
                    AutomationProperties.Name="{x:Bind ViewModel.WeekRhythmAutomationName, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock x:Uid="Stats_ThisWeekHeader" Text="This week"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.WeekTotalText, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.StreakText, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               Visibility="{x:Bind ViewModel.HasStreak, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"/>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.WeekRhythm}" HorizontalAlignment="Center">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="8"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:RhythmBarInfo">
                                <StackPanel Width="32" Spacing="6">
                                    <Grid Height="56">
                                        <Border VerticalAlignment="Bottom"
                                                Height="{x:Bind BarHeight}"
                                                Background="{x:Bind Fill}"
                                                CornerRadius="4,4,0,0"/>
                                    </Grid>
                                    <TextBlock Text="{x:Bind DayLabel}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{x:Bind LabelForeground}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- Today — the daily-agenda glance: what's actually due right now -->
            <StackPanel Spacing="12">
                <TextBlock x:Uid="Stats_TodayHeader" Text="Today" Style="{ThemeResource BodyStrongTextBlockStyle}"/>

                <Border Style="{StaticResource StatCardStyle}" Padding="4" MinHeight="0"
                        Visibility="{x:Bind ViewModel.HasTodayTasks, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.TodayTasks}"
                                   ItemTemplate="{StaticResource TaskRowTemplate}"/>
                </Border>

                <Border Style="{StaticResource StatCardStyle}" MinHeight="0"
                        Visibility="{x:Bind ViewModel.HasTodayTasks, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}">
                    <TextBlock x:Uid="Stats_EmptyToday" Text="Nothing due today."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" Padding="8"/>
                </Border>
            </StackPanel>

            <!-- Upcoming — next non-overdue due tasks, most actionable forward-looking info -->
            <StackPanel Spacing="12">
                <TextBlock x:Uid="Stats_UpcomingHeader" Text="Upcoming" Style="{ThemeResource BodyStrongTextBlockStyle}"/>

                <Border Style="{StaticResource StatCardStyle}" Padding="4" MinHeight="0"
                        Visibility="{x:Bind ViewModel.HasUpcomingTasks, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.UpcomingTasks}"
                                   ItemTemplate="{StaticResource TaskRowTemplate}"/>
                </Border>

                <Border Style="{StaticResource StatCardStyle}" MinHeight="0"
                        Visibility="{x:Bind ViewModel.HasUpcomingTasks, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}">
                    <TextBlock x:Uid="Stats_EmptyUpcoming" Text="Nothing due soon."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" Padding="8"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
