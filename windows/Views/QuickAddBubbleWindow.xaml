<Window
    x:Class="Hatch.Views.QuickAddBubbleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="BubbleRoot">
        <Grid.Resources>
            <Storyboard x:Key="ConfirmationFadeIn">
                <DoubleAnimation Storyboard.TargetName="ConfirmationOverlay"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.12"/>
            </Storyboard>

            <Storyboard x:Key="ConfirmationFadeOut">
                <DoubleAnimation Storyboard.TargetName="ConfirmationOverlay"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1" To="0" Duration="0:0:0.1"/>
            </Storyboard>

            <Storyboard x:Key="TipFadeIn">
                <DoubleAnimation Storyboard.TargetName="TipBubble"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.2"/>
            </Storyboard>

            <Storyboard x:Key="TipFadeOut">
                <DoubleAnimation Storyboard.TargetName="TipBubble"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1" To="0" Duration="0:0:0.15"/>
            </Storyboard>
        </Grid.Resources>

        <!-- Confirmation overlay (initially hidden, driven by ShowConfirmationAsync) -->
        <StackPanel x:Name="ConfirmationOverlay"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    Opacity="0"
                    Visibility="Collapsed">

            <Border Width="56" Height="56"
                    CornerRadius="28"
                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                    HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE73E;"
                          FontSize="26"
                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
            </Border>

            <TextBlock x:Uid="QuickAdd_ConfirmHeadline"
                       TextAlignment="Center"
                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>

            <!-- Dynamic subtitle set by code-behind; kept as ConfirmationText for compat -->
            <TextBlock x:Name="ConfirmationText"
                       TextAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <StackPanel x:Name="BubbleContent"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Spacing="12"
                    Padding="16">

            <Border x:Name="TipBubble"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Opacity="0"
                    Visibility="Collapsed"
                    PointerEntered="TipBubble_PointerEntered"
                    PointerExited="TipBubble_PointerExited">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="TipTextBlock"
                               TextWrapping="Wrap"
                               Style="{ThemeResource BodyTextBlockStyle}"/>
                    <Button x:Name="TipActionButton"
                            AutomationProperties.AutomationId="Bubble_TipAction"
                            Visibility="Collapsed"
                            HorizontalAlignment="Stretch"
                            Padding="8,6"
                            Click="TipActionButton_Click"
                            Style="{ThemeResource AccentButtonStyle}"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="IntroMessage"
                        Spacing="12"
                        Visibility="Collapsed">
                <TextBlock x:Uid="QuickAdd_IntroTitle"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <TextBlock x:Uid="QuickAdd_IntroBody"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
                <Button x:Name="GotItButton"
                        x:Uid="QuickAdd_GotItButton"
                        AutomationProperties.AutomationId="Bubble_GotItButton"
                        HorizontalAlignment="Stretch"
                        Padding="8,10"
                        Style="{ThemeResource AccentButtonStyle}"/>
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            </StackPanel>

            <!-- Quick-add form — collapsed entirely for a tip-only proactive popup -->
            <StackPanel x:Name="QuickAddFormPanel" Spacing="12">

                <Grid>
                    <TextBlock x:Uid="QuickAdd_Header"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="2">
                        <Button x:Name="OpenMainWindowButton"
                                x:Uid="QuickAdd_OpenMainButton"
                                AutomationProperties.AutomationId="Bubble_OpenMainWindow"
                                AutomationProperties.Name="Open main window"
                                Style="{ThemeResource SubtleButtonStyle}"
                                Padding="8"
                                MinWidth="0">
                            <FontIcon Glyph="&#xEB91;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Button>
                        <Button x:Name="CloseButton"
                                AutomationProperties.AutomationId="Bubble_Close"
                                AutomationProperties.Name="Close"
                                Style="{ThemeResource SubtleButtonStyle}"
                                Padding="8"
                                MinWidth="0">
                            <FontIcon Glyph="&#xE711;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBox x:Name="TaskTitleBox"
                         x:Uid="QuickAdd_TaskTitleBox"
                         AutomationProperties.AutomationId="Bubble_TaskTitleBox"
                         AutomationProperties.Name="Task title"
                         AcceptsReturn="False"/>

                <StackPanel>
                    <TextBlock x:Uid="QuickAdd_AddToLabel"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,4"/>
                    <ComboBox x:Name="ListSelector"
                              x:Uid="QuickAdd_ListSelector"
                              AutomationProperties.AutomationId="Bubble_ListSelector"
                              AutomationProperties.Name="Add to list"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock x:Uid="QuickAdd_DueDateLabel"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,4"/>
                    <ComboBox x:Name="DatePresetSelector"
                              AutomationProperties.AutomationId="Bubble_DatePresetSelector"
                              AutomationProperties.Name="Due date"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem x:Name="NoDateItem" x:Uid="QuickAdd_NoDateItem" IsSelected="True"/>
                        <ComboBoxItem x:Uid="QuickAdd_TodayItem"/>
                        <ComboBoxItem x:Uid="QuickAdd_TomorrowItem"/>
                        <ComboBoxItem x:Uid="QuickAdd_WeekendItem"/>
                        <ComboBoxItem x:Uid="QuickAdd_NextWeekItem"/>
                    </ComboBox>
                </StackPanel>

                <Button x:Name="AddButton"
                        x:Uid="QuickAdd_AddButton"
                        AutomationProperties.AutomationId="Bubble_AddButton"
                        HorizontalAlignment="Stretch"
                        Padding="8,10"
                        Style="{ThemeResource AccentButtonStyle}"/>

            </StackPanel>

        </StackPanel>

    </Grid>

</Window>
