<Page
    x:Class="Hatch.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:Hatch.Converters"
    Background="Transparent">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <x:Double x:Key="SettingsCardSpacing">8</x:Double>
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="0,24,0,8"/>
            </Style.Setters>
        </Style>

        <!--
            Toggle card: flexible left column so the toggle always stays on the right.
            SettingsCard's built-in responsive wrap moves content below at narrow widths,
            so toggle-only rows use this custom layout instead.
        -->
        <Style x:Key="ToggleCardBorderStyle" TargetType="Border">
            <Style.Setters>
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="MinHeight" Value="64"/>
            </Style.Setters>
        </Style>

        <Style x:Key="SettingsDescriptionTextBlockStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style.Setters>
        </Style>

        <x:Double x:Key="SettingsCardHeaderIconMaxSize">16</x:Double>
        <Thickness x:Key="SettingsCardHeaderIconMargin">0,0,20,0</Thickness>
    </Page.Resources>

    <!-- ScrollViewer spans the full page so its scrollbar tracks the window edge (PowerToys-style);
         the cap sits on the StackPanel inside it. The title is the first child of that same
         StackPanel rather than a pinned header above it: a header outside the ScrollViewer
         centres against the page width while the cards centre against the scrolling area, and
         those two widths differ, so they cannot be made to line up by capping them separately.
         Sharing one container makes them aligned by construction. The title scrolls with the
         list as a result, which is what Summary already does. -->
    <ScrollViewer Padding="24,0,24,24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="{StaticResource SettingsCardSpacing}"
                    MaxWidth="{StaticResource PageMaxRowWidth}" HorizontalAlignment="Stretch">

            <TextBlock x:Name="HeaderText" x:Uid="Settings_PageTitle"
                       Style="{ThemeResource TitleLargeTextBlockStyle}"
                       Margin="0,24,0,8"/>

                <TextBlock x:Uid="Settings_SectionAppearance"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>

                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8BD;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock x:Uid="Settings_MinimizeToTrayHeader"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_MinimizeToTrayDescription"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      x:Uid="Settings_MinimizeToTray"
                                      AutomationProperties.AutomationId="Settings_MinimizeToTray"
                                      IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}"
                                      MinWidth="80"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE896;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock x:Uid="Settings_RunAtStartupHeader"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_RunAtStartupDescription"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      x:Uid="Settings_RunAtStartup"
                                      AutomationProperties.AutomationId="Settings_RunAtStartup"
                                      IsOn="{x:Bind ViewModel.RunAtStartup, Mode=TwoWay}"
                                      MinWidth="80"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock x:Uid="Settings_ThemeCardHeader"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_ThemeCardDescription"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ComboBox Grid.Column="2" VerticalAlignment="Center"
                                  x:Uid="Settings_ThemeComboBox"
                                  AutomationProperties.AutomationId="Settings_ThemeComboBox"
                                  SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" MinWidth="155">
                            <ComboBoxItem x:Uid="Settings_Theme_SystemDefault"/>
                            <ComboBoxItem x:Uid="Settings_Theme_Light"/>
                            <ComboBoxItem x:Uid="Settings_Theme_Dark"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE771;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock x:Uid="Settings_BackdropCardHeader"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_BackdropCardDescription"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ComboBox Grid.Column="2" VerticalAlignment="Center"
                                  x:Uid="Settings_BackdropComboBox"
                                  AutomationProperties.AutomationId="Settings_BackdropComboBox"
                                  SelectedIndex="{x:Bind ViewModel.BackdropIndex, Mode=TwoWay}" MinWidth="165">
                            <ComboBoxItem x:Uid="Settings_Backdrop_None"/>
                            <ComboBoxItem x:Uid="Settings_Backdrop_Mica"/>
                            <ComboBoxItem x:Uid="Settings_Backdrop_MicaAlt"/>
                            <ComboBoxItem x:Uid="Settings_Backdrop_DesktopAcrylic"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <TextBlock x:Uid="Settings_SectionMascot"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>

                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7B3;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock x:Uid="Settings_ShowMascotHeader"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Uid="Settings_ShowMascotDescription"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      x:Uid="Settings_ShowMascot"
                                      AutomationProperties.AutomationId="Settings_ShowMascot"
                                      IsOn="{x:Bind ViewModel.ShowMascot, Mode=TwoWay}"
                                      MinWidth="80"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock x:Uid="Settings_LockPositionHeader"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_LockPositionDescription"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      x:Uid="Settings_LockPosition"
                                      AutomationProperties.AutomationId="Settings_LockPosition"
                                      IsOn="{x:Bind ViewModel.LockMascotPosition, Mode=TwoWay}"
                                      MinWidth="80"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE74F;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock x:Uid="Settings_MuteAnimationHeader"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_MuteAnimationDescription"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      x:Uid="Settings_MuteAnimation"
                                      AutomationProperties.AutomationId="Settings_MuteAnimation"
                                      IsOn="{x:Bind ViewModel.MuteAnimation, Mode=TwoWay}"
                                      MinWidth="80"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE89F;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock x:Uid="Settings_AlwaysOnTopHeader"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_AlwaysOnTopDescription"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      x:Uid="Settings_AlwaysOnTop"
                                      AutomationProperties.AutomationId="Settings_AlwaysOnTop"
                                      IsOn="{x:Bind ViewModel.MascotAlwaysOnTop, Mode=TwoWay}"
                                      MinWidth="80"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE92C;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock x:Uid="Settings_HideFullscreenHeader"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_HideFullscreenDescription"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      x:Uid="Settings_HideFullscreen"
                                      AutomationProperties.AutomationId="Settings_HideFullscreen"
                                      IsOn="{x:Bind ViewModel.HideWhenFullscreen, Mode=TwoWay}"
                                      MinWidth="80"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE82F;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock x:Uid="Settings_ShowQuickTipsHeader"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_ShowQuickTipsDescription"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      x:Uid="Settings_ShowQuickTips"
                                      AutomationProperties.AutomationId="Settings_ShowQuickTips"
                                      IsOn="{x:Bind ViewModel.ShowQuickTips, Mode=TwoWay}"
                                      MinWidth="80"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock x:Uid="Settings_ShowTipsAutomaticallyHeader"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_ShowTipsAutomaticallyDescription"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      x:Uid="Settings_ShowTipsAutomatically"
                                      AutomationProperties.AutomationId="Settings_ShowTipsAutomatically"
                                      IsEnabled="{x:Bind ViewModel.ShowQuickTips, Mode=OneWay}"
                                      IsOn="{x:Bind ViewModel.ShowTipsAutomatically, Mode=TwoWay}"
                                      MinWidth="80"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Automatic tip time window — only meaningful while the toggle above is on -->
                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE823;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock x:Uid="Settings_TipTimeHeader"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_TipTimeDescription"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <!-- Item order maps 1:1 onto TipTimePreference (Anytime=0, Morning=1,
                             Afternoon=2, Evening=3) — keep in sync with the enum. -->
                        <ComboBox Grid.Column="2" MinWidth="140" VerticalAlignment="Center"
                                  x:Uid="Settings_TipTime"
                                  AutomationProperties.AutomationId="Settings_TipTime"
                                  IsEnabled="{x:Bind ViewModel.CanSetProactiveTipTime, Mode=OneWay}"
                                  SelectedIndex="{x:Bind ViewModel.ProactiveTipTimeIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="Settings_TipTime_Anytime"/>
                            <ComboBoxItem x:Uid="Settings_TipTime_Morning"/>
                            <ComboBoxItem x:Uid="Settings_TipTime_Afternoon"/>
                            <ComboBoxItem x:Uid="Settings_TipTime_Evening"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Mascot messages — how often, and the user's own lines -->
                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8BD;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock x:Uid="Settings_ChattinessCardHeader"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_ChattinessCardDescription"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <!-- Item order maps 1:1 onto MascotChattiness (Quiet=0, Balanced=1,
                             Chatty=2) — keep in sync with the enum. -->
                        <ComboBox Grid.Column="2" MinWidth="140" VerticalAlignment="Center"
                                  x:Uid="Settings_MascotChattiness"
                                  AutomationProperties.AutomationId="Settings_MascotChattiness"
                                  SelectedIndex="{x:Bind ViewModel.MascotChattinessIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="Settings_Chattiness_Quiet"/>
                            <ComboBoxItem x:Uid="Settings_Chattiness_Balanced"/>
                            <ComboBoxItem x:Uid="Settings_Chattiness_Chatty"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE71D;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock x:Uid="Settings_OpenPageCardHeader"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_OpenPageCardDescription"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ComboBox Grid.Column="2" MinWidth="160" VerticalAlignment="Center"
                                  x:Uid="Settings_MascotOpenPage"
                                  AutomationProperties.AutomationId="Settings_MascotOpenPage"
                                  ItemsSource="{x:Bind ViewModel.MascotOpenPageOptions}"
                                  SelectedItem="{x:Bind ViewModel.SelectedMascotOpenPageOption, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <toolkit:SettingsExpander x:Uid="Settings_CustomTipsExpander">
                    <toolkit:SettingsExpander.Description>
                        <TextBlock x:Uid="Settings_CustomTipsExpanderDescription"
                                   Style="{StaticResource SettingsDescriptionTextBlockStyle}"/>
                    </toolkit:SettingsExpander.Description>
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE70F;"/>
                    </toolkit:SettingsExpander.HeaderIcon>
                    <toolkit:SettingsExpander.ItemsHeader>
                        <StackPanel Padding="16,8,16,16" Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CustomTipInput"
                                         x:Uid="Settings_CustomTipInput"
                                         Grid.Column="0"
                                         AutomationProperties.AutomationId="Settings_CustomTipInput"
                                         KeyDown="CustomTipInput_KeyDown"/>
                                <Button Grid.Column="1"
                                        x:Uid="Settings_AddCustomTip"
                                        AutomationProperties.AutomationId="Settings_AddCustomTip"
                                        Click="AddCustomTipButton_Click"/>
                            </Grid>

                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.CustomTips, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="4"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                              CornerRadius="{ThemeResource ControlCornerRadius}"
                                              Padding="12,6,6,6"
                                              ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind}"
                                                       TextWrapping="WrapWholeWords"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="1"
                                                    Tag="{x:Bind}"
                                                    x:Uid="Settings_RemoveCustomTip"
                                                    Click="RemoveCustomTipButton_Click"
                                                    Style="{ThemeResource SubtleButtonStyle}"
                                                    Padding="8" MinWidth="0">
                                                <FontIcon Glyph="&#xE711;" FontSize="12"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </toolkit:SettingsExpander.ItemsHeader>
                </toolkit:SettingsExpander>

                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8A5;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock x:Uid="Settings_LottieCardHeader"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.LottieFileDisplay, Mode=OneWay}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.LottieFileDisplay, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Uid="Settings_BrowseLottie"
                                    AutomationProperties.AutomationId="Settings_BrowseLottie"
                                    Click="BrowseLottieButton_Click"/>
                            <Button x:Uid="Settings_ClearLottie"
                                    AutomationProperties.AutomationId="Settings_ClearLottie"
                                    Click="ClearLottieButton_Click"
                                    IsEnabled="{x:Bind ViewModel.HasLottieFile, Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <toolkit:SettingsExpander x:Uid="Settings_MascotSizeExpander">
                    <toolkit:SettingsExpander.Description>
                        <TextBlock x:Uid="Settings_MascotSizeExpanderDescription"
                                   Style="{StaticResource SettingsDescriptionTextBlockStyle}"/>
                    </toolkit:SettingsExpander.Description>
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE744;"/>
                    </toolkit:SettingsExpander.HeaderIcon>
                    <TextBlock x:Name="MascotSizeHeaderLabel"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard x:Uid="Settings_MascotSizePresetsCard">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Uid="Settings_SizeSmall"  AutomationProperties.AutomationId="Settings_SizeSmall"  Tag="80"  Click="MascotSizePreset_Click" MinWidth="72"/>
                                <Button x:Uid="Settings_SizeMedium" AutomationProperties.AutomationId="Settings_SizeMedium" Tag="120" Click="MascotSizePreset_Click" MinWidth="72"/>
                                <Button x:Uid="Settings_SizeLarge"  AutomationProperties.AutomationId="Settings_SizeLarge"  Tag="160" Click="MascotSizePreset_Click" MinWidth="72"/>
                            </StackPanel>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard x:Uid="Settings_MascotSizeCustomCard">
                            <Slider x:Name="MascotSizeSlider"
                                    x:Uid="Settings_SizeSlider"
                                    AutomationProperties.AutomationId="Settings_SizeSlider"
                                    Minimum="60" Maximum="200"
                                    StepFrequency="1" TickFrequency="20"
                                    TickPlacement="Outside"
                                    Width="200"
                                    ValueChanged="MascotSizeSlider_ValueChanged"/>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE92E;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock x:Uid="Settings_HotkeyCardHeader"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.HotkeyRecordDescription, Mode=OneWay}"
                                       Style="{StaticResource SettingsDescriptionTextBlockStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="2"
                                x:Name="HotkeyRecordButton"
                                x:Uid="Settings_HotkeyRecordButton"
                                AutomationProperties.AutomationId="Settings_HotkeyRecordButton"
                                Content="{x:Bind ViewModel.HotkeyRecordButtonText, Mode=OneWay}"
                                MinWidth="160"
                                FontFamily="Consolas"
                                VerticalAlignment="Center"
                                Click="HotkeyRecordButton_Click"/>
                    </Grid>
                </Border>

                <!-- Registration failure is otherwise invisible: the key just does nothing
                     while Settings still shows it as configured. Sits outside the expander,
                     matching the other InfoBars on this page, so it is seen without
                     expanding anything. -->
                <InfoBar Severity="Warning"
                         IsOpen="{x:Bind ViewModel.HasHotkeyConflict, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.HasHotkeyConflict, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                         IsClosable="False"
                         x:Uid="Settings_HotkeyConflict"
                         AutomationProperties.AutomationId="Settings_HotkeyConflict"/>

                <TextBlock x:Uid="Settings_SectionSync"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>

                <Border Style="{StaticResource ToggleCardBorderStyle}"
                        Visibility="{x:Bind ViewModel.SyncAccount.IsSyncSignedIn, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE77B;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,14,16,14">
                            <TextBlock Text="{x:Bind ViewModel.SyncAccount.SyncUserEmail, Mode=OneWay}"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.SyncAccount.SyncLastSyncedText, Mode=OneWay}"
                                       Style="{StaticResource SettingsDescriptionTextBlockStyle}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.SyncAccount.SyncLastSyncedText, Mode=OneWay}"/>
                        </StackPanel>
                        <Button Grid.Column="2" x:Uid="Settings_SyncSignOut"
                                AutomationProperties.AutomationId="Settings_SyncSignOut"
                                Command="{x:Bind ViewModel.SyncAccount.SignOutCommand}"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Two-factor challenge — every sync path stays closed until it is met -->
                <InfoBar x:Uid="Settings_MfaChallengeInfo"
                         Severity="Warning"
                         IsOpen="{x:Bind ViewModel.SyncAccount.IsMfaChallengePending, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.SyncAccount.IsMfaChallengePending, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                         IsClosable="False"/>

                <toolkit:SettingsCard x:Uid="Settings_MfaChallengeCard"
                    ContentAlignment="Vertical"
                    Visibility="{x:Bind ViewModel.SyncAccount.IsMfaChallengePending, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Uid="Settings_MfaChallengeCardDescription"
                                   Style="{StaticResource SettingsDescriptionTextBlockStyle}"/>
                    </toolkit:SettingsCard.Description>
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE928;"/>
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="MfaChallengeCodeBox"
                                     x:Uid="Settings_MfaChallengeCode"
                                     AutomationProperties.AutomationId="Settings_MfaChallengeCode"
                                     MaxLength="6"
                                     Width="90"/>
                            <Button x:Uid="Settings_MfaChallengeSubmit"
                                    AutomationProperties.AutomationId="Settings_MfaChallengeSubmit"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    IsEnabled="{x:Bind ViewModel.SyncAccount.IsNotSyncing, Mode=OneWay}"
                                    Click="MfaChallengeSubmit_Click"/>
                        </StackPanel>
                        <!-- On its own line: it is the escape hatch, not a peer of Verify. -->
                        <HyperlinkButton x:Uid="Settings_MfaUseRecovery"
                                         AutomationProperties.AutomationId="Settings_MfaUseRecovery"
                                         Padding="0"
                                         Click="MfaUseRecovery_Click"/>
                    </StackPanel>
                </toolkit:SettingsCard>

                <!-- Recovery code redemption — the only route back from a lost authenticator -->
                <toolkit:SettingsCard x:Uid="Settings_RecoveryRedeemCard"
                    ContentAlignment="Vertical"
                    Visibility="{x:Bind ViewModel.SyncAccount.IsRedeemingRecovery, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Uid="Settings_RecoveryRedeemCardDescription"
                                   Style="{StaticResource SettingsDescriptionTextBlockStyle}"/>
                    </toolkit:SettingsCard.Description>
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE785;"/>
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Spacing="8">
                        <TextBox x:Name="RecoveryCodeBox"
                                 x:Uid="Settings_RecoveryCode"
                                 AutomationProperties.AutomationId="Settings_RecoveryCode"
                                 FontFamily="Consolas"
                                 HorizontalAlignment="Stretch"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button x:Uid="Settings_RecoveryCancel"
                                    AutomationProperties.AutomationId="Settings_RecoveryCancel"
                                    Click="RecoveryCancel_Click"/>
                            <Button x:Uid="Settings_RecoveryRedeem"
                                    AutomationProperties.AutomationId="Settings_RecoveryRedeem"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    IsEnabled="{x:Bind ViewModel.SyncAccount.IsNotSyncing, Mode=OneWay}"
                                    Click="RecoveryRedeem_Click"/>
                        </StackPanel>
                    </StackPanel>
                </toolkit:SettingsCard>

                <!-- E2E passphrase — sync stays paused until one is set -->
                <InfoBar x:Uid="Settings_SyncPassphraseInfo"
                         Severity="Informational"
                         IsOpen="{x:Bind ViewModel.SyncAccount.IsSignedInWithoutPassphrase, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.SyncAccount.IsSignedInWithoutPassphrase, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                         IsClosable="False"/>

                <Border Style="{StaticResource ToggleCardBorderStyle}"
                        Visibility="{x:Bind ViewModel.SyncAccount.IsSignedInWithoutPassphrase, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,14,16,14">
                            <TextBlock x:Uid="Settings_SyncPassphraseActionHeader"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_SyncPassphraseCardDescription"
                                       Style="{StaticResource SettingsDescriptionTextBlockStyle}"
                                       TextWrapping="WrapWholeWords"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PasswordBox x:Name="SyncPassphraseBox"
                                         x:Uid="Settings_SyncPassphrase"
                                         AutomationProperties.AutomationId="Settings_SyncPassphrase"
                                         Width="220"/>
                            <Button x:Uid="Settings_SyncPassphraseSet"
                                    AutomationProperties.AutomationId="Settings_SyncSetPassphrase"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    IsEnabled="{x:Bind ViewModel.SyncAccount.IsNotSyncing, Mode=OneWay}"
                                    Click="SyncSetPassphrase_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ToggleCardBorderStyle}"
                        Visibility="{x:Bind ViewModel.SyncAccount.CanStartChangePassphrase, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,14,16,14">
                            <TextBlock x:Uid="Settings_ChangePassphraseActionHeader"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_ChangePassphraseCardDescription"
                                       Style="{StaticResource SettingsDescriptionTextBlockStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="2" x:Uid="Settings_ChangePassphraseStart"
                                AutomationProperties.AutomationId="Settings_ChangePassphraseStart"
                                Click="ChangePassphraseStart_Click"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <toolkit:SettingsCard x:Uid="Settings_ChangePassphraseFormCard"
                    ContentAlignment="Vertical"
                    Visibility="{x:Bind ViewModel.SyncAccount.IsChangingPassphrase, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Uid="Settings_ChangePassphraseFormCardDescription"
                                   Style="{StaticResource SettingsDescriptionTextBlockStyle}"/>
                    </toolkit:SettingsCard.Description>
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;"/>
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Spacing="8">
                        <PasswordBox x:Name="ChangePassphraseOldBox"
                                     x:Uid="Settings_ChangePassphraseOldBox"
                                     AutomationProperties.AutomationId="Settings_ChangePassphraseOld"
                                     HorizontalAlignment="Stretch"/>
                        <PasswordBox x:Name="ChangePassphraseNewBox"
                                     x:Uid="Settings_ChangePassphraseNewBox"
                                     AutomationProperties.AutomationId="Settings_ChangePassphraseNew"
                                     HorizontalAlignment="Stretch"/>
                        <PasswordBox x:Name="ChangePassphraseConfirmBox"
                                     x:Uid="Settings_ChangePassphraseConfirmBox"
                                     AutomationProperties.AutomationId="Settings_ChangePassphraseConfirm"
                                     HorizontalAlignment="Stretch"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button x:Uid="Settings_ChangePassphraseCancel"
                                    AutomationProperties.AutomationId="Settings_ChangePassphraseCancel"
                                    Click="ChangePassphraseCancel_Click"/>
                            <Button x:Uid="Settings_ChangePassphraseSubmit"
                                    AutomationProperties.AutomationId="Settings_ChangePassphraseSubmit"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    IsEnabled="{x:Bind ViewModel.SyncAccount.IsNotSyncing, Mode=OneWay}"
                                    Click="ChangePassphraseSubmit_Click"/>
                        </StackPanel>
                    </StackPanel>
                </toolkit:SettingsCard>

                <!-- Sync recovery kit — the passphrase cannot be reset or recovered -->
                <Border Style="{StaticResource ToggleCardBorderStyle}"
                        Visibility="{x:Bind ViewModel.SyncAccount.CanShowRecoveryKit, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,14,16,14">
                            <TextBlock x:Uid="Settings_RecoveryKitActionHeader"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_RecoveryKitCardDescription"
                                       Style="{StaticResource SettingsDescriptionTextBlockStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="2" x:Uid="Settings_RecoveryKitShow"
                                AutomationProperties.AutomationId="Settings_RecoveryKitShow"
                                Click="RecoveryKitShow_Click"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <InfoBar x:Uid="Settings_RecoveryKitInfo"
                         Severity="Warning"
                         IsOpen="{x:Bind ViewModel.SyncAccount.HasRecoveryKit, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.SyncAccount.HasRecoveryKit, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                         IsClosable="False">
                    <InfoBar.Content>
                        <StackPanel Spacing="10" Margin="0,10,0,14">
                            <TextBox Text="{x:Bind ViewModel.SyncAccount.RecoveryKitText, Mode=OneWay}"
                                     x:Uid="Settings_RecoveryKitText"
                                     AutomationProperties.AutomationId="Settings_RecoveryKitText"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontFamily="Consolas"
                                     MaxHeight="220"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Uid="Settings_RecoveryKitSave"
                                        AutomationProperties.AutomationId="Settings_RecoveryKitSave"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Click="RecoveryKitSave_Click"/>
                                <Button x:Uid="Settings_RecoveryKitCopy"
                                        AutomationProperties.AutomationId="Settings_RecoveryKitCopy"
                                        Click="RecoveryKitCopy_Click"/>
                                <Button x:Uid="Settings_RecoveryKitDone"
                                        AutomationProperties.AutomationId="Settings_RecoveryKitDone"
                                        Click="RecoveryKitDone_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>

                <!-- Two-factor authentication (docs/mfa-spec.md) -->
                <Border Style="{StaticResource ToggleCardBorderStyle}"
                        Visibility="{x:Bind ViewModel.SyncAccount.IsMfaSettingsVisible, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE928;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,14,16,14">
                            <TextBlock x:Uid="Settings_MfaActionHeader"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_MfaCardDescription"
                                       Style="{StaticResource SettingsDescriptionTextBlockStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Uid="Settings_MfaEnable"
                                    AutomationProperties.AutomationId="Settings_MfaEnable"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Visibility="{x:Bind ViewModel.SyncAccount.CanEnrollMfa, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                    Click="MfaEnable_Click"/>
                            <Button x:Uid="Settings_MfaDisable"
                                    AutomationProperties.AutomationId="Settings_MfaDisable"
                                    Visibility="{x:Bind ViewModel.SyncAccount.IsMfaEnrolled, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                    Click="MfaDisable_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <InfoBar x:Uid="Settings_MfaOnInfo"
                         Severity="Success"
                         IsOpen="{x:Bind ViewModel.SyncAccount.ShowMfaOnInfo, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.SyncAccount.ShowMfaOnInfo, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                         IsClosable="False"/>

                <!-- QR + setup key + code + two buttons never fit one row at 620px. Stacked
                     in the order the task is actually performed: scan, or copy the key, then
                     type what the authenticator shows. -->
                <toolkit:SettingsCard x:Uid="Settings_MfaEnrollCard"
                    ContentAlignment="Vertical"
                    Visibility="{x:Bind ViewModel.SyncAccount.IsMfaEnrolling, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <toolkit:SettingsCard.Description>
                        <TextBlock x:Uid="Settings_MfaEnrollCardDescription"
                                   Style="{StaticResource SettingsDescriptionTextBlockStyle}"/>
                    </toolkit:SettingsCard.Description>
                    <StackPanel Spacing="12">
                        <Border x:Name="MfaQrPanel"
                                Background="White"
                                CornerRadius="4"
                                Padding="6"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed">
                            <Image x:Name="MfaQrImage"
                                   x:Uid="Settings_MfaQrImage"
                                   Width="132" Height="132"/>
                        </Border>
                        <TextBox Text="{x:Bind ViewModel.SyncAccount.MfaSecret, Mode=OneWay}"
                                 x:Uid="Settings_MfaSecretBox"
                                 AutomationProperties.AutomationId="Settings_MfaSecret"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 HorizontalAlignment="Stretch"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="MfaCodeBox"
                                     x:Uid="Settings_MfaCodeBox"
                                     AutomationProperties.AutomationId="Settings_MfaCode"
                                     MaxLength="6"
                                     Width="90"/>
                            <Button x:Uid="Settings_MfaConfirm"
                                    AutomationProperties.AutomationId="Settings_MfaConfirm"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    VerticalAlignment="Bottom"
                                    Click="MfaConfirm_Click"/>
                            <Button x:Uid="Settings_MfaCancel"
                                    AutomationProperties.AutomationId="Settings_MfaCancel"
                                    VerticalAlignment="Bottom"
                                    Click="MfaCancel_Click"/>
                        </StackPanel>
                    </StackPanel>
                </toolkit:SettingsCard>

                <!-- Recovery codes, shown once. The server keeps only hashes. -->
                <InfoBar x:Uid="Settings_RecoveryCodesInfo"
                         Severity="Warning"
                         IsOpen="{x:Bind ViewModel.SyncAccount.HasRecoveryCodes, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.SyncAccount.HasRecoveryCodes, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                         IsClosable="False">
                    <InfoBar.Content>
                        <StackPanel Spacing="10" Margin="0,10,0,14">
                            <TextBox Text="{x:Bind ViewModel.SyncAccount.RecoveryCodesText, Mode=OneWay}"
                                     x:Uid="Settings_RecoveryCodes"
                                     AutomationProperties.AutomationId="Settings_RecoveryCodes"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     FontFamily="Consolas"
                                     MaxWidth="240"
                                     HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Uid="Settings_RecoveryCopy"
                                        AutomationProperties.AutomationId="Settings_RecoveryCopy"
                                        Click="RecoveryCopy_Click"/>
                                <Button x:Uid="Settings_RecoveryDone"
                                        AutomationProperties.AutomationId="Settings_RecoveryDone"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Click="RecoveryDone_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>

                <!-- Sync notice — non-error state changes worth surfacing (e.g. 2FA turned off) -->
                <InfoBar Severity="Warning"
                         IsOpen="{x:Bind ViewModel.SyncAccount.HasSyncNotice, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.SyncAccount.HasSyncNotice, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                         Message="{x:Bind ViewModel.SyncAccount.SyncNotice, Mode=OneWay}"
                         AutomationProperties.AutomationId="Settings_SyncNotice"
                         IsClosable="True"
                         CloseButtonClick="SyncNotice_Close"/>

                <InfoBar x:Name="SyncErrorBar"
                         Severity="Error"
                         IsOpen="{x:Bind ViewModel.SyncAccount.HasSyncError, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.SyncAccount.IsSyncSignedIn, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                         Message="{x:Bind ViewModel.SyncAccount.SyncError, Mode=OneWay}"
                         IsClosable="False"/>

                <toolkit:SettingsExpander
                    x:Uid="Settings_SyncAcrossDevicesExpander"
                    Visibility="{x:Bind ViewModel.SyncAccount.IsSyncNotSignedIn, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <toolkit:SettingsExpander.Description>
                        <TextBlock x:Uid="Settings_SyncAcrossDevicesExpanderDescription"
                                   Style="{StaticResource SettingsDescriptionTextBlockStyle}"/>
                    </toolkit:SettingsExpander.Description>
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE895;"/>
                    </toolkit:SettingsExpander.HeaderIcon>
                    <toolkit:SettingsExpander.ItemsHeader>
                        <StackPanel Padding="16,8,16,16" Spacing="8">
                            <Border Style="{StaticResource ToggleCardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE715;" FontSize="16"
                                              VerticalAlignment="Center" Margin="0,0,20,0"/>
                                    <TextBlock Grid.Column="1" x:Uid="Settings_SyncEmailLabel"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" x:Name="SyncEmailBox"
                                             x:Uid="Settings_SyncEmail"
                                             AutomationProperties.AutomationId="Settings_SyncEmail"
                                             Text="{x:Bind ViewModel.SyncAccount.SyncEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MinWidth="220"
                                             InputScope="EmailNameOrAddress"
                                             VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource ToggleCardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="16"
                                              VerticalAlignment="Center" Margin="0,0,20,0"/>
                                    <TextBlock Grid.Column="1" x:Uid="Settings_SyncPasswordLabel"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               VerticalAlignment="Center"/>
                                    <PasswordBox Grid.Column="2" x:Name="SyncPasswordBox"
                                                 x:Uid="Settings_SyncPassword"
                                                 AutomationProperties.AutomationId="Settings_SyncPassword"
                                                 MinWidth="220"
                                                 VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource ToggleCardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE77B;" FontSize="16"
                                              VerticalAlignment="Center" Margin="0,0,20,0"/>
                                    <TextBlock Grid.Column="1" x:Uid="Settings_SyncEmailActionsLabel"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button x:Uid="Settings_SyncSignIn"
                                                AutomationProperties.AutomationId="Settings_SyncSignIn"
                                                Style="{ThemeResource AccentButtonStyle}"
                                                IsEnabled="{x:Bind ViewModel.SyncAccount.IsNotSyncing, Mode=OneWay}"
                                                Click="SyncSignIn_Click"/>
                                        <Button x:Uid="Settings_SyncSignUp"
                                                AutomationProperties.AutomationId="Settings_SyncSignUp"
                                                IsEnabled="{x:Bind ViewModel.SyncAccount.IsNotSyncing, Mode=OneWay}"
                                                Click="SyncSignUp_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource ToggleCardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE71B;" FontSize="16"
                                              VerticalAlignment="Center" Margin="0,0,20,0"/>
                                    <TextBlock Grid.Column="1" x:Uid="Settings_SyncGitHubActionsLabel"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" x:Uid="Settings_SyncGitHub"
                                            AutomationProperties.AutomationId="Settings_SyncGitHub"
                                            IsEnabled="{x:Bind ViewModel.SyncAccount.IsNotSyncing, Mode=OneWay}"
                                            Click="SyncGitHubSignIn_Click"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <toolkit:SettingsCard
                                Visibility="{x:Bind ViewModel.SyncAccount.HasSyncError, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.SyncAccount.SyncError, Mode=OneWay}"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           TextWrapping="Wrap"/>
                            </toolkit:SettingsCard>
                        </StackPanel>
                    </toolkit:SettingsExpander.ItemsHeader>
                </toolkit:SettingsExpander>

                <TextBlock x:Uid="Settings_SectionData"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>

                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock x:Uid="Settings_OpenDataFolderCardHeader"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_OpenDataFolderCardDescription"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="2" VerticalAlignment="Center"
                                x:Uid="Settings_OpenDataFolder"
                                AutomationProperties.AutomationId="Settings_OpenDataFolder"
                                Command="{x:Bind ViewModel.OpenDataFolderCommand}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE78C;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock x:Uid="Settings_ExportTasksCardHeader"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_ExportTasksCardDescription"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Uid="Settings_ExportJson"
                                    AutomationProperties.AutomationId="Settings_ExportJson"
                                    Click="ExportButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <toolkit:SettingsCard
                    Visibility="{x:Bind ViewModel.HasExportError, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.ExportError, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"/>
                </toolkit:SettingsCard>

                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8B5;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock x:Uid="Settings_ImportTasksCardHeader"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_ImportTasksCardDescription"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="2" VerticalAlignment="Center"
                                x:Uid="Settings_ImportJson"
                                AutomationProperties.AutomationId="Settings_ImportJson"
                                Click="ImportButton_Click"/>
                    </Grid>
                </Border>

                <toolkit:SettingsCard
                    Visibility="{x:Bind ViewModel.HasImportResult, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.ImportResult, Mode=OneWay}"
                               TextWrapping="Wrap"/>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard
                    Visibility="{x:Bind ViewModel.HasImportError, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.ImportError, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"/>
                </toolkit:SettingsCard>

                <TextBlock x:Uid="Settings_SectionAbout"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>

                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE72C;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock x:Uid="Settings_UpdateActionHeader"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center">
                            <ProgressRing Width="16" Height="16"
                                          IsActive="{x:Bind ViewModel.IsCheckingForUpdates, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.IsCheckingForUpdates, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                          VerticalAlignment="Center"/>
                            <Button x:Uid="Settings_CheckForUpdates"
                                    AutomationProperties.AutomationId="Settings_CheckForUpdates"
                                    IsEnabled="{x:Bind ViewModel.CanCheckForUpdates, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.CheckForUpdatesCommand}"/>
                            <Button x:Uid="Settings_InstallUpdate"
                                    AutomationProperties.AutomationId="Settings_InstallUpdate"
                                    Visibility="{x:Bind ViewModel.HasAvailableUpdate, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanInstallUpdate, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.InstallUpdateCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE90A;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock x:Uid="Settings_ReportIssueActionHeader"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_ReportIssueCardDescription"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="2" x:Uid="Settings_OpenGitHubIssues"
                                AutomationProperties.AutomationId="Settings_OpenGitHubIssues"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.OpenGitHubIssuesCommand}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,0,14">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Uid="Settings_HatchInfoHeader"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="{x:Bind ViewModel.AppVersion}"
                                           AutomationProperties.AutomationId="Settings_AppVersion"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Uid="Settings_HatchInfoDescription"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                    <Button x:Uid="Settings_TermsButton"
                            AutomationProperties.AutomationId="Settings_TermsButton"
                            Click="TermsButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8A5;" FontSize="16"/>
                            <TextBlock x:Uid="Settings_TermsButtonLabel"/>
                        </StackPanel>
                    </Button>
                    <Button x:Uid="Settings_PrivacyButton"
                            AutomationProperties.AutomationId="Settings_PrivacyButton"
                            Click="PrivacyButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72E;" FontSize="16"/>
                            <TextBlock x:Uid="Settings_PrivacyButtonLabel"/>
                        </StackPanel>
                    </Button>
                    <Button x:Uid="Settings_RateAppButton"
                            AutomationProperties.AutomationId="Settings_RateAppButton"
                            Click="RateAppButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE734;" FontSize="16"/>
                            <TextBlock x:Uid="Settings_RateAppButtonLabel"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>

