<Page
    x:Class="Hatch.Views.TaskListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Hatch.Models"
    xmlns:converters="using:Hatch.Converters"
    xmlns:vm="using:Hatch.ViewModels"
    Background="Transparent">

    <Page.Resources>
        <converters:BoolToStrikethroughConverter x:Key="BoolToStrikethrough" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacity" />
        <converters:DateTimeToStringConverter x:Key="DateTimeToString" />
        <converters:DueDateToStringConverter x:Key="DueDateToString" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolToStarGlyphConverter x:Key="BoolToStarGlyph" />
        <converters:DueDateToChipVisibilityConverter x:Key="DueDateToChipVisibility" />
        <converters:DueDateToChipBrushConverter x:Key="DueDateToChipBrush" />
        <converters:DueDateToChipForegroundConverter x:Key="DueDateToChipForeground" />
        <converters:DueDateToChipGlyphConverter x:Key="DueDateToChipGlyph" />
        <converters:PlannedGroupNameToForegroundConverter x:Key="PlannedGroupNameToForeground" />
        <converters:BoolToStarTooltipConverter x:Key="BoolToStarTooltip" />
        <converters:TagsToVisibilityConverter x:Key="TagsToVisibility" />
        <converters:TagsPreviewConverter x:Key="TagsPreview" />
        <converters:TagsOverflowCountConverter x:Key="TagsOverflowCount" />
        <converters:TagsOverflowVisibilityConverter x:Key="TagsOverflowVisibility" />
        <converters:PriorityToBrushConverter x:Key="PriorityToBrush" />
        <converters:PriorityToForegroundConverter x:Key="PriorityToForeground" />
        <converters:PriorityToLabelConverter x:Key="PriorityToLabel" />

        <!-- Chip button: preserves the chip color on hover/press instead of flashing WinUI default grey -->
        <Style x:Key="ChipButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid"
                              Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.75" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.55" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <CollectionViewSource x:Name="PlannedGroupsSource"
                              IsSourceGrouped="True"
                              ItemsPath="Items" />

        <!-- Shared item template used by both flat and grouped lists -->
        <DataTemplate x:Key="TaskItemTemplate" x:DataType="models:TodoItem">
            <Grid Tag="{x:Bind}"
                  Margin="0,0"
                  Padding="24,12,24,12"
                  ColumnSpacing="8"
                  CornerRadius="0"
                  Background="Transparent"
                  PointerPressed="TaskCard_PointerPressed"
                  Tapped="TaskCard_Tapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          AutomationProperties.AutomationId="Task_CheckBox"
                          IsChecked="{x:Bind IsCompleted, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          x:Uid="Task_CheckBox" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"
                            Opacity="{x:Bind IsCompleted, Converter={StaticResource BoolToOpacity}, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                               TextDecorations="{x:Bind IsCompleted, Converter={StaticResource BoolToStrikethrough}, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Orientation="Horizontal" Spacing="4">

                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="4"
                                Padding="6,2"
                                Visibility="{x:Bind HasListName, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ListName, Mode=OneWay}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Border>

                        <!--
                            Everything below is extra context that only matters for an open
                            task — a completed row keeps just the list name chip above.
                        -->
                        <StackPanel Orientation="Horizontal" Spacing="4"
                                    Visibility="{x:Bind IsCompleted, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}">

                            <TextBlock Text="·"
                                       Visibility="{x:Bind HasListNameToDateSeparator, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       VerticalAlignment="Center" />

                            <Button Tag="{x:Bind}"
                                    AutomationProperties.AutomationId="Task_DateChipButton"
                                    Click="ChipDateButton_Click"
                                    Visibility="{x:Bind DueDate, Converter={StaticResource DueDateToChipVisibility}, Mode=OneWay}"
                                    Background="{x:Bind DueDate, Converter={StaticResource DueDateToChipBrush}, Mode=OneWay}"
                                    Style="{StaticResource ChipButtonStyle}"
                                    VerticalAlignment="Center"
                                    x:Uid="Task_DateChipButton">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon
                                        Glyph="{x:Bind DueDate, Converter={StaticResource DueDateToChipGlyph}, Mode=OneWay}"
                                        FontSize="11"
                                        Foreground="{x:Bind DueDate, Converter={StaticResource DueDateToChipForeground}, Mode=OneWay}"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Text="{x:Bind DueDate, Converter={StaticResource DueDateToString}, Mode=OneWay}"
                                        Foreground="{x:Bind DueDate, Converter={StaticResource DueDateToChipForeground}, Mode=OneWay}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Border x:Uid="Task_RepeatChip"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind HasRecurrence, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                <FontIcon Glyph="&#xE895;"
                                          FontSize="10"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>

                            <Border
                                Background="{x:Bind Priority, Converter={StaticResource PriorityToBrush}, Mode=OneWay}"
                                CornerRadius="4"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="{x:Bind Priority, Converter={StaticResource PriorityToLabel}, Mode=OneWay}"
                                Visibility="{x:Bind HasPriority, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE7C1;"
                                              FontSize="10"
                                              Foreground="{x:Bind Priority, Converter={StaticResource PriorityToForeground}, Mode=OneWay}" />
                                    <TextBlock
                                        Text="{x:Bind Priority, Converter={StaticResource PriorityToLabel}, Mode=OneWay}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{x:Bind Priority, Converter={StaticResource PriorityToForeground}, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <Button Tag="{x:Bind}"
                                    AutomationProperties.AutomationId="Task_AddDateButton"
                                    Click="ChipDateButton_Click"
                                    Visibility="{x:Bind ShowAddDateHint, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                    Padding="6,2" MinWidth="0" MinHeight="0"
                                    Background="Transparent" BorderThickness="0"
                                    VerticalAlignment="Center"
                                    IsTabStop="False"
                                    x:Uid="Task_AddDateButton">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE787;" FontSize="11"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock x:Uid="Task_AddDateText"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="·"
                                       Visibility="{x:Bind HasMetaSeparator, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       VerticalAlignment="Center" />

                            <ItemsRepeater
                                ItemsSource="{x:Bind Tags, Converter={StaticResource TagsPreview}, Mode=OneWay}"
                                Visibility="{x:Bind Tags, Converter={StaticResource TagsToVisibility}, Mode=OneWay}"
                                VerticalAlignment="Center">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="4" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button Tag="{x:Bind}"
                                                Click="TagChipInRow_Click"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                Style="{StaticResource ChipButtonStyle}"
                                                Padding="6,1">
                                            <TextBlock Text="{x:Bind}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <!-- +N overflow → tapping opens details pane to show all tags -->
                            <Button Tag="{x:Bind}"
                                    Click="TagOverflowButton_Click"
                                    Visibility="{x:Bind Tags, Converter={StaticResource TagsOverflowVisibility}, Mode=OneWay}"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    Style="{StaticResource ChipButtonStyle}"
                                    VerticalAlignment="Center"
                                    Padding="6,1">
                                <TextBlock
                                    Text="{x:Bind Tags, Converter={StaticResource TagsOverflowCount}, Mode=OneWay}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>

                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!--
                    Always-visible action strip.
                    ☆  star/unstar
                    ⋯  overflow menu — Delete lives here
                -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Tag="{x:Bind}"
                            AutomationProperties.AutomationId="Task_StarButton"
                            AutomationProperties.Name="{x:Bind IsStarred, Converter={StaticResource BoolToStarTooltip}, Mode=OneWay}"
                            Click="StarButton_Click"
                            ToolTipService.ToolTip="{x:Bind IsStarred, Converter={StaticResource BoolToStarTooltip}, Mode=OneWay}"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Visibility="{x:Bind IsCompleted, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}"
                            Padding="8,6" MinWidth="0">
                        <FontIcon Glyph="{x:Bind IsStarred, Converter={StaticResource BoolToStarGlyph}, Mode=OneWay}"
                                  FontSize="14"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>

                    <!-- ⋯ overflow — destructive and future actions live here -->
                    <Button Tag="{x:Bind}"
                            AutomationProperties.AutomationId="Task_OverflowButton"
                            AutomationProperties.Name="More options"
                            x:Uid="Task_OverflowButton"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Padding="8,6" MinWidth="0">
                        <FontIcon Glyph="&#xE712;" FontSize="14"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Tag="{x:Bind}"
                                                x:Uid="TaskRow_FocusMenuItem"
                                                Text="Focus on this"
                                                Click="FocusMenuItem_Click"
                                                Visibility="{x:Bind IsCompleted, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B0;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator
                                    Visibility="{x:Bind IsCompleted, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}" />
                                <MenuFlyoutSubItem x:Uid="TaskRow_SnoozeSubItem" Text="Snooze"
                                                   Visibility="{x:Bind IsCompleted, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}">
                                    <MenuFlyoutSubItem.Icon>
                                        <FontIcon Glyph="&#xE121;" />
                                    </MenuFlyoutSubItem.Icon>
                                    <MenuFlyoutItem Tag="{x:Bind}"
                                                    x:Uid="TaskRow_SnoozeTomorrowItem"
                                                    Text="Tomorrow"
                                                    Click="SnoozeTomorrow_Click" />
                                    <MenuFlyoutItem Tag="{x:Bind}"
                                                    x:Uid="TaskRow_SnoozeNextWeekItem"
                                                    Text="Next week"
                                                    Click="SnoozeNextWeek_Click" />
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSeparator
                                    Visibility="{x:Bind IsCompleted, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}" />
                                <MenuFlyoutItem Tag="{x:Bind}"
                                                x:Uid="Task_DeleteMenuItem"
                                                Click="DeleteButton_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                </StackPanel>

            </Grid>
        </DataTemplate>

        <Style x:Key="TaskListViewItemStyle" TargetType="ListViewItem"
               BasedOn="{StaticResource DefaultListViewItemStyle}">
            <!-- BasedOn required — without it, no Template setter means no selection visuals. -->
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MaxWidth" Value="{StaticResource PageMaxRowWidth}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0, 0" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
    </Page.Resources>

    <!-- Root: two columns — task list | details pane -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left column: header + add row + task list. Deliberately uncapped — each row below
             caps its own content instead, so the scrolling controls span the full column and
             their scrollbars track its right edge rather than a capped content edge. -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="24,24,24,8"
                  MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Stretch">
                <TextBlock x:Name="HeaderText" Text="My Tasks"
                           Style="{ThemeResource TitleLargeTextBlockStyle}"
                           VerticalAlignment="Center" />
            </Grid>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        Padding="24,0,24,6"
                        MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Stretch"
                        Visibility="{x:Bind ViewModel.IsTagFilterActive, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                <TextBlock x:Uid="TagFilter_ShowingText"
                           Text="Showing:"
                           VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Command="{x:Bind ViewModel.ClearTagFilterCommand}"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Style="{StaticResource ChipButtonStyle}"
                        Padding="8,3">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.ActiveTagFilter, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xE711;" FontSize="9"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Grid Grid.Row="2" Padding="24,8,24,16" ColumnSpacing="8"
                  MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewTaskTextBox"
                         AutomationProperties.AutomationId="NewTask_TextBox"
                         Grid.Column="0"
                         x:Uid="NewTask_TextBox"
                         Text="{x:Bind ViewModel.NewTaskText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="NewTaskTextBox_KeyDown" />
                <Button Grid.Column="1"
                        AutomationProperties.AutomationId="NewTask_AddButton"
                        Command="{x:Bind ViewModel.AddTaskCommand}"
                        Style="{ThemeResource AccentButtonStyle}"
                        MinWidth="80"
                        x:Uid="NewTask_AddButton" />
            </Grid>

            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Empty state — flat views -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            MaxWidth="260"
                            Visibility="{x:Bind ViewModel.ShowEmptyState, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind ViewModel.EmptyStateGlyph, Mode=OneWay, FallbackValue=&#xE762;}"
                              FontSize="48"
                              Foreground="{ThemeResource TextFillColorDisabledBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyStateHeadline, Mode=OneWay}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyStateSubtext, Mode=OneWay}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="WrapWholeWords"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                </StackPanel>

                <!-- Flat list with grouping — My Day, Important, All Tasks -->
                <!-- Full width (no side margin) so the scrollbar tracks the column's true right
                     edge. The wrapper's Width is pinned to the viewport because this
                     ScrollViewer's extent runs wider than its viewport once the per-group
                     ListViews are inside it, and a MaxWidth+Stretch child centres itself against
                     the extent — which parked the whole list ~240px right of the header. -->
                <ScrollViewer Grid.Row="0" x:Name="FlatListView"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Width="{x:Bind FlatListView.ViewportWidth, Mode=OneWay}">
                        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Stretch">
                            <ItemsControl x:Name="FlatGroupsItemsControl"
                                          ItemsSource="{x:Bind ViewModel.FlatGroupedTasks, Mode=OneWay}"
                                          HorizontalAlignment="Stretch"
                                          Padding="24,0,24,8">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:CompletedTaskGroup">
                                        <StackPanel Spacing="4" HorizontalAlignment="Stretch">

                                            <!-- Collapsible variant: used whenever a Completed group can appear
                                             alongside this one (My Day, All Tasks, custom lists) — the
                                             header lets you fold Open away to make room for Completed. -->
                                            <Expander IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Stretch"
                                                      Padding="0"
                                                      Margin="24,4"
                                                      CornerRadius="{ThemeResource ControlCornerRadius}"
                                                      Visibility="{x:Bind ShowExpander, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                                <Expander.Resources>
                                                    <StaticResource x:Key="ExpanderHeaderBackground"
                                                                    ResourceKey="SubtleFillColorSecondaryBrush" />
                                                    <StaticResource x:Key="ExpanderHeaderBackgroundPointerOver"
                                                                    ResourceKey="SubtleFillColorTertiaryBrush" />
                                                </Expander.Resources>
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                                Padding="0,16" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                                   FontWeight="SemiBold"
                                                                   Visibility="{x:Bind HasCountLabel, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind CountLabel, Mode=OneWay}"
                                                                   Visibility="{x:Bind HasCountLabel, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Expander.Header>

                                                <ListView ItemsSource="{x:Bind Items, Mode=OneWay}"
                                                          ItemTemplate="{StaticResource TaskItemTemplate}"
                                                          ItemContainerStyle="{StaticResource TaskListViewItemStyle}"
                                                          Margin="0"
                                                          Padding="0, 1"
                                                          CornerRadius="0"
                                                          SelectionMode="Single"
                                                          SelectionChanged="TaskListView_SelectionChanged"
                                                          IsTabStop="False"
                                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListView.ItemContainerTransitions>
                                                        <TransitionCollection />
                                                    </ListView.ItemContainerTransitions>
                                                </ListView>
                                            </Expander>

                                            <!-- Flat variant: Important's Open group, no Completed counterpart so no header/chevron. -->
                                            <ListView ItemsSource="{x:Bind Items, Mode=OneWay}"
                                                      ItemTemplate="{StaticResource TaskItemTemplate}"
                                                      ItemContainerStyle="{StaticResource TaskListViewItemStyle}"
                                                      SelectionMode="Single"
                                                      SelectionChanged="TaskListView_SelectionChanged"
                                                      IsTabStop="False"
                                                      Margin="20,4"
                                                      Visibility="{x:Bind ShowFlatList, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListView.ItemContainerTransitions>
                                                    <TransitionCollection />
                                                </ListView.ItemContainerTransitions>
                                            </ListView>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Suggestions — My Day only, shows tasks from previous days not yet completed -->
                            <StackPanel Margin="24,8,24,24"
                                        Spacing="4"
                                        Visibility="{x:Bind ViewModel.SuggestionsVisible, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                <TextBlock x:Uid="Suggestions_Header"
                                           Text="Suggested"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="8,0,0,4" />
                                <!-- Native ListView, not a Button ItemsRepeater — gets the selection indicator for free. Background must stay Transparent or it masks it. -->
                                <ListView ItemsSource="{x:Bind ViewModel.MySuggestions, Mode=OneWay}"
                                          ItemContainerStyle="{StaticResource TaskListViewItemStyle}"
                                          SelectionMode="Single"
                                          SelectionChanged="TaskListView_SelectionChanged"
                                          IsTabStop="False"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemContainerTransitions>
                                        <TransitionCollection />
                                    </ListView.ItemContainerTransitions>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:TodoItem">
                                            <Grid Tag="{x:Bind}"
                                                  Padding="12, 8,12, 8"
                                                  ColumnSpacing="8"
                                                  Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind Title, Mode=OneWay}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Button Grid.Column="1" Tag="{x:Bind}"
                                                        x:Uid="Suggestion_AddButton"
                                                        AutomationProperties.Name="Add to My Day"
                                                        Click="SuggestionAddButton_Click"
                                                        Style="{ThemeResource AccentButtonStyle}"
                                                        Padding="8"
                                                        MinWidth="0"
                                                        ToolTipService.ToolTip="Add to My Day">
                                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Grouped list — Planned view only. Padding insets rows without moving the ScrollBar (it's a margin on ScrollContentPresenter) — keep it near the flat lists' inset or rows misalign. -->
                <ListView Grid.Row="0" x:Name="GroupedListView"
                          ItemsSource="{x:Bind PlannedGroupsSource.View, Mode=OneWay}"
                          SelectionMode="Single"
                          SelectionChanged="TaskListView_SelectionChanged"
                          Padding="20,0,20,0"
                          ItemTemplate="{StaticResource TaskItemTemplate}"
                          ItemContainerStyle="{StaticResource TaskListViewItemStyle}"
                          Visibility="Collapsed">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <!-- The cap has to sit on the container, not the TextBlock inside it:
                                 ListViewHeaderItem shrink-wraps its content, so a MaxWidth on the
                                 header's own content has no room to centre within and the header
                                 lands hard left of its rows. -->
                            <GroupStyle.HeaderContainerStyle>
                                <Style TargetType="ListViewHeaderItem">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MaxWidth" Value="{StaticResource PageMaxRowWidth}" />
                                </Style>
                            </GroupStyle.HeaderContainerStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="vm:PlannedGroup">
                                    <TextBlock Text="{x:Bind Name, Mode=OneTime}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,12,0,8" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                </ListView>

                <InfoBar Grid.Row="1"
                         x:Name="UndoInfoBar"
                         AutomationProperties.AutomationId="UndoInfoBar"
                         IsOpen="{x:Bind ViewModel.IsUndoBarVisible, Mode=OneWay}"
                         Message="{x:Bind ViewModel.UndoMessage, Mode=OneWay}"
                         IsClosable="True"
                         Severity="Informational"
                         Margin="16,8,16,12"
                         MaxWidth="{StaticResource PageMaxRowWidth}" HorizontalAlignment="Stretch"
                         Closed="UndoInfoBar_Closed">
                    <InfoBar.ActionButton>
                        <Button x:Uid="UndoButton"
                                AutomationProperties.AutomationId="UndoButton"
                                Command="{x:Bind ViewModel.UndoLastActionCommand}"
                                Style="{ThemeResource AccentButtonStyle}" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </Grid>
        </Grid>

        <!-- Scrim — overlay mode only; appears behind the pane over the list -->
        <Border x:Name="PaneScrim"
                Grid.Column="0"
                Background="{ThemeResource SmokeFillColorDefaultBrush}"
                Visibility="Collapsed"
                Tapped="PaneScrim_Tapped" />

        <!-- Details pane — slides in from the right; column set in code-behind -->
        <Border x:Name="DetailsPaneRoot"
                Grid.Column="1"
                Width="280"
                Visibility="Collapsed"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                TabFocusNavigation="Cycle"
                KeyDown="DetailsPaneRoot_KeyDown">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DetailsPaneTranslate" X="280" />
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="16,16,16,8">
                    <TextBlock x:Uid="Pane_Header"
                               Text="Details"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <Button x:Name="PaneCloseButton"
                            x:Uid="PaneCloseButton"
                            AutomationProperties.AutomationId="PaneCloseButton"
                            AutomationProperties.Name="Close details"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Click="PaneCloseButton_Click"
                            ToolTipService.ToolTip="Close (Esc)"
                            Padding="8" MinWidth="0">
                        <FontIcon Glyph="&#xE8BB;" FontSize="12" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="16,8,16,24" Spacing="16">

                        <TextBox x:Name="PaneTitleBox"
                                 x:Uid="PaneTitleBox"
                                 Header="Title"
                                 PlaceholderText="Task title"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="False"
                                 HorizontalAlignment="Stretch"
                                 TextChanged="PaneTitleBox_TextChanged" />

                        <TextBox x:Name="PaneNotesBox"
                                 x:Uid="PaneNotesBox"
                                 AutomationProperties.AutomationId="PaneNotesBox"
                                 Header="Notes"
                                 PlaceholderText="Add a note…"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="100"
                                 MaxHeight="220"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 HorizontalAlignment="Stretch"
                                 TextChanged="PaneNotesBox_TextChanged"
                                 KeyDown="PaneNotesBox_KeyDown" />

                        <ToggleSwitch x:Name="PaneMyDayToggle"
                                      x:Uid="PaneMyDayToggle"
                                      Header="My Day"
                                      OffContent=""
                                      OnContent=""
                                      Toggled="PaneMyDayToggle_Toggled"
                                      Margin="0,-4,0,-4" />

                        <!-- Item order must match the TaskPriority enum — code-behind maps
                             SelectedIndex straight to the enum value. -->
                        <ComboBox x:Name="PanePriorityCombo"
                                  x:Uid="PanePriorityCombo"
                                  AutomationProperties.AutomationId="PanePriorityCombo"
                                  Header="Priority"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="PanePriorityCombo_SelectionChanged">
                            <ComboBoxItem x:Uid="PriorityItem_None" Content="None" />
                            <ComboBoxItem x:Uid="PriorityItem_Low" Content="Low" />
                            <ComboBoxItem x:Uid="PriorityItem_Medium" Content="Medium" />
                            <ComboBoxItem x:Uid="PriorityItem_High" Content="High" />
                        </ComboBox>

                        <CalendarDatePicker x:Name="PaneDueDatePicker"
                                            x:Uid="PaneDueDatePicker"
                                            Header="Due date"
                                            PlaceholderText="No due date"
                                            HorizontalAlignment="Stretch"
                                            DateChanged="PaneDueDatePicker_DateChanged" />

                        <!-- Repeat — only meaningful once a due date is set -->
                        <!-- Item order must match the TaskRecurrence enum — code-behind maps
                             SelectedIndex straight to the enum value. -->
                        <ComboBox x:Name="PaneRepeatCombo"
                                  x:Uid="PaneRepeatCombo"
                                  AutomationProperties.AutomationId="PaneRepeatCombo"
                                  Header="Repeat"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="PaneRepeatCombo_SelectionChanged">
                            <ComboBoxItem x:Uid="RepeatItem_None" Content="Doesn't repeat" />
                            <ComboBoxItem x:Uid="RepeatItem_Daily" Content="Daily" />
                            <ComboBoxItem x:Uid="RepeatItem_Weekdays" Content="Weekdays" />
                            <ComboBoxItem x:Uid="RepeatItem_Weekly" Content="Weekly" />
                            <ComboBoxItem x:Uid="RepeatItem_Monthly" Content="Monthly" />
                        </ComboBox>

                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="Pane_TagsLabel"
                                       Text="Tags"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollMode="Auto"
                                          VerticalScrollMode="Disabled">
                                <ItemsRepeater x:Name="PaneTagChips">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="6" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10,0,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="4"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind}"
                                                               VerticalAlignment="Center"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                    <Button Tag="{x:Bind}"
                                                            x:Uid="PaneTagChipRemove"
                                                            AutomationProperties.Name="Remove tag"
                                                            Click="PaneTagChipRemove_Click"
                                                            Style="{ThemeResource SubtleButtonStyle}"
                                                            Padding="6"
                                                            MinWidth="32"
                                                            MinHeight="32"
                                                            IsTabStop="False"
                                                            VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE711;"
                                                                  FontSize="10"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                            <TextBox x:Name="PaneTagInput"
                                     x:Uid="PaneTagInput"
                                     PlaceholderText="Add a tag, press Enter"
                                     KeyDown="PaneTagInput_KeyDown" />
                        </StackPanel>

                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock x:Uid="Pane_CreatedLabel"
                                           Text="Created"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock x:Name="PaneCreatedAtText"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:Uid="Pane_UpdatedLabel"
                                           Text="Updated"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock x:Name="PaneUpdatedAtText"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

    </Grid>
</Page>