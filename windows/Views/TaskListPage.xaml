<Page
    x:Class="Hatch.Views.TaskListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Hatch.Models"
    xmlns:helpers="using:Hatch.Helpers"
    xmlns:converters="using:Hatch.Converters"
    xmlns:controls="using:Hatch.Controls"
    xmlns:vm="using:Hatch.ViewModels"
    Background="Transparent">

    <Page.Resources>
        <converters:BoolToStrikethroughConverter x:Key="BoolToStrikethrough" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacity" />
        <converters:DateTimeToStringConverter x:Key="DateTimeToString" />
        <converters:DueDateToStringConverter x:Key="DueDateToString" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolToStarGlyphConverter x:Key="BoolToStarGlyph" />
        <converters:DueDateToChipVisibilityConverter x:Key="DueDateToChipVisibility" />
        <converters:DueDateToChipForegroundConverter x:Key="DueDateToChipForeground" />
        <converters:DueDateToChipGlyphConverter x:Key="DueDateToChipGlyph" />
        <converters:PlannedGroupNameToForegroundConverter x:Key="PlannedGroupNameToForeground" />
        <converters:BoolToStarTooltipConverter x:Key="BoolToStarTooltip" />
        <converters:TagsToVisibilityConverter x:Key="TagsToVisibility" />
        <converters:TagsPreviewConverter x:Key="TaskTagsPreview" />
        <converters:PriorityToLabelConverter x:Key="PriorityToLabel" />
        <converters:PriorityToContrastVisibilityConverter x:Key="PriorityToContrastVisibility" />

        <DataTemplate x:Key="MeetingRowTemplate" x:DataType="vm:CalendarEventRow">
            <Grid ColumnSpacing="10" Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind CompactTimeLabel, Mode=OneTime}" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" TextWrapping="Wrap" />
                <Border Grid.Column="1" Width="2" Margin="0,8"
                        Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1"
                        Opacity="{x:Bind TimelineMarkerOpacity}" />
                <Button Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="8,8" AutomationProperties.AutomationId="{x:Bind AutomationId}"
                        AutomationProperties.Name="{x:Bind DetailsName}">
                    <TextBlock Text="{x:Bind Subject}" Foreground="{x:Bind SubjectBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind Subject}" />
                    <Button.Flyout>
                        <Flyout Placement="Bottom" ShouldConstrainToRootBounds="True">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter"><Setter Property="MaxWidth" Value="360" /></Style>
                            </Flyout.FlyoutPresenterStyle>
                            <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel MaxWidth="304" Spacing="8">
                                    <TextBlock Text="{x:Bind Subject}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind TimeLabel}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind SourceLabel}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <HyperlinkButton x:Uid="Calendar_JoinMeeting" AutomationProperties.AutomationId="Calendar_DetailJoin"
                                                         NavigateUri="{x:Bind MeetingUri}" AutomationProperties.Name="{x:Bind JoinName}" Padding="0,4"
                                                         Visibility="{x:Bind HasMeetingLink, Converter={StaticResource BoolToVisibility}}" />
                                        <HyperlinkButton x:Uid="Calendar_OpenEvent" AutomationProperties.AutomationId="Calendar_OpenEvent"
                                                         NavigateUri="{x:Bind EventUri}" AutomationProperties.Name="{x:Bind OpenName}" Padding="0,4"
                                                         Visibility="{x:Bind HasEventLink, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <HyperlinkButton Grid.Column="3" x:Uid="Calendar_QuickJoin" AutomationProperties.AutomationId="Calendar_JoinMeeting"
                                 NavigateUri="{x:Bind MeetingUri}" AutomationProperties.Name="{x:Bind JoinName}"
                                 VerticalAlignment="Center" Padding="8,6"
                                 Visibility="{x:Bind ShowQuickJoin, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AgendaMeetingRowTemplate" x:DataType="vm:CalendarEventRow">
            <Grid ColumnSpacing="10" Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind CompactTimeLabel}" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" TextWrapping="Wrap" />
                <Border Grid.Column="1" Width="2" Margin="0,8"
                        Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="1"
                        Opacity="{x:Bind TimelineMarkerOpacity, Mode=OneTime}" />
                <Button Grid.Column="2" Style="{StaticResource SubtleButtonStyle}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="8,8"
                        AutomationProperties.AutomationId="Agenda_MeetingDetails"
                        AutomationProperties.Name="{x:Bind DetailsName, Mode=OneTime}">
                    <TextBlock Text="{x:Bind Subject, Mode=OneTime}" Foreground="{x:Bind SubjectBrush, Mode=OneTime}"
                               VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind Subject, Mode=OneTime}" />
                    <Button.Flyout>
                        <Flyout Placement="Bottom" ShouldConstrainToRootBounds="True">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="MaxWidth" Value="360" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel MaxWidth="304" Spacing="8">
                                    <TextBlock Text="{x:Bind Subject, Mode=OneTime}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind TimeLabel, Mode=OneTime}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind SourceLabel, Mode=OneTime}"
                                               TextWrapping="Wrap"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <HyperlinkButton x:Uid="Calendar_JoinMeeting"
                                                         AutomationProperties.AutomationId="Agenda_DetailJoin"
                                                         NavigateUri="{x:Bind MeetingUri, Mode=OneTime}"
                                                         AutomationProperties.Name="{x:Bind JoinName, Mode=OneTime}"
                                                         Padding="0,4"
                                                         Visibility="{x:Bind HasMeetingLink, Converter={StaticResource BoolToVisibility}, Mode=OneTime}" />
                                        <HyperlinkButton x:Uid="Calendar_OpenEvent"
                                                         AutomationProperties.AutomationId="Agenda_OpenEvent"
                                                         NavigateUri="{x:Bind EventUri, Mode=OneTime}"
                                                         AutomationProperties.Name="{x:Bind OpenName, Mode=OneTime}"
                                                         Padding="0,4"
                                                         Visibility="{x:Bind HasEventLink, Converter={StaticResource BoolToVisibility}, Mode=OneTime}" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <HyperlinkButton Grid.Column="3" x:Uid="Calendar_QuickJoin" AutomationProperties.AutomationId="Agenda_JoinMeeting"
                                 NavigateUri="{x:Bind MeetingUri, Mode=OneTime}" AutomationProperties.Name="{x:Bind JoinName, Mode=OneTime}"
                                 VerticalAlignment="Center" Padding="8,6"
                                 Visibility="{x:Bind ShowQuickJoin, Converter={StaticResource BoolToVisibility}, Mode=OneTime}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="TaskMetadataIconStyle" TargetType="FontIcon">
            <Setter Property="VerticalAlignment" Value="Center" />
            <!-- Caption text's visible ink sits below its line-box center.
                 This 2px top margin gives centered glyphs a 1px optical adjustment. -->
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- Details-pane metadata rows (hatch-mobile 0c137fb): a glyph gutter, a label, and
             one value per row, grouped into sections that read as one card. Hand-rolled
             rather than SettingsCard: the pane is 280–360px, under SettingsCard's wrap
             threshold, so every card would stack its content beneath its own header instead
             of sitting beside it. SettingsPage.xaml hand-rolls ToggleCardBorderStyle for the
             same reason. -->
        <Style x:Key="PaneSectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        </Style>

        <Style x:Key="PaneSectionLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="Margin" Value="4,0,0,4" />
        </Style>

        <Style x:Key="PaneRowDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>

        <Style x:Key="PaneRowGlyphStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="PaneRowLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="PaneRowGridStyle" TargetType="Grid">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="ColumnSpacing" Value="10" />
            <Setter Property="MinHeight" Value="40" />
        </Style>

        <!-- Chip button: preserves the chip color on hover/press instead of flashing WinUI default grey -->
        <Style x:Key="ChipButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid"
                              Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.75" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.55" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared item template used by both flat and grouped lists -->
        <DataTemplate x:Key="TaskItemTemplate" x:DataType="models:TodoItem">
            <Grid Tag="{x:Bind}"
                  Margin="0,0"
                  Padding="24,12,24,12"
                  ColumnSpacing="8"
                  CornerRadius="0"
                  Background="Transparent"
                  PointerPressed="TaskCard_PointerPressed"
                  Tapped="TaskCard_Tapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <controls:PriorityCheckBox Grid.Column="0"
                          Style="{StaticResource DefaultCheckBoxStyle}"
                          AutomationProperties.AutomationId="Task_CheckBox"
                          Priority="{x:Bind Priority, Mode=OneWay}"
                          TaskTitle="{x:Bind Title, Mode=OneWay}"
                          IsChecked="{x:Bind IsCompleted, Mode=TwoWay}"
                          VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"
                            Opacity="{x:Bind IsCompleted, Converter={StaticResource BoolToOpacity}, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                               TextDecorations="{x:Bind IsCompleted, Converter={StaticResource BoolToStrikethrough}, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis" />

                    <!-- The horizontal viewport keeps a dense metadata line inside the text
                         column on narrow windows while preserving horizontal access to its tail. -->
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalScrollMode="Disabled"
                                  IsTabStop="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Priority, Converter={StaticResource PriorityToLabel}, ConverterParameter=Full, Mode=OneWay}"
                                       Visibility="{x:Bind Priority, Converter={StaticResource PriorityToContrastVisibility}, Mode=OneWay}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Style="{StaticResource TaskMetadataIconStyle}"
                                      Glyph="&#xE70B;"
                                      FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      ToolTipService.ToolTip="Has notes"
                                      AutomationProperties.Name="Has notes"
                                      VerticalAlignment="Center"
                                      Visibility="{x:Bind HasNotes, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />

                            <Button Tag="{x:Bind}"
                                    AutomationProperties.AutomationId="Task_DateChipButton"
                                    AutomationProperties.Name="{x:Bind DueDate, Converter={StaticResource DueDateToString}, Mode=OneWay}"
                                    Click="ChipDateButton_Click"
                                    Visibility="{x:Bind DueDate, Converter={StaticResource DueDateToChipVisibility}, Mode=OneWay}"
                                    Background="Transparent"
                                    Style="{StaticResource ChipButtonStyle}"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    IsTabStop="True"
                                    x:Uid="Task_DateChipButton">
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind DueDate, Converter={StaticResource DueDateToChipGlyph}, Mode=OneWay}"
                                              Style="{StaticResource TaskMetadataIconStyle}"
                                              FontSize="11"
                                              Foreground="{x:Bind DueDate, Converter={StaticResource DueDateToChipForeground}, Mode=OneWay}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind DueDate, Converter={StaticResource DueDateToString}, Mode=OneWay}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{x:Bind DueDate, Converter={StaticResource DueDateToChipForeground}, Mode=OneWay}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <StackPanel Orientation="Horizontal" Spacing="3"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Steps"
                                        Visibility="{x:Bind HasSteps, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9D5;" FontSize="12"
                                          Style="{StaticResource TaskMetadataIconStyle}"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind StepProgressLabel, Mode=OneWay}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <FontIcon Glyph="&#xE895;"
                                      Style="{StaticResource TaskMetadataIconStyle}"
                                      FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      ToolTipService.ToolTip="Repeats"
                                      AutomationProperties.Name="Repeats"
                                      Visibility="{x:Bind HasRecurrence, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />

                            <StackPanel Orientation="Horizontal" Spacing="3"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind HasCustomListName, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                <FontIcon Glyph="&#xE8FD;" FontSize="12"
                                          Style="{StaticResource TaskMetadataIconStyle}"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ListName, Mode=OneWay}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="96"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <ItemsRepeater ItemsSource="{x:Bind Tags, Converter={StaticResource TaskTagsPreview}, Mode=OneWay}"
                                           Visibility="{x:Bind Tags, Converter={StaticResource TagsToVisibility}, Mode=OneWay}"
                                           VerticalAlignment="Center">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button Tag="{x:Bind}"
                                                Click="TagChipInRow_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                MinWidth="0"
                                                MinHeight="0"
                                                MaxWidth="96"
                                                IsTabStop="False"
                                                VerticalAlignment="Center">
                                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1">
                                                <Run Text="#" />
                                                <Run Text="{x:Bind}" />
                                            </TextBlock>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        Visibility="{x:Bind IsCompleted, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}">
                                <Button Tag="{x:Bind}"
                                        AutomationProperties.AutomationId="Task_AddDateButton"
                                        Click="ChipDateButton_Click"
                                        Visibility="{x:Bind ShowAddDateHint, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                        Padding="0" MinWidth="0" MinHeight="0"
                                        Background="Transparent" BorderThickness="0"
                                        VerticalAlignment="Center"
                                        IsTabStop="False"
                                        x:Uid="Task_AddDateButton">
                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE787;" FontSize="11"
                                                  Style="{StaticResource TaskMetadataIconStyle}"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock x:Uid="Task_AddDateText"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>

                <!--
                    Always-visible action strip.
                    ☆  star/unstar
                    ⋯  overflow menu — Delete lives here
                -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Tag="{x:Bind}"
                            AutomationProperties.AutomationId="Task_StarButton"
                            AutomationProperties.Name="{x:Bind IsStarred, Converter={StaticResource BoolToStarTooltip}, Mode=OneWay}"
                            Click="StarButton_Click"
                            ToolTipService.ToolTip="{x:Bind IsStarred, Converter={StaticResource BoolToStarTooltip}, Mode=OneWay}"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Visibility="{x:Bind IsCompleted, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}"
                            Padding="8,6" MinWidth="0">
                        <FontIcon Glyph="{x:Bind IsStarred, Converter={StaticResource BoolToStarGlyph}, Mode=OneWay}"
                                  FontSize="14"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>

                    <!-- ⋯ overflow — destructive and future actions live here -->
                    <Button Tag="{x:Bind}"
                            AutomationProperties.AutomationId="Task_OverflowButton"
                            AutomationProperties.Name="More options"
                            x:Uid="Task_OverflowButton"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Padding="8,6" MinWidth="0">
                        <FontIcon Glyph="&#xE712;" FontSize="14"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Tag="{x:Bind}"
                                                x:Uid="TaskRow_FocusMenuItem"
                                                Text="Focus on this"
                                                Click="FocusMenuItem_Click"
                                                Visibility="{x:Bind IsCompleted, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE916;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator
                                    Visibility="{x:Bind IsCompleted, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}" />
                                <MenuFlyoutSubItem x:Uid="TaskRow_SnoozeSubItem" Text="Snooze"
                                                   Visibility="{x:Bind IsCompleted, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}">
                                    <MenuFlyoutSubItem.Icon>
                                        <FontIcon Glyph="&#xE121;" />
                                    </MenuFlyoutSubItem.Icon>
                                    <MenuFlyoutItem Tag="{x:Bind}"
                                                    x:Uid="TaskRow_SnoozeTomorrowItem"
                                                    Text="Tomorrow"
                                                    Click="SnoozeTomorrow_Click" />
                                    <MenuFlyoutItem Tag="{x:Bind}"
                                                    x:Uid="TaskRow_SnoozeNextWeekItem"
                                                    Text="Next week"
                                                    Click="SnoozeNextWeek_Click" />
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSeparator
                                    Visibility="{x:Bind IsCompleted, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}" />
                                <MenuFlyoutItem Tag="{x:Bind}"
                                                x:Uid="Task_DeleteMenuItem"
                                                Click="DeleteButton_Click">
                                    <MenuFlyoutItem.Resources>
                                        <ResourceDictionary>
                                            <ResourceDictionary.ThemeDictionaries>
                                                <ResourceDictionary x:Key="Default">
                                                    <StaticResource x:Key="MenuFlyoutItemForeground" ResourceKey="SystemFillColorCriticalBrush" />
                                                    <StaticResource x:Key="MenuFlyoutItemForegroundPointerOver" ResourceKey="SystemFillColorCriticalBrush" />
                                                    <StaticResource x:Key="MenuFlyoutItemForegroundPressed" ResourceKey="SystemFillColorCriticalBrush" />
                                                </ResourceDictionary>
                                                <ResourceDictionary x:Key="Light">
                                                    <StaticResource x:Key="MenuFlyoutItemForeground" ResourceKey="SystemFillColorCriticalBrush" />
                                                    <StaticResource x:Key="MenuFlyoutItemForegroundPointerOver" ResourceKey="SystemFillColorCriticalBrush" />
                                                    <StaticResource x:Key="MenuFlyoutItemForegroundPressed" ResourceKey="SystemFillColorCriticalBrush" />
                                                </ResourceDictionary>
                                                <ResourceDictionary x:Key="HighContrast">
                                                    <StaticResource x:Key="MenuFlyoutItemForeground" ResourceKey="SystemColorButtonTextColorBrush" />
                                                    <StaticResource x:Key="MenuFlyoutItemForegroundPointerOver" ResourceKey="SystemColorHighlightTextColorBrush" />
                                                    <StaticResource x:Key="MenuFlyoutItemForegroundPressed" ResourceKey="SystemColorHighlightTextColorBrush" />
                                                </ResourceDictionary>
                                            </ResourceDictionary.ThemeDictionaries>
                                        </ResourceDictionary>
                                    </MenuFlyoutItem.Resources>
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                </StackPanel>

            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PlannedAgendaEntryTemplate" x:DataType="vm:PlannedAgendaEntry">
            <Grid>
                <Grid Margin="4,20,4,4" ColumnSpacing="12"
                      Visibility="{x:Bind HasDateTitle, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind DateTitle}" Style="{ThemeResource SubtitleTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Height="1" VerticalAlignment="Center"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </Grid>
                <Grid Margin="24,10,24,4" ColumnSpacing="12"
                      Visibility="{x:Bind HasSectionTitle, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind SectionTitle}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Height="1" VerticalAlignment="Center"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </Grid>
                <Grid Visibility="{x:Bind HasMeeting, Converter={StaticResource BoolToVisibility}}">
                    <ContentPresenter Content="{x:Bind Meeting}" ContentTemplate="{StaticResource AgendaMeetingRowTemplate}" />
                </Grid>
                <Grid Visibility="{x:Bind HasTask, Converter={StaticResource BoolToVisibility}}">
                    <ContentPresenter Content="{x:Bind Task}" ContentTemplate="{StaticResource TaskItemTemplate}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <Style x:Key="TaskListViewItemStyle" TargetType="ListViewItem"
               BasedOn="{StaticResource DefaultListViewItemStyle}">
            <!-- BasedOn required — without it, no Template setter means no selection visuals. -->
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MaxWidth" Value="{StaticResource PageMaxRowWidth}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0, 0" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <Style x:Key="PlannedAgendaItemStyle" TargetType="ListViewItem"
               BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MaxWidth" Value="{StaticResource PageMaxRowWidth}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Padding="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <helpers:PlannedAgendaItemStyleSelector x:Key="PlannedAgendaItemStyleSelector"
                                                TaskStyle="{StaticResource TaskListViewItemStyle}"
                                                DefaultStyle="{StaticResource PlannedAgendaItemStyle}" />

    </Page.Resources>

    <!-- Root: two columns — task list | details pane -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left column: header + add row + task list. Deliberately uncapped — each row below
             caps its own content instead, so the scrolling controls span the full column and
             their scrollbars track its right edge rather than a capped content edge. -->
        <Grid Grid.Column="0" Margin="0,0,0,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="{x:Bind TaskHeaderPadding(ViewModel.IsTaskComposerFloating, ViewModel.IsTagFilterActive), Mode=OneWay}"
                  MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HeaderText" Text="My Tasks"
                           AutomationProperties.AutomationId="TaskPage_Title"
                           Style="{ThemeResource TitleTextBlockStyle}"
                           FontSize="36"
                           VerticalAlignment="Center"
                           Visibility="{x:Bind ViewModel.IsMyDayPage, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}" />
                <StackPanel Spacing="4"
                            Visibility="{x:Bind ViewModel.IsMyDayPage, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.MyDayGreetingText, Mode=OneWay}"
                               Style="{ThemeResource TitleTextBlockStyle}" FontSize="36" />
                    <TextBlock Text="{x:Bind ViewModel.MyDayDateText, Mode=OneWay}"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Spacing="6"
                                Visibility="{x:Bind ViewModel.IsLoaded, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.MyDaySummaryText, Mode=OneWay}"
                                   AutomationProperties.AutomationId="MyDay_Summary"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   MinHeight="22"
                                   TextWrapping="WrapWholeWords" />
                        <Grid Height="4" MaxWidth="280" HorizontalAlignment="Left">
                            <ProgressBar x:Uid="MyDayProgressBar"
                                         Height="4"
                                         IsTabStop="False"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{x:Bind ViewModel.MyDayProgressPercent, Mode=OneWay}"
                                         Visibility="{x:Bind ViewModel.HasMyDayProgress, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                    <!-- The progress slot and stack spacing supply 14 DIPs of the 16-DIP gap. -->
                    <Button x:Uid="Suggestions_Button" x:Name="SuggestionsButton"
                            AutomationProperties.AutomationId="Suggestions_Button"
                            HorizontalAlignment="Left" Margin="0,2,0,0"
                            Visibility="{x:Bind ViewModel.SuggestionsVisible, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Uid="Suggestions_ButtonLabel" Text="Suggestions" VerticalAlignment="Center" />
                            <InfoBadge Value="{x:Bind ViewModel.SuggestionsCount, Mode=OneWay}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="SuggestionsFlyout" Placement="BottomEdgeAlignedLeft"
                                    Opened="SuggestionsFlyout_Opened" Closed="SuggestionsFlyout_Closed">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="MaxWidth" Value="400" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <StackPanel Spacing="12">
                                    <TextBlock x:Uid="Suggestions_Description"
                                               Text="Choose tasks to add to your My Day plan."
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="WrapWholeWords" />
                                    <TextBlock x:Uid="Suggestions_Empty" Text="No more tasks to suggest."
                                               TextWrapping="WrapWholeWords"
                                               Visibility="{x:Bind ViewModel.HasSuggestions, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}" />
                                    <ListView x:Name="SuggestionsList" AutomationProperties.AutomationId="Suggestions_List"
                                              ItemsSource="{x:Bind ViewModel.MySuggestions, Mode=OneWay}"
                                              ItemContainerStyle="{StaticResource TaskListViewItemStyle}"
                                              MaxHeight="320" SelectionMode="Single" HorizontalContentAlignment="Stretch"
                                              SelectionChanged="TaskListView_SelectionChanged"
                                              Loaded="TaskListView_Loaded" Unloaded="TaskListView_Unloaded"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:TodoItem">
                                                <Grid Padding="12,8" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind DueDate, Converter={StaticResource DueDateToString}, Mode=OneWay}"
                                                                   Foreground="{x:Bind DueDate, Converter={StaticResource DueDateToChipForeground}, Mode=OneWay}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                                                   Visibility="{x:Bind DueDate, Converter={StaticResource DueDateToChipVisibility}, Mode=OneWay}" />
                                                        <TextBlock x:Uid="Suggestions_NoDate" Text="No due date"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Visibility="{x:Bind DueDate, Converter={StaticResource DueDateToChipVisibility}, ConverterParameter=Invert, Mode=OneWay}" />
                                                        <TextBlock Text="{x:Bind Priority, Converter={StaticResource PriorityToLabel}, ConverterParameter=Full, Mode=OneWay}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                                                   Visibility="{x:Bind HasPriority, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                                                        <TextBlock Text="{x:Bind ListName, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Visibility="{x:Bind HasCustomListName, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Tag="{x:Bind}" x:Uid="Suggestion_AddButton"
                                                            AutomationProperties.AutomationId="Suggestion_AddButton"
                                                            Click="SuggestionAddButton_Click" VerticalAlignment="Center"
                                                            Style="{ThemeResource AccentButtonStyle}" Padding="8" MinWidth="0">
                                                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <Grid ColumnSpacing="12"
                                          Visibility="{x:Bind ViewModel.CanExpandSuggestions, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind ViewModel.SuggestionsSummaryText, Mode=OneWay}"
                                                   AutomationProperties.AutomationId="Suggestions_Summary"
                                                   TextWrapping="WrapWholeWords" VerticalAlignment="Center"
                                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <Button Grid.Column="1" AutomationProperties.AutomationId="Suggestions_Toggle"
                                                Content="{x:Bind ViewModel.SuggestionsToggleLabel, Mode=OneWay}"
                                                Command="{x:Bind ViewModel.ToggleSuggestionsCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.IsPlannedPage, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                <controls:CalendarSourcesButton x:Name="PlannedCalendarSources" Visibility="Collapsed" />
                <Border BorderBrush="Transparent"
                        BorderThickness="0" CornerRadius="0" Padding="0"
                        Background="Transparent"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsPlannedPage, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <Grid>
                        <SelectorBar x:Name="PlannedViewSelector" x:Uid="PlannedViewSelector"
                                     AutomationProperties.AutomationId="PlannedViewSelector"
                                     VerticalAlignment="Center" Background="Transparent"
                                     SelectionChanged="PlannedViewSelector_SelectionChanged">
                            <SelectorBar.Resources>
                                <ResourceDictionary>
                                    <StaticResource x:Key="SelectorBarItemBackground" ResourceKey="SystemControlTransparentBrush" />
                                    <StaticResource x:Key="SelectorBarItemBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                    <StaticResource x:Key="SelectorBarItemBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                    <StaticResource x:Key="SelectorBarItemBackgroundSelected" ResourceKey="SubtleFillColorSecondaryBrush" />
                                    <StaticResource x:Key="SelectorBarItemBackgroundSelectedPointerOver" ResourceKey="NavigationViewItemBackgroundSelectedPointerOver" />
                                    <StaticResource x:Key="SelectorBarItemForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                    <StaticResource x:Key="SelectorBarItemForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                </ResourceDictionary>
                            </SelectorBar.Resources>
                            <SelectorBarItem x:Name="PlannedCalendarItem" x:Uid="PlannedCalendarItem"
                                             AutomationProperties.AutomationId="PlannedCalendarItem"
                                             Background="Transparent" Icon="CalendarDay"
                                             PointerEntered="PlannedViewSelectorItem_PointerEntered"
                                             PointerExited="PlannedViewSelectorItem_PointerExited" />
                            <SelectorBarItem x:Name="PlannedAgendaItem" x:Uid="PlannedAgendaItem"
                                             AutomationProperties.AutomationId="PlannedAgendaItem"
                                             Background="Transparent" Icon="List"
                                             PointerEntered="PlannedViewSelectorItem_PointerEntered"
                                             PointerExited="PlannedViewSelectorItem_PointerExited" />
                        </SelectorBar>
                        <Border Width="1" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                IsHitTestVisible="False" />
                    </Grid>
                </Border>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        Padding="{x:Bind TaskTagFilterPadding(ViewModel.IsTaskComposerFloating), Mode=OneWay}"
                        MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Stretch"
                        Visibility="{x:Bind ViewModel.IsTagFilterActive, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                <TextBlock x:Uid="TagFilter_ShowingText"
                           Text="Showing:"
                           VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Command="{x:Bind ViewModel.ClearTagFilterCommand}"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Style="{StaticResource ChipButtonStyle}"
                        Padding="8,3">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.ActiveTagFilter, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xE711;" FontSize="9"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <ContentControl x:Name="TaskComposer" Grid.Row="{x:Bind ViewModel.TaskComposerRow, Mode=OneWay}"
                    AutomationProperties.AutomationId="TaskComposer"
                    Margin="{x:Bind ComposerOuterMargin(ViewModel.IsTaskComposerFloating), Mode=OneWay}"
                    VerticalAlignment="{x:Bind ComposerAlignment(ViewModel.IsTaskComposerFloating), Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.IsTaskComposerVisible, Mode=OneWay}"
                    IsTabStop="False" HorizontalContentAlignment="Stretch"
                    Canvas.ZIndex="1" GotFocus="TaskComposer_GotFocus"
                    SizeChanged="BottomControls_SizeChanged"
                    HorizontalAlignment="Stretch">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="TaskComposerTranslate" />
                </ContentControl.RenderTransform>
                <Grid MaxWidth="{StaticResource PageMaxRowWidth}" HorizontalAlignment="Stretch">
                    <Border CornerRadius="{ThemeResource ControlCornerRadius}"
                            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" />
                    <Grid ColumnSpacing="8" Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewTaskTextBox" Grid.Column="0" MinWidth="0"
                                 AutomationProperties.AutomationId="NewTask_TextBox" x:Uid="NewTask_TextBox"
                                 ToolTipService.ToolTip="{x:Bind ViewModel.NewTaskDestinationText, Mode=OneWay}"
                                 PlaceholderText="{x:Bind ViewModel.NewTaskPlaceholderText, Mode=OneWay}"
                                 Text="{x:Bind ViewModel.NewTaskText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="NewTaskTextBox_KeyDown" />
                        <Button Grid.Column="1" Padding="8,5" MinWidth="32" VerticalAlignment="Stretch"
                                AutomationProperties.AutomationId="NewTask_DueDate"
                                AutomationProperties.Name="{x:Bind ViewModel.NewTaskDueDateTooltip, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.NewTaskDueDateTooltip, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Grid Width="18" Height="18">
                                    <FontIcon Glyph="&#xE787;" FontSize="16" />
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Visibility="{x:Bind ViewModel.HasNewTaskDueDate, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE73E;" FontSize="9" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.NewTaskDueDateLabel, Mode=OneWay}"
                                           MaxWidth="88" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind ComposerDateLabelVisibility(TaskComposer.ActualWidth, ViewModel.HasNewTaskDueDate), Mode=OneWay}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout x:Name="NewTaskDateFlyout"
                                        Placement="{x:Bind ComposerFlyoutPlacement(ViewModel.IsTaskComposerFloating), Mode=OneWay}"
                                        Opened="NewTaskDateFlyout_Opened" Closed="NewTaskDateFlyout_Closed">
                                    <StackPanel Spacing="8">
                                        <CalendarView x:Name="NewTaskCalendar" SelectionMode="Single"
                                                      AutomationProperties.AutomationId="NewTask_Calendar"
                                                      x:Uid="NewTask_Calendar"
                                                      SelectedDatesChanged="NewTaskCalendar_SelectedDatesChanged" />
                                        <Button x:Uid="NewTask_ClearDueDate"
                                                AutomationProperties.AutomationId="NewTask_ClearDueDate"
                                                Command="{x:Bind ViewModel.ClearNewTaskDueDateCommand}"
                                                Click="NewTaskClearDueDate_Click"
                                                Visibility="{x:Bind ViewModel.CanClearNewTaskDueDate, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <ToggleButton Grid.Column="2" x:Uid="NewTask_Important" Padding="8,5" MinWidth="32"
                                      VerticalAlignment="Stretch"
                                      AutomationProperties.AutomationId="NewTask_Important"
                                      AutomationProperties.HelpText="{x:Bind ViewModel.NewTaskImportantTooltip, Mode=OneWay}"
                                      ToolTipService.ToolTip="{x:Bind ViewModel.NewTaskImportantTooltip, Mode=OneWay}"
                                      IsEnabled="{x:Bind ViewModel.CanChangeNewTaskImportant, Mode=OneWay}"
                                      IsChecked="{x:Bind ViewModel.NewTaskImportant, Mode=TwoWay}">
                            <FontIcon Glyph="{x:Bind ViewModel.NewTaskImportantGlyph, Mode=OneWay}" FontSize="16" />
                        </ToggleButton>
                        <Button Grid.Column="3" AutomationProperties.AutomationId="NewTask_AddButton"
                                VerticalAlignment="Stretch"
                                Command="{x:Bind ViewModel.AddTaskCommand}" Click="NewTaskAddButton_Click"
                                Style="{ThemeResource AccentButtonStyle}" MinWidth="64" x:Uid="NewTask_AddButton" />
                    </Grid>
                </Grid>
            </ContentControl>

            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Empty state — flat views -->
                <StackPanel x:Name="TaskEmptyState" Grid.Row="1" HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            MaxWidth="260"
                            Visibility="{x:Bind EmptyStateVisibility(ViewModel.ShowEmptyState, ViewModel.IsPlannedPage, ViewModel.IsPlannedCalendar, CalendarViewModel.HasAgendaEvents), Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind ViewModel.EmptyStateGlyph, Mode=OneWay, FallbackValue=&#xE762;}"
                              FontSize="48"
                              Foreground="{ThemeResource TextFillColorDisabledBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyStateHeadline, Mode=OneWay}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyStateSubtext, Mode=OneWay}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="WrapWholeWords"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                </StackPanel>

                <!-- Open and completed task groups; only completed tasks collapse. -->
                <!-- Full width (no side margin) so the scrollbar tracks the column's true right
                     edge. The wrapper's Width is pinned to the viewport because this
                     ScrollViewer's extent runs wider than its viewport once the per-group
                     ListViews are inside it, and a MaxWidth+Stretch child centres itself against
                     the extent — which parked the whole list ~240px right of the header. -->
                <ScrollViewer Grid.Row="1" x:Name="FlatListView"
                              AutomationProperties.AutomationId="FlatListView"
                              ViewChanged="TaskListScroll_ViewChanged"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="TaskScrollContent" Width="{x:Bind FlatListView.ViewportWidth, Mode=OneWay}">
                        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Stretch">
                            <ItemsControl x:Name="FlatGroupsItemsControl"
                                          ItemsSource="{x:Bind ViewModel.FlatGroupedTasks, Mode=OneWay}"
                                          HorizontalAlignment="Stretch"
                                          Padding="24,0,24,0">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:CompletedTaskGroup">
                                        <StackPanel Spacing="4" HorizontalAlignment="Stretch">

                                            <!-- Completed groups render in an expander; open tasks render directly. -->
                                            <Expander AutomationProperties.AutomationId="CompletedTasks_Expander"
                                                      IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Stretch"
                                                      Padding="4"
                                                      Margin="24,0,24,4"
                                                      CornerRadius="{ThemeResource ControlCornerRadius}"
                                                      Visibility="{x:Bind ShowExpander, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                                <Expander.Resources>
                                                    <StaticResource x:Key="ExpanderHeaderBackground"
                                                                    ResourceKey="SubtleFillColorSecondaryBrush" />
                                                    <StaticResource x:Key="ExpanderHeaderBackgroundPointerOver"
                                                                    ResourceKey="SubtleFillColorTertiaryBrush" />
                                                </Expander.Resources>
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                                Padding="0,16" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                                   FontWeight="SemiBold"
                                                                   Visibility="{x:Bind HasCountLabel, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind CountLabel, Mode=OneWay}"
                                                                   Visibility="{x:Bind HasCountLabel, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Expander.Header>

                                                <StackPanel Spacing="4">
                                                    <ListView AutomationProperties.AutomationId="CompletedTasks_List"
                                                              ItemsSource="{x:Bind VisibleItems, Mode=OneWay}"
                                                              ItemTemplate="{StaticResource TaskItemTemplate}"
                                                              ItemContainerStyle="{StaticResource TaskListViewItemStyle}"
                                                              Margin="0"
                                                              Padding="0, 1"
                                                              CornerRadius="0"
                                                              SelectionMode="Single"
                                                              SelectionChanged="TaskListView_SelectionChanged"
                                                              Loaded="TaskListView_Loaded"
                                                              Unloaded="TaskListView_Unloaded"
                                                              IsTabStop="False"
                                                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                        <ListView.ItemContainerTransitions>
                                                            <TransitionCollection />
                                                        </ListView.ItemContainerTransitions>
                                                    </ListView>
                                                    <Button AutomationProperties.AutomationId="CompletedTasks_ShowMore"
                                                            Content="{x:Bind ShowMoreLabel, Mode=OneWay}"
                                                            Command="{x:Bind ShowMoreCommand}"
                                                            Visibility="{x:Bind ShowMoreVisible, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Center"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                            Padding="12,14" />
                                                </StackPanel>
                                            </Expander>

                                            <!-- Open tasks across every task list. -->
                                            <ListView ItemsSource="{x:Bind Items, Mode=OneWay}"
                                                      ItemTemplate="{StaticResource TaskItemTemplate}"
                                                      ItemContainerStyle="{StaticResource TaskListViewItemStyle}"
                                                      AllowDrop="{x:Bind CanReorderItems, Mode=OneWay}"
                                                      CanDragItems="{x:Bind CanReorderItems, Mode=OneWay}"
                                                      CanReorderItems="{x:Bind CanReorderItems, Mode=OneWay}"
                                                      DragItemsCompleted="MyDayTasks_DragItemsCompleted"
                                                      SelectionMode="Single"
                                                      SelectionChanged="TaskListView_SelectionChanged"
                                                      Loaded="TaskListView_Loaded"
                                                      Unloaded="TaskListView_Unloaded"
                                                      IsTabStop="False"
                                                      Margin="20,0,20,8"
                                                      Visibility="{x:Bind ShowFlatList, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListView.ItemContainerTransitions>
                                                    <TransitionCollection />
                                                </ListView.ItemContainerTransitions>
                                            </ListView>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>


                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Grouped list — Planned view only. Padding insets rows without moving the ScrollBar (it's a margin on ScrollContentPresenter) — keep it near the flat lists' inset or rows misalign. -->
                <ListView Grid.Row="1" x:Name="GroupedListView"
                          AutomationProperties.AutomationId="GroupedListView"
                          SelectionMode="Single"
                          SelectionChanged="TaskListView_SelectionChanged"
                          Loaded="TaskListView_Loaded"
                          Unloaded="TaskListView_Unloaded"
                          Padding="20,0,20,0"
                          ItemTemplate="{StaticResource PlannedAgendaEntryTemplate}"
                          ItemContainerStyleSelector="{StaticResource PlannedAgendaItemStyleSelector}"
                          Visibility="Collapsed">
                    <ListView.Footer>
                        <Border x:Name="TaskListBottomClearance"
                                IsHitTestVisible="False" />
                    </ListView.Footer>
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                </ListView>

                <Grid Grid.Row="1" x:Name="PlannedCalendarLayout" Margin="24,0,24,0"
                      MaxWidth="{StaticResource PageMaxRowWidth}" HorizontalAlignment="Stretch"
                      ColumnSpacing="16" SizeChanged="PlannedCalendarLayout_SizeChanged"
                      Visibility="{x:Bind ViewModel.IsPlannedCalendarVisible, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="PlannedCalendarSidebar" Grid.Column="0" Grid.RowSpan="2"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  IsTabStop="False" Visibility="Collapsed">
                        <ContentControl x:Name="PlannedWideCalendarHost" IsTabStop="False"
                                        HorizontalContentAlignment="Stretch">
                            <CalendarView x:Name="PlannedCalendar" x:Uid="PlannedCalendar"
                                          AutomationProperties.AutomationId="PlannedCalendar"
                                          Width="320" MinWidth="0" SelectionMode="Single"
                                          Background="Transparent" BorderThickness="0"
                                          IsTodayHighlighted="True" NumberOfWeeksInView="6"
                                          SelectedDatesChanged="PlannedCalendar_SelectedDatesChanged"
                                          CalendarViewDayItemChanging="PlannedCalendar_DayItemChanging"
                                          Loaded="PlannedCalendar_Loaded"
                                          ActualThemeChanged="PlannedCalendar_ActualThemeChanged">
                                <CalendarView.Resources>
                                    <Thickness x:Key="CalendarViewWeekDayPadding">0,12</Thickness>
                                </CalendarView.Resources>
                            </CalendarView>
                        </ContentControl>
                    </ScrollViewer>
                    <Grid x:Name="PlannedDayHeader" Grid.Column="1" ColumnSpacing="12" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <Grid>
                                <TextBlock x:Name="PlannedWideDateLabel"
                                           AutomationProperties.AutomationId="PlannedSelectedDate"
                                           Visibility="Collapsed"
                                           Text="{x:Bind ViewModel.PlannedSelectedDateLabel, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextWrapping="WrapWholeWords" />
                                <Button x:Name="PlannedDateButton" x:Uid="PlannedDateButton"
                                        AutomationProperties.AutomationId="PlannedDateButton"
                                        AutomationProperties.Name="{x:Bind ViewModel.PlannedSelectedDateLabel, Mode=OneWay}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Style="{StaticResource SubtleButtonStyle}" Padding="0,4">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE787;" FontSize="16" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind ViewModel.PlannedSelectedDateLabel, Mode=OneWay}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="12" VerticalAlignment="Center" />
                                    </Grid>
                                    <Button.Flyout>
                                        <Flyout x:Name="PlannedDateFlyout" Placement="Bottom"
                                                Opened="PlannedDateFlyout_Opened">
                                            <ContentControl x:Name="PlannedCompactCalendarHost" IsTabStop="False" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.PlannedDayCountLabel, Mode=OneWay}"
                                       AutomationProperties.AutomationId="PlannedDay_Count"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind ViewModel.HasPlannedDayTasks, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                            <Button x:Name="PlannedOverdueButton"
                                    AutomationProperties.AutomationId="PlannedOverdueButton"
                                    Content="{x:Bind ViewModel.PlannedOverdueLabel, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasPlannedCalendarOverdue, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                    Click="PlannedOverdue_Click" />
                            <Button x:Uid="PlannedTodayButton"
                                    AutomationProperties.AutomationId="PlannedTodayButton"
                                    Content="Today" Click="PlannedToday_Click" />
                        </StackPanel>
                    </Grid>
                    <ListView x:Name="PlannedDayList" x:Uid="PlannedDayList" Grid.Column="1" Grid.Row="1"
                              AutomationProperties.AutomationId="PlannedDayList"
                              ItemsSource="{x:Bind ViewModel.PlannedDayTasks, Mode=OneWay}"
                              ItemTemplate="{StaticResource TaskItemTemplate}"
                              ItemContainerStyle="{StaticResource TaskListViewItemStyle}"
                              SelectionMode="Single" Padding="0" HorizontalContentAlignment="Stretch"
                              SelectionChanged="TaskListView_SelectionChanged"
                              Loaded="TaskListView_Loaded" Unloaded="TaskListView_Unloaded"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.Header>
                            <StackPanel x:Name="PlannedMeetingsHeader" Spacing="8" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                <InfoBar IsOpen="{x:Bind CalendarViewModel.HasMessage, Mode=OneWay}" IsClosable="False"
                                         Message="{x:Bind CalendarViewModel.Message, Mode=OneWay}" Severity="Warning" />
                                <TextBlock x:Uid="Calendar_Meetings" AutomationProperties.AutomationId="Planned_Meetings"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind CalendarViewModel.DayHint, Mode=OneWay}" AutomationProperties.AutomationId="Calendar_DayHint"
                                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind CalendarViewModel.IsDayEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{x:Bind CalendarViewModel.DayEvents}" ItemTemplate="{StaticResource MeetingRowTemplate}" />
                                <Expander x:Name="PlannedPastMeetings" x:Uid="Calendar_PastDay" AutomationProperties.AutomationId="Planned_PastMeetings"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          Visibility="{x:Bind CalendarViewModel.HasPastDayEvents, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl ItemsSource="{x:Bind CalendarViewModel.PastDayEvents}" ItemTemplate="{StaticResource MeetingRowTemplate}" />
                                </Expander>
                                <TextBlock x:Uid="Calendar_TasksDue" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
                                <TextBlock x:Name="PlannedDayEmptyState" x:Uid="PlannedDayEmptyText" AutomationProperties.AutomationId="PlannedDay_Empty"
                                           Visibility="{x:Bind ViewModel.IsPlannedDayEmpty, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </ListView.Header>
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.Footer>
                            <Border x:Name="PlannedDayBottomClearance" IsHitTestVisible="False" />
                        </ListView.Footer>
                    </ListView>
                </Grid>

                <Grid Grid.Row="1"
                      Background="Transparent"
                      Visibility="{x:Bind ViewModel.IsLoaded, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}">
                    <ProgressRing x:Uid="TaskList_LoadingRing"
                                  Width="32"
                                  Height="32"
                                  IsActive="True"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                </Grid>

                <InfoBar Grid.Row="1"
                         x:Name="UndoInfoBar"
                         AutomationProperties.AutomationId="UndoInfoBar"
                         IsOpen="{x:Bind ViewModel.IsUndoBarVisible, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.IsUndoBarVisible, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                         Message="{x:Bind ViewModel.UndoMessage, Mode=OneWay}"
                         IsClosable="True"
                         Severity="Informational"
                         Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                         VerticalAlignment="Bottom"
                         Canvas.ZIndex="2"
                         Margin="24,0,24,0"
                         SizeChanged="BottomControls_SizeChanged"
                         MaxWidth="{StaticResource PageMaxRowWidth}" HorizontalAlignment="Stretch"
                         Closed="UndoInfoBar_Closed">
                    <InfoBar.ActionButton>
                        <Button x:Uid="UndoButton"
                                AutomationProperties.AutomationId="UndoButton"
                                Command="{x:Bind ViewModel.UndoLastActionCommand}"
                                Style="{ThemeResource AccentButtonStyle}" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </Grid>
        </Grid>

        <!-- Scrim — overlay mode only; appears behind the pane over the list -->
        <Border x:Name="PaneScrim"
                Grid.Column="0"
                Background="{ThemeResource SmokeFillColorDefaultBrush}"
                Visibility="Collapsed"
                Tapped="PaneScrim_Tapped" />

        <!-- Details pane — slides in from the right; column set in code-behind -->
        <Border x:Name="DetailsPaneRoot"
                Grid.Column="1"
                Width="280"
                Visibility="Collapsed"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                TabFocusNavigation="Cycle"
                KeyDown="DetailsPaneRoot_KeyDown">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DetailsPaneTranslate" X="280" />
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Control strip. Star and close sit above the title rather than beside it:
                     at 280px a heading sharing its line with three controls has ~140px left
                     and wraps to three lines. -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Padding="8,8,8,0">
                    <Button x:Name="PaneStarButton"
                            AutomationProperties.AutomationId="PaneStarButton"
                            AutomationProperties.Name="Mark as important"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Click="PaneStarButton_Click"
                            Padding="8" MinWidth="0">
                        <FontIcon x:Name="PaneStarIcon" Glyph="&#xE734;" FontSize="14" />
                    </Button>
                    <Button x:Name="PaneCloseButton"
                            x:Uid="PaneCloseButton"
                            AutomationProperties.AutomationId="PaneCloseButton"
                            AutomationProperties.Name="Close details"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Click="PaneCloseButton_Click"
                            ToolTipService.ToolTip="Close (Esc)"
                            Padding="8" MinWidth="0">
                        <FontIcon Glyph="&#xE8BB;" FontSize="12" />
                    </Button>
                </StackPanel>

                <!-- The title is the pane's heading, inline and borderless between the
                     completion mark and the sections below — not a labelled field under a
                     "Details" caption that named the type rather than the thing. -->
                <!-- Use the existing gap for the title's inner inset so its text stays aligned. -->
                <Grid Grid.Row="1" Padding="16,0,16,12" ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:PriorityCheckBox x:Name="PaneCompleteCheck"
                              Grid.Column="0"
                              Style="{StaticResource DefaultCheckBoxStyle}"
                              AutomationProperties.AutomationId="PaneCompleteCheck"
                              MinWidth="0" MinHeight="0" Padding="0"
                              VerticalAlignment="Center"
                              Click="PaneCompleteCheck_Click" />

                    <TextBox x:Name="PaneTitleBox"
                             AutomationProperties.AutomationId="PaneTitleBox"
                             x:Uid="PaneTitleBox"
                             Grid.Column="1"
                             PlaceholderText="Task title"
                             FontSize="{ThemeResource SubtitleTextBlockFontSize}"
                             FontWeight="SemiBold"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="8,6"
                             TextWrapping="Wrap"
                             AcceptsReturn="False"
                             HorizontalAlignment="Stretch"
                             TextChanged="PaneTitleBox_TextChanged" />
                </Grid>

                <ScrollViewer x:Name="DetailsPaneScrollViewer"
                              AutomationProperties.AutomationId="DetailsPaneScrollViewer"
                              Grid.Row="2"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="16,0,16,24" Spacing="16">

                        <!-- ── Details ───────────────────────────────────────────────── -->
                        <StackPanel>
                            <TextBlock x:Uid="Pane_DetailsSection" Text="Details"
                                       Style="{StaticResource PaneSectionLabelStyle}" />
                            <Border Style="{StaticResource PaneSectionCardStyle}">
                                <StackPanel>

                                    <!-- Focus — an action on the whole task, so it leads the
                                         section. A chevron because it goes somewhere; every
                                         other row's trailing element is its value. -->
                                    <Button x:Name="PaneFocusRow"
                                            AutomationProperties.AutomationId="PaneFocusRow"
                                            AutomationProperties.Name="Focus on this task"
                                            Style="{ThemeResource SubtleButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="0" CornerRadius="3,3,0,0"
                                            Click="PaneFocusRow_Click">
                                        <Grid Style="{StaticResource PaneRowGridStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE916;"
                                                      Style="{StaticResource PaneRowGlyphStyle}" />
                                            <TextBlock Grid.Column="1" x:Uid="Pane_FocusLabel" Text="Focus"
                                                       Style="{StaticResource PaneRowLabelStyle}" />
                                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                                      VerticalAlignment="Center"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </Grid>
                                    </Button>

                                    <Border Style="{StaticResource PaneRowDividerStyle}" />

                                    <!-- Notes carry their own meaning; the gutter glyph says
                                         "notes" so the row needs no label of its own. -->
                                    <!-- Keep the notes text aligned with its existing icon gutter. -->
                                    <Grid Style="{StaticResource PaneRowGridStyle}"
                                          ColumnSpacing="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0"
                                                  FontFamily="Segoe Fluent Icons"
                                                  Glyph="&#xE70B;"
                                                  Style="{StaticResource PaneRowGlyphStyle}"
                                                  VerticalAlignment="Top" Margin="0,8,0,0" />
                                        <TextBox x:Name="PaneNotesBox"
                                                 x:Uid="PaneNotesBox"
                                                 Grid.Column="1"
                                                 AutomationProperties.AutomationId="PaneNotesBox"
                                                 PlaceholderText="Add notes…"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Padding="8,6"
                                                 MinHeight="100"
                                                 MaxHeight="220"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 HorizontalAlignment="Stretch"
                                                 TextChanged="PaneNotesBox_TextChanged"
                                                 KeyDown="PaneNotesBox_KeyDown" />
                                    </Grid>

                                    <Border Style="{StaticResource PaneRowDividerStyle}" />

                                    <!-- Steps (ADR-0010) — plain data rows; edits route through
                                         MainViewModel, which reassigns TodoItem.Steps to trigger
                                         the save + parent UpdatedAt bump. A header row with no
                                         trailing affordance: it does nothing when clicked, and
                                         the list below it is the value. -->
                                    <StackPanel Padding="12,8" Spacing="8">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" FontFamily="Segoe Fluent Icons" Glyph="&#xE9D5;"
                                                      Style="{StaticResource PaneRowGlyphStyle}" />
                                            <TextBlock Grid.Column="1" x:Uid="Pane_StepsLabel" Text="Steps"
                                                       Style="{StaticResource PaneRowLabelStyle}" />
                                            <TextBlock Grid.Column="2" x:Name="PaneStepsProgress"
                                                       VerticalAlignment="Center"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </Grid>
                                        <ItemsControl x:Name="PaneStepsList">
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:Step">
                                                    <Grid ColumnSpacing="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Checkbox collapsed to its 20px glyph and
                                                             centred; the title field keeps a normal input
                                                             height but with symmetric vertical padding so
                                                             its text line sits on the same centre as the
                                                             glyph and the remove icon (WinUI's TextBox
                                                             top-anchors its text otherwise). Click, not
                                                             Checked/Unchecked, so realizing a completed
                                                             row doesn't re-enter the handler. -->
                                                        <CheckBox Grid.Column="0"
                                                                  AutomationProperties.AutomationId="PaneStepCheck"
                                                                  Tag="{x:Bind}"
                                                                  MinWidth="0" MinHeight="0" Padding="0"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{x:Bind IsCompleted, Mode=OneWay}"
                                                                  Click="PaneStepCheck_Click"
                                                                  AutomationProperties.Name="{x:Bind Title, Mode=OneWay}" />
                                                        <!-- Wraps instead of clipping: a long title stays
                                                             fully readable without a drag-select to scroll
                                                             the box inside the pane ScrollViewer. Enter is caught in
                                                             PaneStepText_KeyDown, so AcceptsReturn is moot. -->
                                                        <TextBox Grid.Column="1"
                                                                 Tag="{x:Bind}"
                                                                 Text="{x:Bind Title, Mode=OneWay}"
                                                                 BorderThickness="0"
                                                                 Background="Transparent"
                                                                 Padding="8,6"
                                                                 MinHeight="32"
                                                                 TextWrapping="Wrap"
                                                                 AcceptsReturn="False"
                                                                 VerticalAlignment="Center"
                                                                 VerticalContentAlignment="Center"
                                                                 Opacity="{x:Bind IsCompleted, Converter={StaticResource BoolToOpacity}, Mode=OneWay}"
                                                                 LostFocus="PaneStepText_LostFocus"
                                                                 KeyDown="PaneStepText_KeyDown" />
                                                        <Button Grid.Column="2"
                                                                Tag="{x:Bind}"
                                                                x:Uid="PaneStepRemove"
                                                                AutomationProperties.Name="Remove step"
                                                                Click="PaneStepRemove_Click"
                                                                Style="{ThemeResource SubtleButtonStyle}"
                                                                VerticalAlignment="Center"
                                                                Padding="6" MinWidth="32" MinHeight="32"
                                                                IsTabStop="False">
                                                            <FontIcon Glyph="&#xE711;"
                                                                      FontSize="10"
                                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBox x:Name="PaneStepInput"
                                                 AutomationProperties.AutomationId="PaneStepInput"
                                                 x:Uid="PaneStepInput"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Padding="8,6"
                                                 MinHeight="32"
                                                 PlaceholderText="Add a step, press Enter"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="False"
                                                 KeyDown="PaneStepInput_KeyDown" />
                                    </StackPanel>

                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Schedule ──────────────────────────────────────────────── -->
                        <StackPanel>
                            <TextBlock x:Uid="Pane_ScheduleSection" Text="Schedule"
                                       Style="{StaticResource PaneSectionLabelStyle}" />
                            <Border Style="{StaticResource PaneSectionCardStyle}">
                                <StackPanel>

                                    <Grid Style="{StaticResource PaneRowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE787;"
                                                  Style="{StaticResource PaneRowGlyphStyle}" />
                                        <TextBlock Grid.Column="1" x:Uid="Pane_DueDateLabel" Text="Due date"
                                                   Style="{StaticResource PaneRowLabelStyle}" />
                                        <CalendarDatePicker Grid.Column="2"
                                                            x:Name="PaneDueDatePicker"
                                                            x:Uid="PaneDueDatePicker"
                                                            AutomationProperties.AutomationId="PaneDueDatePicker"
                                                            AutomationProperties.Name="Due date"
                                                            PlaceholderText="Set date"
                                                            MinWidth="132"
                                                            VerticalAlignment="Center"
                                                            DateChanged="PaneDueDatePicker_DateChanged" />
                                    </Grid>

                                    <Grid Margin="38,0,12,8" ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ToggleButton x:Uid="PaneDuePreset_Today"
                                                      AutomationProperties.AutomationId="PaneDuePreset_Today"
                                                      HorizontalAlignment="Stretch" MinWidth="0" MinHeight="32" FontSize="12" Padding="6,5"
                                                      IsChecked="{x:Bind vm:MainViewModel.IsDueDatePresetSelected(ViewModel.SelectedTaskDueDate, 0), Mode=OneWay}"
                                                      Command="{x:Bind ViewModel.ToggleSelectedTaskDueDatePresetCommand}" CommandParameter="0" />
                                        <ToggleButton Grid.Column="1" x:Uid="PaneDuePreset_Tomorrow"
                                                      AutomationProperties.AutomationId="PaneDuePreset_Tomorrow"
                                                      HorizontalAlignment="Stretch" MinWidth="0" MinHeight="32" FontSize="12" Padding="6,5"
                                                      IsChecked="{x:Bind vm:MainViewModel.IsDueDatePresetSelected(ViewModel.SelectedTaskDueDate, 1), Mode=OneWay}"
                                                      Command="{x:Bind ViewModel.ToggleSelectedTaskDueDatePresetCommand}" CommandParameter="1" />
                                        <ToggleButton Grid.Row="1" x:Uid="PaneDuePreset_Weekend"
                                                      AutomationProperties.AutomationId="PaneDuePreset_Weekend"
                                                      HorizontalAlignment="Stretch" MinWidth="0" MinHeight="32" FontSize="12" Padding="6,5"
                                                      IsChecked="{x:Bind vm:MainViewModel.IsDueDatePresetSelected(ViewModel.SelectedTaskDueDate, 2), Mode=OneWay}"
                                                      Command="{x:Bind ViewModel.ToggleSelectedTaskDueDatePresetCommand}" CommandParameter="2" />
                                        <ToggleButton Grid.Row="1" Grid.Column="1" x:Uid="PaneDuePreset_NextWeek"
                                                      AutomationProperties.AutomationId="PaneDuePreset_NextWeek"
                                                      HorizontalAlignment="Stretch" MinWidth="0" MinHeight="32" FontSize="12" Padding="6,5"
                                                      IsChecked="{x:Bind vm:MainViewModel.IsDueDatePresetSelected(ViewModel.SelectedTaskDueDate, 3), Mode=OneWay}"
                                                      Command="{x:Bind ViewModel.ToggleSelectedTaskDueDatePresetCommand}" CommandParameter="3" />
                                    </Grid>

                                    <Border Style="{StaticResource PaneRowDividerStyle}" />

                                    <Grid Style="{StaticResource PaneRowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE706;"
                                                  Style="{StaticResource PaneRowGlyphStyle}" />
                                        <TextBlock Grid.Column="1" x:Uid="Pane_MyDayLabel" Text="My Day"
                                                   Style="{StaticResource PaneRowLabelStyle}" />
                                        <ToggleSwitch Grid.Column="2"
                                                      x:Name="PaneMyDayToggle"
                                                      x:Uid="PaneMyDayToggle"
                                                      AutomationProperties.AutomationId="PaneMyDayToggle"
                                                      AutomationProperties.Name="My Day"
                                                      OffContent=""
                                                      OnContent=""
                                                      MinWidth="0"
                                                      VerticalAlignment="Center"
                                                      Toggled="PaneMyDayToggle_Toggled" />
                                    </Grid>

                                    <Border Style="{StaticResource PaneRowDividerStyle}" />

                                    <!-- Repeat — only meaningful once a due date is set; the
                                         code-behind disables it until then.
                                         Item order must match the TaskRecurrence enum —
                                         code-behind maps SelectedIndex straight to the enum. -->
                                    <Grid Style="{StaticResource PaneRowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE895;"
                                                  Style="{StaticResource PaneRowGlyphStyle}" />
                                        <TextBlock Grid.Column="1" x:Uid="Pane_RepeatLabel" Text="Repeat"
                                                   Style="{StaticResource PaneRowLabelStyle}" />
                                        <ComboBox Grid.Column="2"
                                                  x:Name="PaneRepeatCombo"
                                                  x:Uid="PaneRepeatCombo"
                                                  AutomationProperties.AutomationId="PaneRepeatCombo"
                                                  AutomationProperties.Name="Repeat"
                                                  MinWidth="132"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="PaneRepeatCombo_SelectionChanged">
                                            <ComboBoxItem x:Uid="RepeatItem_None" Content="Doesn't repeat" />
                                            <ComboBoxItem x:Uid="RepeatItem_Daily" Content="Daily" />
                                            <ComboBoxItem x:Uid="RepeatItem_Weekdays" Content="Weekdays" />
                                            <ComboBoxItem x:Uid="RepeatItem_Weekly" Content="Weekly" />
                                            <ComboBoxItem x:Uid="RepeatItem_Monthly" Content="Monthly" />
                                        </ComboBox>
                                    </Grid>

                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Organize ──────────────────────────────────────────────── -->
                        <StackPanel>
                            <TextBlock x:Uid="Pane_OrganizeSection" Text="Organize"
                                       Style="{StaticResource PaneSectionLabelStyle}" />
                            <Border Style="{StaticResource PaneSectionCardStyle}">
                                <StackPanel>

                                    <!-- Item order must match the TaskPriority enum — code-behind
                                         maps SelectedIndex straight to the enum value. -->
                                    <Grid Style="{StaticResource PaneRowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE7C1;"
                                                  Style="{StaticResource PaneRowGlyphStyle}" />
                                        <TextBlock Grid.Column="1" x:Uid="Pane_PriorityLabel" Text="Priority"
                                                   Style="{StaticResource PaneRowLabelStyle}" />
                                        <ComboBox Grid.Column="2"
                                                  x:Name="PanePriorityCombo"
                                                  x:Uid="PanePriorityCombo"
                                                  AutomationProperties.AutomationId="PanePriorityCombo"
                                                  AutomationProperties.Name="Priority"
                                                  MinWidth="132"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="PanePriorityCombo_SelectionChanged">
                                            <ComboBoxItem x:Uid="PriorityItem_None" Content="None" />
                                            <ComboBoxItem x:Uid="PriorityItem_Low" Content="Low" />
                                            <ComboBoxItem x:Uid="PriorityItem_Medium" Content="Medium" />
                                            <ComboBoxItem x:Uid="PriorityItem_High" Content="High" />
                                        </ComboBox>
                                    </Grid>

                                    <Border Style="{StaticResource PaneRowDividerStyle}" />

                                    <Grid Style="{StaticResource PaneRowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE8B7;"
                                                  Style="{StaticResource PaneRowGlyphStyle}" />
                                        <TextBlock Grid.Column="1" x:Uid="Pane_ListLabel" Text="List"
                                                   Style="{StaticResource PaneRowLabelStyle}" />
                                        <ComboBox Grid.Column="2"
                                                  x:Name="PaneListCombo"
                                                  x:Uid="PaneListCombo"
                                                  AutomationProperties.AutomationId="PaneListCombo"
                                                  AutomationProperties.Name="List"
                                                  MinWidth="132"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="PaneListCombo_SelectionChanged">
                                            <ComboBoxItem x:Uid="PaneListNone" Content="Tasks" />
                                        </ComboBox>
                                    </Grid>

                                    <Border Style="{StaticResource PaneRowDividerStyle}" />

                                    <StackPanel Padding="12,8" Spacing="8">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <PathIcon Grid.Column="0" Width="16" Height="14" VerticalAlignment="Center"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      Data="M6.99194 2.59155C7.04138 2.31986 6.86121 2.05955 6.58953 2.01012C6.31784 1.96068 6.05753 2.14085 6.0081 2.41253L5.53721 5.00049L3.49602 5.00027C3.21988 5.00025 2.996 5.22408 2.99597 5.50022C2.99594 5.77636 3.21978 6.00025 3.49592 6.00027L5.35527 6.00047L4.62751 10.0002L2.49998 10.0003C2.22384 10.0003 1.99999 10.2242 2 10.5003C2.00001 10.7764 2.22388 11.0003 2.50002 11.0003L4.44556 11.0002L4.00694 13.4108C3.95751 13.6825 4.13768 13.9428 4.40936 13.9923C4.68104 14.0417 4.94136 13.8615 4.99079 13.5898L5.46199 11.0001L9.44424 11L9.00532 13.409C8.95582 13.6806 9.13592 13.941 9.40759 13.9905C9.67926 14.04 9.93962 13.8599 9.98912 13.5882L10.4607 10.9999L12.5 10.9999C12.7762 10.9998 13 10.776 13 10.4998C13 10.2237 12.7761 9.99984 12.5 9.99985L10.6429 9.99993L11.3715 6.0011L13.5 6.00132C13.7762 6.00135 14.0001 5.77752 14.0001 5.50137C14.0001 5.22523 13.7763 5.00135 13.5002 5.00132L11.5537 5.00112L11.9926 2.59234C12.0421 2.32067 11.862 2.06031 11.5903 2.01081C11.3186 1.96131 11.0583 2.14142 11.0088 2.41309L10.5373 5.00101L6.55361 5.00059L6.99194 2.59155ZM6.37167 6.00058L10.3551 6.00099L9.62644 9.99997L5.64394 10.0001L6.37167 6.00058Z" />
                                            <TextBlock Grid.Column="1" x:Uid="Pane_TagsLabel" Text="Tags"
                                                       Style="{StaticResource PaneRowLabelStyle}" />
                                        </Grid>
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Disabled"
                                                      HorizontalScrollMode="Auto"
                                                      VerticalScrollMode="Disabled">
                                            <ItemsRepeater x:Name="PaneTagChips">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Orientation="Horizontal" Spacing="6" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="10,0,0,0">
                                                            <StackPanel Orientation="Horizontal" Spacing="4"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind}"
                                                                           VerticalAlignment="Center"
                                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                                <Button Tag="{x:Bind}"
                                                                        x:Uid="PaneTagChipRemove"
                                                                        AutomationProperties.Name="Remove tag"
                                                                        Click="PaneTagChipRemove_Click"
                                                                        Style="{ThemeResource SubtleButtonStyle}"
                                                                        Padding="6"
                                                                        MinWidth="32"
                                                                        MinHeight="32"
                                                                        IsTabStop="False"
                                                                        VerticalAlignment="Center">
                                                                    <FontIcon Glyph="&#xE711;"
                                                                              FontSize="10"
                                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </ScrollViewer>
                                        <TextBox x:Name="PaneTagInput"
                                                 x:Uid="PaneTagInput"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Padding="8,6"
                                                 PlaceholderText="Add a tag, press Enter"
                                                 KeyDown="PaneTagInput_KeyDown" />
                                    </StackPanel>

                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Grid ColumnSpacing="12" RowSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Uid="Pane_CreatedLabel" Text="Created"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="PaneCreatedAtText" Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       AutomationProperties.AutomationId="PaneCreatedAtText"
                                       Text="{x:Bind ViewModel.SelectedTaskCreatedAtText, Mode=OneWay}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.SelectedTaskCreatedAtTooltip, Mode=OneWay}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Row="1" x:Uid="Pane_UpdatedLabel" Text="Last updated"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="PaneUpdatedAtText" Grid.Row="1" Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       AutomationProperties.AutomationId="PaneUpdatedAtText"
                                       Text="{x:Bind ViewModel.SelectedTaskUpdatedAtText, Mode=OneWay}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.SelectedTaskUpdatedAtTooltip, Mode=OneWay}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Grid>

                        <Button x:Uid="Pane_DeleteTask" AutomationProperties.AutomationId="Pane_DeleteTask"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Margin="0,4,0,0"
                                Command="{x:Bind ViewModel.DeleteSelectedTaskCommand}">
                            <Button.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Default">
                                            <StaticResource x:Key="ButtonForeground" ResourceKey="SystemFillColorCriticalBrush" />
                                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SystemFillColorCriticalBrush" />
                                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SystemFillColorCriticalBrush" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="Light">
                                            <StaticResource x:Key="ButtonForeground" ResourceKey="SystemFillColorCriticalBrush" />
                                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SystemFillColorCriticalBrush" />
                                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SystemFillColorCriticalBrush" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="HighContrast">
                                            <StaticResource x:Key="ButtonForeground" ResourceKey="SystemColorButtonTextColorBrush" />
                                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SystemControlHighlightBaseHighBrush" />
                                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SystemControlHighlightBaseHighBrush" />
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                </ResourceDictionary>
                            </Button.Resources>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

    </Grid>
</Page>
