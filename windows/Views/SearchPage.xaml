<Page
    x:Class="Hatch.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Hatch.Models"
    xmlns:converters="using:Hatch.Converters"
    xmlns:vm="using:Hatch.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:BoolToStrikethroughConverter x:Key="BoolToStrikethrough" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacity" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:DueDateToStringConverter x:Key="DueDateToString" />
        <converters:DueDateToChipVisibilityConverter x:Key="DueDateToChipVisibility" />

        <!-- Rounded, hover-highlighted row — simpler than TaskListPage's TaskListViewItemStyle
             since this list has no selection state (SelectionMode="None"), just hover/press. -->
        <Style x:Key="ResultRowStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBackground"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RowBackground.Background"
                                                    Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RowBackground.Background"
                                                    Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0" Padding="16,24,16,12" Spacing="4">
            <TextBlock Text="Search results" Style="{ThemeResource TitleLargeTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.SearchResultsSummary, Mode=OneWay}"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!--
            Deliberately a lighter preview row (no star/tag/date-edit/overflow controls) —
            this page is for browsing and jumping to a result, not editing. Tapping a row
            opens the full details pane back on TaskListPage; only the completion checkbox
            is directly interactive here since it needs no code-behind beyond a data binding.
        -->
        <ListView Grid.Row="1"
                  x:Name="ResultsListView"
                  ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                  SelectionMode="None"
                  ItemContainerStyle="{StaticResource ResultRowStyle}"
                  Padding="16,0,16,16"
                  Visibility="{x:Bind ViewModel.IsSearchEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}">
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:TodoItem">
                    <Grid Tag="{x:Bind}"
                          Padding="16,14"
                          ColumnSpacing="14"
                          Background="Transparent"
                          Tapped="ResultRow_Tapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  IsChecked="{x:Bind IsCompleted, Mode=TwoWay}"
                                  VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"
                                    Opacity="{x:Bind IsCompleted, Converter={StaticResource BoolToOpacity}, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                       TextDecorations="{x:Bind IsCompleted, Converter={StaticResource BoolToStrikethrough}, Mode=OneWay}"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind ListName, Mode=OneWay}"
                                           Visibility="{x:Bind HasListName, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="·"
                                           Visibility="{x:Bind HasListNameToDateSeparator, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Style="{ThemeResource CaptionTextBlockStyle}" />
                                <TextBlock Text="{x:Bind DueDate, Converter={StaticResource DueDateToString}, Mode=OneWay}"
                                           Visibility="{x:Bind DueDate, Converter={StaticResource DueDateToChipVisibility}, Mode=OneWay}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    MaxWidth="280"
                    Visibility="{x:Bind ViewModel.IsSearchEmpty, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
            <Border Width="72" Height="72"
                    CornerRadius="36"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE721;"
                          FontSize="28"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="No matching tasks"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="Try a different title, note, or tag."
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

    </Grid>
</Page>
