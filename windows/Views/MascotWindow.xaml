<Window
    x:Class="Hatch.Views.MascotWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lottie="using:CommunityToolkit.WinUI.Lottie">

    <Grid x:Name="MascotGrid"
          Background="Transparent"
          PointerEntered="OnPointerEntered"
          PointerExited="OnPointerExited"
          PointerPressed="OnPointerPressed"
          PointerMoved="OnPointerMoved"
          PointerReleased="OnPointerReleased"
          Tapped="OnTapped">
        <Grid.Resources>
            <!-- 4-second idle cycle: 2 gentle bobs + 1 blink at 2.8 s -->
            <Storyboard x:Key="IdleAnimation" RepeatBehavior="Forever">

                <DoubleAnimationUsingKeyFrames
                    Storyboard.TargetName="MascotRoot"
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)">
                    <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:1" Value="-5">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:2" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:3" Value="-5">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:4" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>

            </Storyboard>

            <!-- Inactivity fade: full opacity → 0.4 over 2 s (starts after 30 s idle) -->
            <Storyboard x:Key="IdleFadeOut">
                <DoubleAnimation
                    Storyboard.TargetName="MascotGrid"
                    Storyboard.TargetProperty="Opacity"
                    To="0.4" Duration="0:0:2">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Storyboard x:Key="IdleFadeIn">
                <DoubleAnimation
                    Storyboard.TargetName="MascotGrid"
                    Storyboard.TargetProperty="Opacity"
                    To="1.0" Duration="0:0:0.2">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Storyboard x:Key="HoverIn">
                <DoubleAnimation
                    Storyboard.TargetName="MascotGridTransform"
                    Storyboard.TargetProperty="ScaleX"
                    To="1.06" Duration="0:0:0.15">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="MascotGridTransform"
                    Storyboard.TargetProperty="ScaleY"
                    To="1.06" Duration="0:0:0.15">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Storyboard x:Key="HoverOut">
                <DoubleAnimation
                    Storyboard.TargetName="MascotGridTransform"
                    Storyboard.TargetProperty="ScaleX"
                    To="1.0" Duration="0:0:0.2">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="MascotGridTransform"
                    Storyboard.TargetProperty="ScaleY"
                    To="1.0" Duration="0:0:0.2">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

        </Grid.Resources>

        <Grid.ContextFlyout>
            <MenuFlyout ShouldConstrainToRootBounds="False">
                <MenuFlyoutItem x:Uid="Mascot_MenuShowMain" Text="Show Main Window"
                                Command="{x:Bind ViewModel.ShowMainWindowCommand}" />
                <MenuFlyoutItem x:Uid="Mascot_MenuResetPosition" Text="Reset Position"
                                Command="{x:Bind ViewModel.ResetPositionCommand}" />
                <MenuFlyoutItem x:Uid="Mascot_MenuSettings" Text="Mascot Settings&#x2026;"
                                Click="OnMascotSettingsMenuItemClick" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Uid="Mascot_MenuHideFor" Text="Hide for...">
                    <MenuFlyoutItem x:Uid="Mascot_MenuHide1Hour" Text="1 hour"
                                    Command="{x:Bind ViewModel.HideFor1HourCommand}" />
                    <MenuFlyoutItem x:Uid="Mascot_MenuHide3Hours" Text="3 hours"
                                    Command="{x:Bind ViewModel.HideFor3HoursCommand}" />
                    <MenuFlyoutItem x:Uid="Mascot_MenuHideTomorrow" Text="Until tomorrow"
                                    Command="{x:Bind ViewModel.HideUntilTomorrowCommand}" />
                    <MenuFlyoutItem x:Uid="Mascot_MenuHideRestart" Text="Until restart"
                                    Command="{x:Bind ViewModel.HideUntilRestartCommand}" />
                </MenuFlyoutSubItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <!-- Keep mascot hover/wiggle transforms out of the popup coordinate system. -->
        <Grid>
            <Grid.RenderTransform>
                <CompositeTransform x:Name="MascotGridTransform" />
            </Grid.RenderTransform>
        <!-- Lottie player — hidden until a .json file is set in Settings -->
        <AnimatedVisualPlayer x:Name="LottiePlayer"
                              Width="{x:Bind ViewModel.WindowSize, Mode=OneWay}"
                              Height="{x:Bind ViewModel.WindowSize, Mode=OneWay}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              AutoPlay="False"
                              Stretch="Uniform"
                              Visibility="Collapsed" />

        <!--
            Egg mascot — XAML vector shapes + Storyboard idle animation.

            To swap in a Lottie asset, replace the Canvas below with:

                <AnimatedVisualPlayer x:Name="MascotRoot"
                                      Width="120" Height="120"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      AutoPlay="True"
                                      Stretch="Uniform"
                                      Source="{StaticResource YourLottieSource}"/>

            Then remove the Storyboard from Grid.Resources and the
            _idleAnimation field + calls from MascotWindow.xaml.cs.
        -->
        <Viewbox x:Name="MascotRoot"
                 Width="{x:Bind ViewModel.WindowSize, Mode=OneWay}"
                 Height="{x:Bind ViewModel.WindowSize, Mode=OneWay}"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
            <Viewbox.RenderTransform>
                <CompositeTransform />
            </Viewbox.RenderTransform>

            <Canvas Width="100" Height="100">

                <!-- Egg body — matches logo.svg -->
                <Path Data="M50 6 C72 6 88 32 88 58 C88 80 72 94 50 94 C28 94 12 80 12 58 C12 32 28 6 50 6 Z"
                      Fill="#FFD966"
                      Stroke="#1A1A1A"
                      StrokeThickness="3.5"
                      StrokeLineJoin="Round" />

                <Path Data="M14 50 L24 56 L32 48 L42 58 L52 50 L60 60 L70 52 L80 60 L86 54"
                      Fill="Transparent"
                      Stroke="#1A1A1A"
                      StrokeThickness="3.5"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />

                <!-- Paperclip — translated (36,22) to match logo.svg group transform -->
                <Path
                    Data="M4 36 Q4 40 8 40 L20 40 Q24 40 24 36 L24 10 Q24 4 18 4 L10 4 Q4 4 4 10 L4 30 Q4 33 7 33 Q10 33 10 30 L10 14 Q10 11 13 11 L15 11 Q18 11 18 14 L18 30"
                    Fill="Transparent"
                    Stroke="#1A73E8"
                    StrokeThickness="3.2"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round">
                    <Path.RenderTransform>
                        <TranslateTransform X="36" Y="22" />
                    </Path.RenderTransform>
                </Path>

            </Canvas>
        </Viewbox>

        <!-- Startup loading indicator — shown while a Lottie source is decoding -->
        <ProgressRing x:Name="MascotLoadingRing"
                      x:Uid="Mascot_LoadingRing"
                      AutomationProperties.Name="Loading mascot"
                      Width="36" Height="36"
                      IsActive="False"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />

        <Ellipse x:Name="DailyTipIndicator"
                 Width="12" Height="12"
                 Fill="{ThemeResource SystemFillColorSuccessBrush}"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="4,4,4,4"
                 Visibility="Collapsed" />

        </Grid>
        <!-- Focus mode overlay — ShouldConstrainToRootBounds=False lets the popup
             render outside the mascot window bounds. Shaped like a now-playing bar
             (hatch-mobile d9ef4ac): what is running on top, the transport below.
             Sized independently of the mascot; code-behind fits the viewport to the
             monitor work area so the readout and controls remain reachable. -->
        <Popup x:Name="FocusPopup"
               ShouldConstrainToRootBounds="False"
               IsLightDismissEnabled="False"
               Opened="FocusPopup_Opened">
            <ScrollViewer x:Name="FocusPopupViewport"
                          AutomationProperties.AutomationId="FocusMode_Viewport"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
            <Border x:Name="FocusPopupBorder"
                    Padding="12,8"
                    Width="280"
                    CornerRadius="8"
                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                    BorderThickness="1"
                    BackgroundSizing="InnerBorderEdge">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="FocusPopupTranslate"/>
                </Border.RenderTransform>
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               x:Name="FocusTaskTitle"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"/>

                    <Grid Grid.Row="1" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- One lap a minute, not progress toward a total — a count-up
                             stopwatch has no total. The readout beside it carries the
                             same information, so the ring stays out of the a11y tree. -->
                        <ProgressRing Grid.Column="0"
                                      x:Name="FocusMinuteRing"
                                      IsIndeterminate="False"
                                      Width="16" Height="16"
                                      VerticalAlignment="Center"
                                      AutomationProperties.AccessibilityView="Raw"/>

                        <TextBlock Grid.Column="1"
                                   x:Name="FocusElapsedText"
                                   Text="0:00"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,8,0"/>

                        <Button Grid.Column="2"
                                x:Name="FocusPauseButton"
                                AutomationProperties.AutomationId="FocusMode_PauseResume"
                                AutomationProperties.Name="Pause"
                                ToolTipService.ToolTip="Pause"
                                Style="{ThemeResource SubtleButtonStyle}"
                                Width="32" Height="32" Padding="0" MinWidth="0"
                                Click="FocusPauseResume_Click">
                            <FontIcon x:Name="FocusPauseIcon" Glyph="&#xE769;" FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Button>

                        <Button Grid.Column="3"
                                x:Uid="FocusMode_MarkDoneButton"
                                AutomationProperties.AutomationId="FocusMode_MarkDone"
                                AutomationProperties.Name="Mark done"
                                ToolTipService.ToolTip="Mark done"
                                Style="{ThemeResource SubtleButtonStyle}"
                                Width="32" Height="32" Padding="0" MinWidth="0"
                                Click="FocusMarkDone_Click">
                            <FontIcon Glyph="&#xE73E;" FontSize="14"
                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                        </Button>

                        <Button Grid.Column="4"
                                x:Uid="FocusMode_ExitButton"
                                AutomationProperties.AutomationId="FocusMode_Exit"
                                AutomationProperties.Name="Exit focus"
                                ToolTipService.ToolTip="Exit focus"
                                Style="{ThemeResource SubtleButtonStyle}"
                                Width="32" Height="32" Padding="0" MinWidth="0"
                                Click="FocusExit_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
            </ScrollViewer>
        </Popup>

        <Popup x:Name="ProactiveTip"
               ShouldConstrainToRootBounds="False"
               IsLightDismissEnabled="True"
               Opened="ProactiveTip_Opened"
               Closed="ProactiveTip_Closed">
            <ScrollViewer x:Name="ProactiveTipViewport"
                          AutomationProperties.AutomationId="ProactiveTip_Viewport"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Border x:Name="ProactiveTipContent" Width="320" Padding="12"
                        CornerRadius="8"
                        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Button HorizontalAlignment="Right"
                                AutomationProperties.AutomationId="ProactiveTip_Close"
                                AutomationProperties.Name="Dismiss tip"
                                Style="{ThemeResource SubtleButtonStyle}"
                                MinWidth="0" Padding="8"
                                Click="ProactiveTip_CloseClick">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                        <TextBlock x:Name="ProactiveTipText" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="ProactiveTip_Message"
                                   Style="{ThemeResource BodyTextBlockStyle}" />
                        <Button x:Name="ProactiveTipAction" HorizontalAlignment="Stretch"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="ProactiveTip_ActionButtonClick">
                            <TextBlock x:Name="ProactiveTipActionText" TextWrapping="Wrap" />
                        </Button>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Popup>

    </Grid>

</Window>
