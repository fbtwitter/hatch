<Window
    x:Class="Hatch.Views.MascotWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lottie="using:CommunityToolkit.WinUI.Lottie">

    <Grid x:Name="MascotGrid"
          Background="Transparent"
          PointerEntered="OnPointerEntered"
          PointerExited="OnPointerExited"
          PointerPressed="OnPointerPressed"
          PointerMoved="OnPointerMoved"
          PointerReleased="OnPointerReleased"
          PointerCanceled="OnPointerCaptureLost"
          PointerCaptureLost="OnPointerCaptureLost"
          Tapped="OnTapped">
        <Grid.Resources>

            <!-- Inactivity fade: full opacity → 0.4 over 2 s (starts after 30 s idle) -->
            <Storyboard x:Key="IdleFadeOut">
                <DoubleAnimation
                    Storyboard.TargetName="MascotGrid"
                    Storyboard.TargetProperty="Opacity"
                    To="0.4" Duration="0:0:2">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Storyboard x:Key="IdleFadeIn">
                <DoubleAnimation
                    Storyboard.TargetName="MascotGrid"
                    Storyboard.TargetProperty="Opacity"
                    To="1.0" Duration="0:0:0.2">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Storyboard x:Key="HoverIn">
                <DoubleAnimation
                    Storyboard.TargetName="MascotGridTransform"
                    Storyboard.TargetProperty="ScaleX"
                    To="1.06" Duration="0:0:0.15">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="MascotGridTransform"
                    Storyboard.TargetProperty="ScaleY"
                    To="1.06" Duration="0:0:0.15">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Storyboard x:Key="HoverOut">
                <DoubleAnimation
                    Storyboard.TargetName="MascotGridTransform"
                    Storyboard.TargetProperty="ScaleX"
                    To="1.0" Duration="0:0:0.2">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="MascotGridTransform"
                    Storyboard.TargetProperty="ScaleY"
                    To="1.0" Duration="0:0:0.2">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

        </Grid.Resources>

        <Grid.ContextFlyout>
            <MenuFlyout ShouldConstrainToRootBounds="False">
                <MenuFlyoutItem x:Uid="Mascot_MenuShowMain" Text="Show Main Window"
                                Command="{x:Bind ViewModel.ShowMainWindowCommand}" />
                <MenuFlyoutItem x:Uid="Mascot_MenuResetPosition" Text="Reset Position"
                                Command="{x:Bind ViewModel.ResetPositionCommand}" />
                <MenuFlyoutItem x:Uid="Mascot_MenuSettings" Text="Mascot Settings&#x2026;"
                                Click="OnMascotSettingsMenuItemClick" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Uid="Mascot_MenuHideFor" Text="Hide for...">
                    <MenuFlyoutItem x:Uid="Mascot_MenuHide1Hour" Text="1 hour"
                                    Command="{x:Bind ViewModel.HideFor1HourCommand}" />
                    <MenuFlyoutItem x:Uid="Mascot_MenuHide3Hours" Text="3 hours"
                                    Command="{x:Bind ViewModel.HideFor3HoursCommand}" />
                    <MenuFlyoutItem x:Uid="Mascot_MenuHideTomorrow" Text="Until tomorrow"
                                    Command="{x:Bind ViewModel.HideUntilTomorrowCommand}" />
                    <MenuFlyoutItem x:Uid="Mascot_MenuHideRestart" Text="Until restart"
                                    Command="{x:Bind ViewModel.HideUntilRestartCommand}" />
                </MenuFlyoutSubItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <!-- Fit physical window bounds at any DPI; reserve room for hover and wiggle. -->
        <Viewbox Stretch="Uniform">
            <Grid Width="120" Height="120">
                <Grid Margin="12" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <CompositeTransform x:Name="MascotGridTransform" />
                    </Grid.RenderTransform>
                    <!-- Native Lottie mascot, with an optional custom JSON override. -->
                    <AnimatedVisualPlayer x:Name="LottiePlayer"
                                          AutoPlay="False"
                                          Stretch="Uniform"
                                          Visibility="Collapsed" />

                    <!-- Startup loading indicator — shown while a Lottie source is decoding -->
                    <ProgressRing x:Name="MascotLoadingRing"
                                  x:Uid="Mascot_LoadingRing"
                                  AutomationProperties.Name="Loading mascot"
                                  Width="36" Height="36"
                                  IsActive="False"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />

                    <Border x:Name="PendingTipIndicator" Width="18" Height="18"
                            AutomationProperties.AutomationId="Mascot_PendingTipIndicator"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,5,5,0" CornerRadius="9"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" Visibility="Collapsed"
                            IsHitTestVisible="False"
                            AutomationProperties.Name="A tip is waiting in Quick Add">
                        <TextBlock Text="!" FontSize="11" FontWeight="Bold"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Grid>
        </Viewbox>
        <!-- Focus mode overlay — ShouldConstrainToRootBounds=False lets the popup
             render outside the mascot window bounds. Shaped like a now-playing bar
             (hatch-mobile d9ef4ac): what is running on top, the transport below.
             Sized independently of the mascot; code-behind fits the viewport to the
             monitor work area so the readout and controls remain reachable. -->
        <Popup x:Name="FocusPopup"
               ShouldConstrainToRootBounds="False"
               IsLightDismissEnabled="False"
               Opened="FocusPopup_Opened">
            <ScrollViewer x:Name="FocusPopupViewport"
                          AutomationProperties.AutomationId="FocusMode_Viewport"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
            <Border x:Name="FocusPopupBorder"
                    Padding="12,8"
                    Width="280"
                    CornerRadius="8"
                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                    BorderThickness="1"
                    BackgroundSizing="InnerBorderEdge">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="FocusPopupTranslate"/>
                </Border.RenderTransform>
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               x:Name="FocusTaskTitle"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"/>

                    <Grid Grid.Row="1" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- One lap a minute, not progress toward a total — a count-up
                             stopwatch has no total. The readout beside it carries the
                             same information, so the ring stays out of the a11y tree. -->
                        <ProgressRing Grid.Column="0"
                                      x:Name="FocusMinuteRing"
                                      IsIndeterminate="False"
                                      Width="16" Height="16"
                                      VerticalAlignment="Center"
                                      AutomationProperties.AccessibilityView="Raw"/>

                        <TextBlock Grid.Column="1"
                                   x:Name="FocusElapsedText"
                                   Text="0:00"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,8,0"/>

                        <Button Grid.Column="2"
                                x:Name="FocusPauseButton"
                                AutomationProperties.AutomationId="FocusMode_PauseResume"
                                AutomationProperties.Name="Pause"
                                ToolTipService.ToolTip="Pause"
                                Style="{ThemeResource SubtleButtonStyle}"
                                Width="32" Height="32" Padding="0" MinWidth="0"
                                Click="FocusPauseResume_Click">
                            <FontIcon x:Name="FocusPauseIcon" Glyph="&#xE769;" FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Button>

                        <Button Grid.Column="3"
                                x:Uid="FocusMode_MarkDoneButton"
                                AutomationProperties.AutomationId="FocusMode_MarkDone"
                                AutomationProperties.Name="Mark done"
                                ToolTipService.ToolTip="Mark done"
                                Style="{ThemeResource SubtleButtonStyle}"
                                Width="32" Height="32" Padding="0" MinWidth="0"
                                Click="FocusMarkDone_Click">
                            <FontIcon Glyph="&#xE73E;" FontSize="14"
                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                        </Button>

                        <Button Grid.Column="4"
                                x:Uid="FocusMode_ExitButton"
                                AutomationProperties.AutomationId="FocusMode_Exit"
                                AutomationProperties.Name="Exit focus"
                                ToolTipService.ToolTip="Exit focus"
                                Style="{ThemeResource SubtleButtonStyle}"
                                Width="32" Height="32" Padding="0" MinWidth="0"
                                Click="FocusExit_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
            </ScrollViewer>
        </Popup>

        <Popup x:Name="ProactiveTip"
               ShouldConstrainToRootBounds="False"
               IsLightDismissEnabled="True"
               Opened="ProactiveTip_Opened"
               Closed="ProactiveTip_Closed">
            <ScrollViewer x:Name="ProactiveTipViewport"
                          AutomationProperties.AutomationId="ProactiveTip_Viewport"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Border x:Name="ProactiveTipContent" Width="308"
                        Padding="12,12,12,20"
                        PointerEntered="ProactiveTip_PointerEntered"
                        PointerExited="ProactiveTip_PointerExited"
                        GotFocus="ProactiveTip_GotFocus"
                        LostFocus="ProactiveTip_LostFocus"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                        BorderThickness="1">
                    <Grid RowSpacing="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="ProactiveTipCategoryIcon" Grid.Column="0" FontSize="16" Margin="0,0,8,0"
                                      AutomationProperties.AutomationId="ProactiveTip_CategoryIcon"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock x:Name="ProactiveTipCategoryHeading" Grid.Column="1"
                                       AutomationProperties.AutomationId="ProactiveTip_Title"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button x:Name="ProactiveTipOptionsButton" Grid.Column="2" x:Uid="Tip_OptionsButton"
                                    Margin="0,0,4,0"
                                    AutomationProperties.AutomationId="ProactiveTip_Options"
                                    AutomationProperties.Name="Tip options"
                                    ToolTipService.ToolTip="Tip options"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    Width="32" Height="32" MinWidth="0" Padding="0"
                                    Opacity="0">
                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight"
                                                Opened="TipOptionsFlyout_Opened"
                                                Closed="TipOptionsFlyout_Closed"
                                                ShouldConstrainToRootBounds="False">
                                        <MenuFlyoutItem x:Uid="Tip_MenuHideToday"
                                                        Text="Hide tips for today"
                                                        Click="TipMenuHideToday_Click" />
                                        <MenuFlyoutItem x:Uid="Tip_MenuTurnOff"
                                                        Text="Turn off Quick Tips"
                                                        Click="TipMenuTurnOff_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="ProactiveTipCloseButton" Grid.Column="3"
                                    AutomationProperties.AutomationId="ProactiveTip_Close"
                                    AutomationProperties.Name="Dismiss tip"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    Width="32" Height="32" MinWidth="0" Padding="0"
                                    Opacity="0"
                                    Click="ProactiveTip_CloseClick">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </Grid>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="10">
                            <TextBlock x:Name="ProactiveTipText"
                                       TextWrapping="Wrap" VerticalAlignment="Top"
                                       AutomationProperties.AutomationId="ProactiveTip_Message"
                                       Style="{ThemeResource BodyTextBlockStyle}" />
                            <Grid x:Name="ProactiveTipActionContainer" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ProactiveTipAction"
                                        AutomationProperties.AutomationId="ProactiveTip_Action"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Padding="12,6"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Click="ProactiveTip_ActionButtonClick">
                                    <TextBlock x:Name="ProactiveTipActionText" TextWrapping="Wrap" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Popup>

    </Grid>

</Window>
