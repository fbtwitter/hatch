<UserControl
    x:Class="Hatch.Controls.CalendarSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Hatch.ViewModels"
    xmlns:converters="using:Hatch.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="CalendarSettingsCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="MinHeight" Value="64" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="8" AutomationProperties.AutomationId="Settings_CalendarsPanel">
        <Border Style="{StaticResource CalendarSettingsCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE787;" FontSize="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,12,16,12">
                    <TextBlock x:Uid="Calendar_ImportHeading" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="Calendar_ImportDescription" Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2" x:Uid="Calendar_Import" AutomationProperties.AutomationId="Calendar_Import"
                        Command="{x:Bind ViewModel.ImportCommand, Mode=OneWay}" MinWidth="108"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TextBlock AutomationProperties.AutomationId="Calendar_Status" Text="{x:Bind ViewModel.StatusLabel, Mode=OneWay}"
                   TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="56,0,0,0"
                   Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

        <InfoBar IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}" IsClosable="False"
                 Message="{x:Bind ViewModel.Message, Mode=OneWay}" Severity="Warning" />

        <Button x:Uid="Calendar_Cancel" AutomationProperties.AutomationId="Calendar_AccountCancel"
                Command="{x:Bind ViewModel.CancelConnectCommand, Mode=OneWay}"
                HorizontalAlignment="Right"
                Visibility="{x:Bind ViewModel.IsConnecting, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock x:Uid="Calendar_AccountTitle" Style="{ThemeResource BodyStrongTextBlockStyle}"
                   Margin="0,8,0,0" />

        <Border Style="{StaticResource CalendarSettingsCardStyle}" Padding="0">
            <StackPanel>
                <Grid ColumnSpacing="16" Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Uid="Calendar_ProviderMicrosoftLabel" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Uid="Calendar_MicrosoftUnavailable" TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind ViewModel.IsMicrosoftUnavailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Uid="Calendar_Connect" AutomationProperties.AutomationId="Calendar_Connect"
                            Command="{x:Bind ViewModel.ConnectCommand, Mode=OneWay}" MinWidth="136"
                            VerticalAlignment="Center" />
                </Grid>

                <Border Height="1" Margin="16,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Grid ColumnSpacing="16" Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Uid="Calendar_ProviderGoogleLabel" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Uid="Calendar_GoogleUnavailable" TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind ViewModel.IsGoogleUnavailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Uid="Calendar_ConnectGoogle" AutomationProperties.AutomationId="Calendar_ConnectGoogle"
                            Command="{x:Bind ViewModel.GoogleConnectCommand, Mode=OneWay}" MinWidth="136"
                            VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid ColumnSpacing="8" Margin="0,8,0,0"
              Visibility="{x:Bind ViewModel.HasAccounts, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="Calendar_ConnectedAccounts" Style="{ThemeResource BodyStrongTextBlockStyle}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Uid="Calendar_RefreshAction" AutomationProperties.AutomationId="Calendar_Refresh"
                    Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasOnlineAccounts, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <ItemsControl ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CalendarAccountRow">
                    <Border Style="{StaticResource CalendarSettingsCardStyle}" Padding="16"
                            Margin="0,0,0,8">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE787;" FontSize="16" VerticalAlignment="Top" Margin="0,4,4,0" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ProviderName, Mode=OneTime}"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Email, Mode=OneTime}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Status, Mode=OneTime}" TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" Padding="8"
                                    VerticalAlignment="Top" MinWidth="32" MinHeight="32"
                                    AutomationProperties.AutomationId="{x:Bind OptionsAutomationId, Mode=OneTime}"
                                    AutomationProperties.Name="{x:Bind OptionsName, Mode=OneTime}"
                                    ToolTipService.ToolTip="{x:Bind OptionsName, Mode=OneTime}">
                                <FontIcon Glyph="&#xE712;" FontSize="16"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem x:Uid="Calendar_ReplaceImport"
                                                        AutomationProperties.AutomationId="{x:Bind ReplaceAutomationId, Mode=OneTime}"
                                                        Command="{x:Bind ReplaceCommand}"
                                                        Visibility="{x:Bind IsImported, Mode=OneTime, Converter={StaticResource BoolToVisibility}}" />
                                        <MenuFlyoutItem Text="{x:Bind RemoveLabel, Mode=OneTime}"
                                                        AutomationProperties.AutomationId="{x:Bind DisconnectAutomationId, Mode=OneTime}"
                                                        Command="{x:Bind DisconnectCommand}"
                                                        AutomationProperties.Name="{x:Bind DisconnectName, Mode=OneTime}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Style="{StaticResource CalendarSettingsCardStyle}" Padding="8,0">
            <Expander x:Uid="Calendar_ReminderDetails" AutomationProperties.AutomationId="Calendar_ReminderDetails"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8" Padding="8,8,8,16">
                    <TextBlock x:Uid="Calendar_ReminderLimits" AutomationProperties.AutomationId="Calendar_ReminderLimits"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.RangeLabel, Mode=OneWay}" TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Expander>
        </Border>

        <Grid ColumnSpacing="8" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE72E;" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1" x:Uid="Calendar_AccountPrivacy" TextWrapping="Wrap"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </StackPanel>
</UserControl>
