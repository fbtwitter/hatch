<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately plain net10.0, not net10.0-windows10.0.19041.0 — this project must stay
    free of any WinUI/WindowsAppSDK dependency so it builds and runs fast on any CI runner
    with just the .NET SDK. Source files are linked directly (no ProjectReference to
    hatch.csproj) for the same reason: only Models/Helpers/Services with zero WinUI usings
    may be added here. See context/current-feature.md for the CI rationale.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hatch.Tests.Unit</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.3.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Models\TodoItem.cs" Link="Source\Models\TodoItem.cs" />
    <Compile Include="..\Models\TaskList.cs" Link="Source\Models\TaskList.cs" />
    <Compile Include="..\Models\TasksFile.cs" Link="Source\Models\TasksFile.cs" />
    <Compile Include="..\Models\TaskRecurrence.cs" Link="Source\Models\TaskRecurrence.cs" />
    <Compile Include="..\Models\TaskPriority.cs" Link="Source\Models\TaskPriority.cs" />
    <Compile Include="..\Models\Tip.cs" Link="Source\Models\Tip.cs" />
    <Compile Include="..\Models\AppSettings.cs" Link="Source\Models\AppSettings.cs" />
    <Compile Include="..\Helpers\TipSchedule.cs" Link="Source\Helpers\TipSchedule.cs" />
    <Compile Include="..\Helpers\RecurrenceHelper.cs" Link="Source\Helpers\RecurrenceHelper.cs" />
    <Compile Include="..\Helpers\TaskSorting.cs" Link="Source\Helpers\TaskSorting.cs" />
    <Compile Include="..\Helpers\SummaryStats.cs" Link="Source\Helpers\SummaryStats.cs" />
    <Compile Include="..\Helpers\TaskSearchMatcher.cs" Link="Source\Helpers\TaskSearchMatcher.cs" />
    <Compile Include="..\Helpers\TaskExportFormatter.cs" Link="Source\Helpers\TaskExportFormatter.cs" />
    <Compile Include="..\Services\TipEngine.cs" Link="Source\Services\TipEngine.cs" />
    <Compile Include="..\Services\SyncCrypto.cs" Link="Source\Services\SyncCrypto.cs" />
    <Compile Include="..\Services\SyncWire.cs" Link="Source\Services\SyncWire.cs" />
    <Compile Include="..\Services\SyncMerge.cs" Link="Source\Services\SyncMerge.cs" />
    <Compile Include="..\Services\SyncDecisions.cs" Link="Source\Services\SyncDecisions.cs" />
    <Compile Include="..\Helpers\RecoveryKit.cs" Link="Source\Helpers\RecoveryKit.cs" />
    <Compile Include="..\Helpers\MascotOpenPageHelper.cs" Link="Source\Helpers\MascotOpenPageHelper.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures\tasks-golden.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
