<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately plain net10.0, not net10.0-windows10.0.19041.0 — this project must stay
    free of any WinUI/WindowsAppSDK dependency so it builds and runs fast on any CI runner
    with just the .NET SDK. Hatch.Core is referenced as a plain .NET project; selected
    Windows-only pure helpers remain linked directly instead of referencing hatch.csproj.
    See context/current-feature.md for the CI rationale.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hatch.Tests.Unit</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.3.3" />
  </ItemGroup>

