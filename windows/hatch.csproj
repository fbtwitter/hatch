<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Hatch</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <EnableXamlDiagnostics>false</EnableXamlDiagnostics>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);CsWinRT1028</WarningsAsErrors>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <Platforms>x64;x86;arm64</Platforms>
    <!-- Keep in sync with Package.appxmanifest's Identity Version and the release tag.
         Packaged builds read the manifest; unpackaged Debug builds have no package
         identity and fall back to this via SettingsViewModel.AppVersion. -->
    <Version>0.35.10</Version>
    <!-- Signing and package generation are handled by CI; disabled locally -->
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
  </PropertyGroup>

  <!-- Debug: unpackaged so XAML Hot Reload works without deploying MSIX.
       Uses the system-installed Windows App SDK runtime via the SDK's built-in
       bootstrapper auto-initializer (WindowsAppRuntimeAutoInitializer.cs).
       Do NOT use WindowsAppSDKSelfContained here — it conflicts with the
       bootstrapper flow and causes 0x80040154 Class not registered at startup. -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <WindowsPackageType>None</WindowsPackageType>
        <WindowsAppSDKDeploymentManagerInitialize>false</WindowsAppSDKDeploymentManagerInitialize>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>

  <!-- Release: packaged MSIX for distribution.
       WindowsAppSDKSelfContained bundles the Windows App SDK runtime inside the MSIX
       so users don't need to install it separately (fixes 0x8007007E on sideload). -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Package the published native payload; ordinary builds remain the JIT development path. -->
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <PublishAppxPackage>true</PublishAppxPackage>
    <IncludePublishItemsOutputGroup>true</IncludePublishItemsOutputGroup>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <!-- x86 apphost is not available in the CI .NET 10 SDK; MSIX packaging is skipped for x86 -->
  <PropertyGroup Condition="'$(Configuration)'=='Release' And '$(Platform)'=='x86'">
    <UseAppHost>false</UseAppHost>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
  </PropertyGroup>

  <!-- Exclude sub-projects from the main project's compile glob -->
  <ItemGroup>
    <Compile Remove="scripts\AssetGen\**" />
    <None Remove="scripts\AssetGen\**" />
    <Compile Remove="Hatch.Tests\**" />
    <None Remove="Hatch.Tests\**" />
    <Compile Remove="Hatch.Tests.Unit\**" />
    <None Remove="Hatch.Tests.Unit\**" />
    <Compile Remove="Hatch.Tests.Integration\**" />
    <None Remove="Hatch.Tests.Integration\**" />
    <Compile Remove="Hatch.Core\**" />
    <None Remove="Hatch.Core\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinUIAnalyzer" Version="0.7.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <ProjectReference Include="Hatch.Core\Hatch.Core.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
    <!-- Hatch has no AI/ML feature. The metapackage pulls in Microsoft.WindowsAppSDK.ML
         transitively, which carries onnxruntime.dll + DirectML.dll for x64/arm64/arm64ec
         (~120MB combined, unused) — excluded here rather than dropped from the metapackage
         reference, so the rest of the WinUI build pipeline (WinUI/Foundation/
         InteractiveExperiences/etc., all wired up by the metapackage's own targets) stays
         untouched. Confirmed via `Get-Process -Id ... | Modules` that these DLLs were never
         actually loaded at runtime even before this change — this trims install size only. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.6.4" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.4.89" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" PrivateAssets="all" />
    <!-- Required: MSIX build tasks were compiled against .NET 8 and probe for this assembly at build time -->
    <PackageReference Include="System.Security.Permissions" Version="10.0.10" />
    <PackageReference Include="WinUIEx" Version="2.9.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Lottie" Version="8.2.250604" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>

  <!-- Optional local provider configuration; release builds can supply MSBuild properties. -->
  <Import Project="..\.dev-tools\calendar.local.props" Condition="Exists('..\.dev-tools\calendar.local.props')" />

  <ItemGroup>
    <AssemblyMetadata Include="HatchCalendarClientId" Value="$(HatchCalendarClientId)" />
    <AssemblyMetadata Include="HatchGoogleCalendarClientId" Value="$(HatchGoogleCalendarClientId)" />
    <AssemblyMetadata Include="HatchGoogleCalendarClientSecret" Value="$(HatchGoogleCalendarClientSecret)" />
  </ItemGroup>

  <!-- Generate package icons when their vector sources or renderer change.
       logo.svg lives at the repo root (shared with mobile/ and README.md), not under
       windows/ — everything else this target touches (AssetGen.csproj, the Assets
       output dir) stays windows-local. -->
  <Target Name="EnsureAssets" BeforeTargets="PrepareForBuild"
          Inputs="$(MSBuildProjectDirectory)\..\assets\logo.svg;$(MSBuildProjectDirectory)\..\assets\widget-preview.svg;$(MSBuildProjectDirectory)\scripts\AssetGen\Program.cs;$(MSBuildProjectDirectory)\scripts\AssetGen\AssetGen.csproj"
          Outputs="$(MSBuildProjectDirectory)\Assets\Hatch.ico;$(MSBuildProjectDirectory)\Assets\HatchHidden.ico;$(MSBuildProjectDirectory)\Assets\MyDayWidgetPreview.png;$(MSBuildProjectDirectory)\Assets\Square150x150Logo.png;$(MSBuildProjectDirectory)\Assets\Square44x44Logo.png;$(MSBuildProjectDirectory)\Assets\StoreLogo.png;$(MSBuildProjectDirectory)\Assets\SplashScreen.png">
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)\scripts\AssetGen\AssetGen.csproj&quot; -- &quot;$(MSBuildProjectDirectory)\..\assets\logo.svg&quot; &quot;$(MSBuildProjectDirectory)\Assets&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="..\assets\logo.svg" LogicalName="HatchLogo.svg" />
    <Content Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <ApplicationIcon Include="Assets\Hatch.ico" Condition="Exists('Assets\Hatch.ico')"/>
    <Content Include="Assets\Hatch.ico" Condition="Exists('Assets\Hatch.ico')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\HatchHidden.ico" Condition="Exists('Assets\HatchHidden.ico')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\MyDayWidgetPreview.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Remove="bug.png" />
  </ItemGroup>

</Project>
