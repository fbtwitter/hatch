<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap5 com rescap">

  <Identity
    Name="RezaFauziAugusdi.HatchAlways-OnTo-Do"
    Publisher="CN=9D1F8C40-115A-44D9-94E5-BA0ECC194C4C"
    Version="0.25.5.0" />

  <Properties>
    <DisplayName>Hatch: Always-On To-Do</DisplayName>
    <PublisherDisplayName>Reza Fauzi Augusdi</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Hatch"
        Description="Your tasks, always one click away. Hatch lives on your desktop as a friendly mascot — capture a to-do in under 4 seconds, from anywhere. Built with WinUI 3 for a native Windows feel. No account. No cloud. Totally private."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#FFFFFF" />
      </uap:VisualElements>
      <Extensions>
        <uap5:Extension Category="windows.startupTask">
          <uap5:StartupTask TaskId="HatchStartup" Enabled="false" DisplayName="Hatch"/>
        </uap5:Extension>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="hatch">
            <uap:DisplayName>Hatch</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="$targetnametoken$.exe" Arguments="-RegisterProcessAsComServer" DisplayName="Hatch My Day Widget Provider">
              <com:Class Id="8F0AEEA3-75D7-4B2C-8BF0-4238E0042B16" DisplayName="Hatch My Day Widget" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.windows.widgets" Id="Hatch" DisplayName="Hatch" PublicFolder="Assets">
            <uap3:Properties>
              <WidgetProvider>
                <ProviderIcons>
                  <Icon Path="Assets\StoreLogo.png" />
                </ProviderIcons>
                <Activation>
                  <CreateInstance ClassId="8F0AEEA3-75D7-4B2C-8BF0-4238E0042B16" />
                </Activation>
                <Definitions>
                  <Definition Id="Hatch_MyDay" DisplayName="My Day" Description="Your tasks for today, with quick actions to open or complete them.">
                    <Capabilities>
                      <Capability><Size Name="small" /></Capability>
                      <Capability><Size Name="medium" /></Capability>
                      <Capability><Size Name="large" /></Capability>
                    </Capabilities>
                    <ThemeResources>
                      <Icons><Icon Path="Assets\StoreLogo.png" /></Icons>
                      <Screenshots><Screenshot Path="Assets\MyDayWidgetPreview.png" DisplayAltText="My Day widget showing today's tasks and progress" /></Screenshots>
                    </ThemeResources>
                  </Definition>
                </Definitions>
              </WidgetProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>

</Package>
