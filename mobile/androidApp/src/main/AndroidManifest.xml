<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Due-date reminders are scheduled on-device from the last decrypted pull
         (docs/adr/0002). Runtime-granted from Android 13; refusing it costs reminders
         and nothing else. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- enableOnBackInvokedCallback: predictive back (Android 13+, default-on from 16).
         Compose's sheets, drawer and dialogs animate with the gesture once it is declared;
         older releases ignore the attribute. -->
    <application
        android:allowBackup="false"
        android:label="Hatch"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Hatch">

        <!-- singleTop so the OAuth redirect returns to the running instance via
             onNewIntent instead of stacking a second copy of the activity.
             Theme.Hatch.Starting is the splash shell; installSplashScreen() swaps to the
             real Theme.Hatch before the first frame. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Hatch.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Kept as a separate filter from LAUNCHER on purpose: merging them makes the
                 activity launchable by any VIEW intent matching the categories. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hatch" android:host="auth-callback" />
            </intent-filter>
        </activity>
    </application>

</manifest>
