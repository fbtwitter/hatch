<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately not Theme.Material3.* — that lives in com.google.android.material, which a
  Compose-only app does not otherwise need. Compose does the real theming; this platform
  theme only has to be a sane no-action-bar shell. values-night/ supplies the dark variant.

  forceDarkAllowed=false because MIUI applies force-dark to this app (visible in logcat as
  ForceDarkHelper), which inverts Material3's onPrimary and leaves near-white text on the
  light-lavender primary button. We already supply a proper dark scheme, so the OS must not
  second-guess it.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Hatch" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>
</resources>
