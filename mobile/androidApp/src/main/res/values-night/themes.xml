<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Hatch" parent="android:Theme.Material.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>

    <!-- BrandDark.surface, for the same no-flash reason as the light variant. -->
    <style name="Theme.Hatch.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1A1C1E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Hatch</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>
</resources>
