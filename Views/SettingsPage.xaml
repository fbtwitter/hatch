<Page
    x:Class="Hatch.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:Hatch.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <x:Double x:Key="SettingsCardSpacing">8</x:Double>
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="0,24,0,8"/>
            </Style.Setters>
        </Style>

        <!--
            Toggle card: flexible left column so the toggle always stays on the right.
            SettingsCard's built-in responsive wrap moves content below at narrow widths,
            so toggle-only rows use this custom layout instead.
        -->
        <Style x:Key="ToggleCardBorderStyle" TargetType="Border">
            <Style.Setters>
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="MinHeight" Value="64"/>
            </Style.Setters>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" Padding="16,24,16,8" x:Name="HeaderText" Text="Settings"
                   Style="{ThemeResource TitleLargeTextBlockStyle}"
                   VerticalAlignment="Center"/>

        <!-- Settings list -->
        <ScrollViewer Grid.Row="1" Padding="24,0,24,24" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="{StaticResource SettingsCardSpacing}">

                <!-- ── Appearance & behavior ────────────────────────── -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                           Text="Appearance &amp; behavior"/>

                <!-- Minimize to Tray — custom toggle card -->
                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8BD;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock Text="Minimize to System Tray"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Keep running in the background when closed"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="WrapWholeWords"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      AutomationProperties.AutomationId="Settings_MinimizeToTray"
                                      AutomationProperties.Name="Minimize to System Tray"
                                      IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}"
                                      OnContent="On" OffContent="Off" MinWidth="80"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Run at Startup — custom toggle card -->
                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE896;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock Text="Run at startup"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Hatch will launch automatically"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="WrapWholeWords"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      AutomationProperties.AutomationId="Settings_RunAtStartup"
                                      AutomationProperties.Name="Run at startup"
                                      IsOn="{x:Bind ViewModel.RunAtStartup, Mode=TwoWay}"
                                      OnContent="On" OffContent="Off" MinWidth="80"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- App Theme -->
                <toolkit:SettingsCard
                    Header="App Theme"
                    Description="Choose your preferred color scheme">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;"/>
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox AutomationProperties.AutomationId="Settings_ThemeComboBox"
                              AutomationProperties.Name="App Theme"
                              SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" MinWidth="155">
                        <ComboBoxItem Content="System Default"/>
                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="Dark"/>
                    </ComboBox>
                </toolkit:SettingsCard>

                <!-- Window Backdrop -->
                <toolkit:SettingsCard
                    Header="Window Backdrop"
                    Description="Background material effect for the main window">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE771;"/>
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox AutomationProperties.AutomationId="Settings_BackdropComboBox"
                              AutomationProperties.Name="Window Backdrop"
                              SelectedIndex="{x:Bind ViewModel.BackdropIndex, Mode=TwoWay}" MinWidth="165">
                        <ComboBoxItem Content="None"/>
                        <ComboBoxItem Content="Mica"/>
                        <ComboBoxItem Content="Mica Alt"/>
                        <ComboBoxItem Content="Desktop Acrylic"/>
                    </ComboBox>
                </toolkit:SettingsCard>

                <!-- ── Mascot ───────────────────────────────────────── -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                           Text="Mascot"/>

                <!-- Show Mascot — custom toggle card -->
                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7B3;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock Text="Show Mascot"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Display the floating mascot on your desktop. Quick-add hotkey and tray keep working when off"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="WrapWholeWords"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      AutomationProperties.AutomationId="Settings_ShowMascot"
                                      AutomationProperties.Name="Show mascot"
                                      IsOn="{x:Bind ViewModel.ShowMascot, Mode=TwoWay}"
                                      OnContent="On" OffContent="Off" MinWidth="80"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Lock Position — custom toggle card -->
                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock Text="Lock Position"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Prevent the mascot from being dragged"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="WrapWholeWords"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      AutomationProperties.AutomationId="Settings_LockPosition"
                                      AutomationProperties.Name="Lock mascot position"
                                      IsOn="{x:Bind ViewModel.LockMascotPosition, Mode=TwoWay}"
                                      OnContent="On" OffContent="Off" MinWidth="80"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Mute Animation — custom toggle card -->
                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE74F;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock Text="Mute Animation"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Pause the mascot idle animation"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="WrapWholeWords"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      AutomationProperties.AutomationId="Settings_MuteAnimation"
                                      AutomationProperties.Name="Mute mascot animation"
                                      IsOn="{x:Bind ViewModel.MuteAnimation, Mode=TwoWay}"
                                      OnContent="On" OffContent="Off" MinWidth="80"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Always on Top — custom toggle card -->
                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE89F;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock Text="Always on Top"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Keep the mascot above all other windows"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="WrapWholeWords"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      AutomationProperties.AutomationId="Settings_AlwaysOnTop"
                                      AutomationProperties.Name="Mascot always on top"
                                      IsOn="{x:Bind ViewModel.MascotAlwaysOnTop, Mode=TwoWay}"
                                      OnContent="On" OffContent="Off" MinWidth="80"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Hide When Fullscreen — custom toggle card -->
                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE92C;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock Text="Hide During Fullscreen &amp; Games"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Automatically hide when a fullscreen app, game, or presentation is active"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="WrapWholeWords"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      AutomationProperties.AutomationId="Settings_HideFullscreen"
                                      AutomationProperties.Name="Hide during fullscreen"
                                      IsOn="{x:Bind ViewModel.HideWhenFullscreen, Mode=TwoWay}"
                                      OnContent="On" OffContent="Off" MinWidth="80"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Show Tips Automatically — custom toggle card -->
                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock Text="Show Tips Automatically"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Pop up tips above the mascot on their own, instead of waiting for a click"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="WrapWholeWords"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2"
                                      AutomationProperties.AutomationId="Settings_ShowTipsAutomatically"
                                      AutomationProperties.Name="Show tips automatically"
                                      IsOn="{x:Bind ViewModel.ShowTipsAutomatically, Mode=TwoWay}"
                                      OnContent="On" OffContent="Off" MinWidth="80"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Automatic tip time window — only meaningful while the toggle above is on -->
                <Border Style="{StaticResource ToggleCardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE823;" FontSize="16"
                                  VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,14,16,14">
                            <TextBlock x:Uid="Settings_TipTimeHeader"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_TipTimeDescription"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" TextWrapping="WrapWholeWords"/>
                        </StackPanel>
                        <!-- Item order maps 1:1 onto TipTimePreference (Anytime=0, Morning=1,
                             Afternoon=2, Evening=3) — keep in sync with the enum. -->
                        <ComboBox Grid.Column="2" MinWidth="140" VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="Settings_TipTime"
                                  AutomationProperties.Name="Automatic tip time"
                                  IsEnabled="{x:Bind ViewModel.ShowTipsAutomatically, Mode=OneWay}"
                                  SelectedIndex="{x:Bind ViewModel.ProactiveTipTimeIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="Settings_TipTime_Anytime"/>
                            <ComboBoxItem x:Uid="Settings_TipTime_Morning"/>
                            <ComboBoxItem x:Uid="Settings_TipTime_Afternoon"/>
                            <ComboBoxItem x:Uid="Settings_TipTime_Evening"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Lottie Animation File -->
                <toolkit:SettingsCard
                    Header="Lottie Animation File"
                    Description="{x:Bind ViewModel.LottieFileDisplay, Mode=OneWay}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8A5;"/>
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Browse"
                                AutomationProperties.AutomationId="Settings_BrowseLottie"
                                Click="BrowseLottieButton_Click"/>
                        <Button Content="Clear"
                                AutomationProperties.AutomationId="Settings_ClearLottie"
                                Click="ClearLottieButton_Click"
                                IsEnabled="{x:Bind ViewModel.HasLottieFile, Mode=OneWay}"/>
                    </StackPanel>
                </toolkit:SettingsCard>

                <!-- Mascot Size -->
                <toolkit:SettingsExpander Header="Mascot Size"
                                          Description="Choose how large the mascot appears on screen">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE744;"/>
                    </toolkit:SettingsExpander.HeaderIcon>
                    <TextBlock x:Name="MascotSizeHeaderLabel"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard Header="Presets">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Small"  AutomationProperties.AutomationId="Settings_SizeSmall"  Tag="80"  Click="MascotSizePreset_Click" MinWidth="72"/>
                                <Button Content="Medium" AutomationProperties.AutomationId="Settings_SizeMedium" Tag="120" Click="MascotSizePreset_Click" MinWidth="72"/>
                                <Button Content="Large"  AutomationProperties.AutomationId="Settings_SizeLarge"  Tag="160" Click="MascotSizePreset_Click" MinWidth="72"/>
                            </StackPanel>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="Custom">
                            <Slider x:Name="MascotSizeSlider"
                                    AutomationProperties.AutomationId="Settings_SizeSlider"
                                    AutomationProperties.Name="Mascot size"
                                    Minimum="60" Maximum="200"
                                    StepFrequency="1" TickFrequency="20"
                                    TickPlacement="Outside"
                                    Width="200"
                                    ValueChanged="MascotSizeSlider_ValueChanged"/>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <!-- Quick-add global hotkey -->
                <toolkit:SettingsExpander Header="Quick-Add Hotkey"
                                          Description="{x:Bind ViewModel.HotkeyDescription, Mode=OneWay}">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE92E;"/>
                    </toolkit:SettingsExpander.HeaderIcon>
                    <TextBlock Text="{x:Bind ViewModel.HotkeyDescription, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <toolkit:SettingsExpander.Items>
                        <!-- Modifier keys -->
                        <toolkit:SettingsCard Header="Modifiers">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <CheckBox Content="Ctrl"
                                          AutomationProperties.AutomationId="Settings_HotkeyCtrl"
                                          IsChecked="{x:Bind ViewModel.HotkeyCtrl, Mode=TwoWay}"/>
                                <CheckBox Content="Shift"
                                          AutomationProperties.AutomationId="Settings_HotkeyShift"
                                          IsChecked="{x:Bind ViewModel.HotkeyShift, Mode=TwoWay}"/>
                                <CheckBox Content="Alt"
                                          AutomationProperties.AutomationId="Settings_HotkeyAlt"
                                          IsChecked="{x:Bind ViewModel.HotkeyAlt, Mode=TwoWay}"/>
                            </StackPanel>
                        </toolkit:SettingsCard>
                        <!-- Key -->
                        <toolkit:SettingsCard Header="Key">
                            <ComboBox x:Name="HotkeyKeySelector"
                                      AutomationProperties.AutomationId="Settings_HotkeyKeyComboBox"
                                      AutomationProperties.Name="Hotkey key"
                                      MinWidth="120"
                                      SelectionChanged="HotkeyKeySelector_SelectionChanged">
                                <ComboBoxItem Content="Space" Tag="32"/>
                                <ComboBoxItem Content="A" Tag="65"/>
                                <ComboBoxItem Content="Q" Tag="81"/>
                                <ComboBoxItem Content="T" Tag="84"/>
                                <ComboBoxItem Content="N" Tag="78"/>
                                <ComboBoxItem Content="+" Tag="187"/>
                            </ComboBox>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <!-- ── Sync ────────────────────────────────────────── -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                           Text="Sync"/>

                <!-- Signed-in state -->
                <toolkit:SettingsCard
                    Visibility="{x:Bind ViewModel.IsSyncSignedIn, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                    Header="{x:Bind ViewModel.SyncUserEmail, Mode=OneWay}"
                    Description="{x:Bind ViewModel.SyncLastSyncedText, Mode=OneWay}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE77B;"/>
                    </toolkit:SettingsCard.HeaderIcon>
                    <Button Content="Sign out"
                            AutomationProperties.AutomationId="Settings_SyncSignOut"
                            Command="{x:Bind ViewModel.SignOutCommand}"/>
                </toolkit:SettingsCard>

                <!-- Sync error (shown when signed in and sync fails) -->
                <InfoBar x:Name="SyncErrorBar"
                         Severity="Error"
                         IsOpen="{x:Bind ViewModel.HasSyncError, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.IsSyncSignedIn, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                         Message="{x:Bind ViewModel.SyncError, Mode=OneWay}"
                         IsClosable="False"/>

                <!-- Sign-in form -->
                <toolkit:SettingsExpander
                    Visibility="{x:Bind ViewModel.IsSyncNotSignedIn, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                    Header="Sync across devices"
                    Description="Sign in to keep your tasks in sync across PCs">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE895;"/>
                    </toolkit:SettingsExpander.HeaderIcon>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard Header="Email">
                            <TextBox x:Name="SyncEmailBox"
                                     AutomationProperties.AutomationId="Settings_SyncEmail"
                                     AutomationProperties.Name="Email"
                                     Text="{x:Bind ViewModel.SyncEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="220"
                                     InputScope="EmailNameOrAddress"/>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="Password">
                            <PasswordBox x:Name="SyncPasswordBox"
                                         AutomationProperties.AutomationId="Settings_SyncPassword"
                                         AutomationProperties.Name="Password"
                                         MinWidth="220"/>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Sign in"
                                        AutomationProperties.AutomationId="Settings_SyncSignIn"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        IsEnabled="{x:Bind ViewModel.IsNotSyncing, Mode=OneWay}"
                                        Click="SyncSignIn_Click"/>
                                <Button Content="Create account"
                                        AutomationProperties.AutomationId="Settings_SyncSignUp"
                                        IsEnabled="{x:Bind ViewModel.IsNotSyncing, Mode=OneWay}"
                                        Click="SyncSignUp_Click"/>
                            </StackPanel>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="Or continue with">
                            <Button Content="Sign in with GitHub"
                                    AutomationProperties.AutomationId="Settings_SyncGitHub"
                                    IsEnabled="{x:Bind ViewModel.IsNotSyncing, Mode=OneWay}"
                                    Click="SyncGitHubSignIn_Click"/>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                            Visibility="{x:Bind ViewModel.HasSyncError, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.SyncError, Mode=OneWay}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       TextWrapping="Wrap"/>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <!-- ── Data ─────────────────────────────────────────── -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                           Text="Data"/>

                <toolkit:SettingsCard
                    Header="Open data folder"
                    Description="Browse or back up your tasks.json and settings.json files">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8B7;"/>
                    </toolkit:SettingsCard.HeaderIcon>
                    <Button Content="Open folder"
                            AutomationProperties.AutomationId="Settings_OpenDataFolder"
                            Command="{x:Bind ViewModel.OpenDataFolderCommand}"/>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard
                    Header="Export tasks"
                    Description="Save your tasks as a file you choose where to put — JSON for a full backup, CSV for a spreadsheet, Markdown for a checklist you can paste into a status update">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE898;"/>
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="JSON" Tag="json"
                                AutomationProperties.AutomationId="Settings_ExportJson"
                                Click="ExportButton_Click"/>
                        <Button Content="CSV" Tag="csv"
                                AutomationProperties.AutomationId="Settings_ExportCsv"
                                Click="ExportButton_Click"/>
                        <Button Content="Markdown" Tag="markdown"
                                AutomationProperties.AutomationId="Settings_ExportMarkdown"
                                Click="ExportButton_Click"/>
                    </StackPanel>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard
                    Visibility="{x:Bind ViewModel.HasExportError, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.ExportError, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"/>
                </toolkit:SettingsCard>

                <!-- ── About ────────────────────────────────────────── -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                           Text="About"/>

                <toolkit:SettingsExpander
                    Margin="0,0,0,24"
                    Header="Hatch"
                    Description="Local-first task manager for Windows">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE946;"/>
                    </toolkit:SettingsExpander.HeaderIcon>
                    <TextBlock Text="v0.14.0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard Header="Privacy">
                            <toolkit:SettingsCard.Description>
                                <TextBlock
                                    Text="No account · No cloud · No telemetry. All data is stored locally in %LocalAppData%\Hatch\ and never leaves your device."
                                    TextWrapping="Wrap"/>
                            </toolkit:SettingsCard.Description>
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard Header="Author"
                                              Description="Reza Fauzi Augusdi">
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard Header="Source code"
                                              Description="github.com/fbtwitter/hatch">
                            <Button Content="Open on GitHub"
                                    AutomationProperties.AutomationId="Settings_OpenGitHub"
                                    Command="{x:Bind ViewModel.OpenGitHubCommand}"/>
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard Header="Report an issue"
                                              Description="Found a bug or have a suggestion?">
                            <Button Content="Open issues"
                                    AutomationProperties.AutomationId="Settings_OpenGitHubIssues"
                                    Command="{x:Bind ViewModel.OpenGitHubIssuesCommand}"/>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
