<Window
    x:Class="Hatch.Views.FocusModeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <!-- Drag region — title row -->
        <Grid x:Name="TitleBar" Grid.Row="0" Padding="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0" Glyph="&#xE8B0;" FontSize="14"
                      VerticalAlignment="Center" Margin="0,0,10,0"
                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"/>
        </Grid>

        <!-- Action buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                    Padding="16,0,16,0" VerticalAlignment="Center">
            <Button Content="Mark done"
                    AutomationProperties.AutomationId="FocusMode_MarkDone"
                    Command="{x:Bind ViewModel.MarkDoneCommand}"
                    Style="{ThemeResource AccentButtonStyle}"/>
            <Button Content="Exit focus"
                    AutomationProperties.AutomationId="FocusMode_Exit"
                    Command="{x:Bind ViewModel.ExitCommand}"/>
        </StackPanel>
    </Grid>
</Window>
