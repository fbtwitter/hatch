<Window
    x:Class="Hatch.Views.MascotWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lottie="using:CommunityToolkit.WinUI.Lottie">

    <Grid x:Name="MascotGrid"
      Background="Transparent"
      PointerEntered="OnPointerEntered"
      PointerExited="OnPointerExited"
      PointerPressed="OnPointerPressed"
      PointerMoved="OnPointerMoved"
      PointerReleased="OnPointerReleased"
      Tapped="OnTapped">
    <Grid.RenderTransform>
        <CompositeTransform x:Name="MascotGridTransform"/>
    </Grid.RenderTransform>

        <Grid.Resources>
            <!-- 4-second idle cycle: 2 gentle bobs + 1 blink at 2.8 s -->
            <Storyboard x:Key="IdleAnimation" RepeatBehavior="Forever">

                <DoubleAnimationUsingKeyFrames
                    Storyboard.TargetName="MascotRoot"
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)">
                    <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:1" Value="-5">
                        <EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:2" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:3" Value="-5">
                        <EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="0:0:4" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>

                <DoubleAnimationUsingKeyFrames
                    Storyboard.TargetName="LeftEye"
                    Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0"    Value="1"/>
                    <DiscreteDoubleKeyFrame KeyTime="0:0:2.7"  Value="1"/>
                    <EasingDoubleKeyFrame   KeyTime="0:0:2.8"  Value="0.05"/>
                    <EasingDoubleKeyFrame   KeyTime="0:0:2.95" Value="1"/>
                </DoubleAnimationUsingKeyFrames>

                <DoubleAnimationUsingKeyFrames
                    Storyboard.TargetName="RightEye"
                    Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0"    Value="1"/>
                    <DiscreteDoubleKeyFrame KeyTime="0:0:2.7"  Value="1"/>
                    <EasingDoubleKeyFrame   KeyTime="0:0:2.8"  Value="0.05"/>
                    <EasingDoubleKeyFrame   KeyTime="0:0:2.95" Value="1"/>
                </DoubleAnimationUsingKeyFrames>

            </Storyboard>

            <!-- Inactivity fade: full opacity → 0.4 over 2 s (starts after 30 s idle) -->
            <Storyboard x:Key="IdleFadeOut">
                <DoubleAnimation
                    Storyboard.TargetName="MascotGrid"
                    Storyboard.TargetProperty="Opacity"
                    To="0.4" Duration="0:0:2">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <!-- Restore opacity instantly on hover/interaction -->
            <Storyboard x:Key="IdleFadeIn">
                <DoubleAnimation
                    Storyboard.TargetName="MascotGrid"
                    Storyboard.TargetProperty="Opacity"
                    To="1.0" Duration="0:0:0.2">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <!-- Hover: subtle scale up -->
            <Storyboard x:Key="HoverIn">
                <DoubleAnimation
                    Storyboard.TargetName="MascotGridTransform"
                    Storyboard.TargetProperty="ScaleX"
                    To="1.06" Duration="0:0:0.15">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="MascotGridTransform"
                    Storyboard.TargetProperty="ScaleY"
                    To="1.06" Duration="0:0:0.15">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <!-- Hover end: return to normal scale -->
            <Storyboard x:Key="HoverOut">
                <DoubleAnimation
                    Storyboard.TargetName="MascotGridTransform"
                    Storyboard.TargetProperty="ScaleX"
                    To="1.0" Duration="0:0:0.2">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="MascotGridTransform"
                    Storyboard.TargetProperty="ScaleY"
                    To="1.0" Duration="0:0:0.2">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            </Grid.Resources>

        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="Show Main Window"
                                Command="{x:Bind ViewModel.ShowMainWindowCommand}"/>
                <MenuFlyoutItem Text="Reset Position"
                                Command="{x:Bind ViewModel.ResetPositionCommand}"/>
                <MenuFlyoutItem Text="Mascot Settings&#x2026;"
                                Click="OnMascotSettingsMenuItemClick"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutSubItem Text="Hide for...">
                    <MenuFlyoutItem Text="1 hour"
                                    Command="{x:Bind ViewModel.HideFor1HourCommand}"/>
                    <MenuFlyoutItem Text="3 hours"
                                    Command="{x:Bind ViewModel.HideFor3HoursCommand}"/>
                    <MenuFlyoutItem Text="Until tomorrow"
                                    Command="{x:Bind ViewModel.HideUntilTomorrowCommand}"/>
                    <MenuFlyoutItem Text="Until restart"
                                    Command="{x:Bind ViewModel.HideUntilRestartCommand}"/>
                </MenuFlyoutSubItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <!-- Lottie player — hidden until a .json file is set in Settings -->
        <AnimatedVisualPlayer x:Name="LottiePlayer"
                              Width="{x:Bind ViewModel.WindowSize, Mode=OneWay}"
                              Height="{x:Bind ViewModel.WindowSize, Mode=OneWay}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              AutoPlay="False"
                              Stretch="Uniform"
                              Visibility="Collapsed"/>

        <!--
            Egg mascot — XAML vector shapes + Storyboard idle animation.

            To swap in a Lottie asset, replace the Canvas below with:

                <AnimatedVisualPlayer x:Name="MascotRoot"
                                      Width="120" Height="120"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      AutoPlay="True"
                                      Stretch="Uniform"
                                      Source="{StaticResource YourLottieSource}"/>

            Then remove the Storyboard from Grid.Resources and the
            _idleAnimation field + calls from MascotWindow.xaml.cs.
        -->
        <Viewbox x:Name="MascotRoot"
                Width="{x:Bind ViewModel.WindowSize, Mode=OneWay}"
                Height="{x:Bind ViewModel.WindowSize, Mode=OneWay}"
                Stretch="Uniform"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Viewbox.RenderTransform>
                <CompositeTransform/>
            </Viewbox.RenderTransform>

            <Canvas Width="120" Height="120">

            <!-- Egg body: accent fill, white border -->
            <Ellipse Canvas.Left="16" Canvas.Top="10"
                     Width="88" Height="100"
                     Fill="{ThemeResource AccentFillColorDefaultBrush}"
                     Stroke="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                     StrokeThickness="2.5"/>

            <!-- Shell crack — hatching motif -->
            <Path Stroke="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                  StrokeThickness="2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Data="M 60,12 L 54,24 L 63,30 L 56,40"/>

            <!-- Left eye -->
            <Ellipse x:Name="LeftEye"
                     Canvas.Left="44" Canvas.Top="48"
                     Width="9" Height="11"
                     Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>

            <!-- Right eye -->
            <Ellipse x:Name="RightEye"
                     Canvas.Left="67" Canvas.Top="48"
                     Width="9" Height="11"
                     Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>

            <!-- Smile -->
            <Path Stroke="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                  StrokeThickness="2.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Data="M 48,70 Q 60,81 72,70"/>

            </Canvas>
        </Viewbox>

        <!-- Daily tip indicator: small dot in top-right corner -->
        <Ellipse x:Name="DailyTipIndicator"
                 Width="12" Height="12"
                 Fill="{ThemeResource SystemFillColorSuccessBrush}"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="4,4,4,4"
                 Visibility="Collapsed"/>

    </Grid>

</Window>
