<Window
    x:Class="Hatch.Views.MascotWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Background must be Transparent so areas outside the mascot show the desktop.
        SetWindowRgn (applied in code-behind) routes mouse events to the ellipse only.
    -->
    <Grid Background="Transparent">

        <!--
            Placeholder visual — replace with AnimatedVisualPlayer (Lottie) when asset is ready.
            The ellipse shape matches the SetWindowRgn region set in code-behind.
        -->
        <Ellipse Width="96" Height="96"
                 Fill="{ThemeResource AccentFillColorDefaultBrush}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

        <TextBlock Text="H"
                   FontSize="36"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"/>

    </Grid>
</Window>
