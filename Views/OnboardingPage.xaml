<Page
    x:Class="Hatch.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24,48,24,32">
        <StackPanel MaxWidth="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="32">

            <!-- Mascot — same vector as MascotWindow -->
            <Viewbox Width="80" Height="80" HorizontalAlignment="Center">
                <Canvas Width="100" Height="100">
                    <Path Data="M50 6 C72 6 88 32 88 58 C88 80 72 94 50 94 C28 94 12 80 12 58 C12 32 28 6 50 6 Z"
                          Fill="#FFD966"/>
                    <Path Data="M14 50 L24 56 L32 48 L42 58 L52 50 L60 60 L70 52 L80 60 L86 54"
                          Fill="Transparent"
                          Stroke="#1A1A1A"
                          StrokeThickness="3.5"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                    <Path Data="M4 36 Q4 40 8 40 L20 40 Q24 40 24 36 L24 10 Q24 4 18 4 L10 4 Q4 4 4 10 L4 30 Q4 33 7 33 Q10 33 10 30 L10 14 Q10 11 13 11 L15 11 Q18 11 18 14 L18 30"
                          Fill="Transparent"
                          Stroke="#1A73E8"
                          StrokeThickness="3.2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round">
                        <Path.RenderTransform>
                            <TranslateTransform X="36" Y="22"/>
                        </Path.RenderTransform>
                    </Path>
                </Canvas>
            </Viewbox>

            <!-- Heading -->
            <StackPanel Spacing="6">
                <TextBlock Text="Welcome to Hatch"
                           Style="{ThemeResource TitleLargeTextBlockStyle}"
                           TextAlignment="Center"/>
                <TextBlock Text="A task manager that respects your privacy."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center"/>
            </StackPanel>

            <!-- Privacy bullets -->
            <StackPanel Spacing="20">

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE77B;" FontSize="20"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                              VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="No account required"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="Sign in to nothing. Hatch works out of the box."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE72E;" FontSize="20"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                              VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Your data stays on your device"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="Tasks are saved locally in %LocalAppData%. Nothing leaves your PC."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEA18;" FontSize="20"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                              VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="No telemetry, ever"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="Zero tracking, zero analytics. Your privacy is the default."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

            </StackPanel>

            <!-- Get started -->
            <Button x:Name="GetStartedButton"
                    Content="Get started"
                    AutomationProperties.AutomationId="Onboarding_GetStarted"
                    HorizontalAlignment="Stretch"
                    Padding="0,12"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="GetStartedButton_Click"/>

        </StackPanel>
    </Grid>

</Page>
