<Page
    x:Class="Hatch.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowDefinitions="Auto,*">
        <!-- Page-content backdrop — set from code-behind on Windows 11 only -->
        <SystemBackdropElement x:Name="PageContentBackdrop"
                               Grid.RowSpan="2"
                               CornerRadius="0"
                               Visibility="Collapsed"/>

        <TitleBar
            x:Name="MainTitleBar"
            Title="Hatch"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            BackRequested="TitleBar_BackRequested"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <BitmapIconSource UriSource="ms-appx:///Assets/Square44x44Logo.png" ShowAsMonochrome="False"/>
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Auto"
            CompactModeThresholdWidth="0"
            ExpandedModeThresholdWidth="720"
            CompactPaneLength="48"
            OpenPaneLength="192"
            SelectionChanged="NavView_SelectionChanged"
            ItemInvoked="NavView_ItemInvoked"
            IsSettingsVisible="True"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="MyDayItem" AutomationProperties.AutomationId="Nav_MyDay" x:Uid="Nav_MyDay" Tag="myday" Icon="Calendar" ToolTipService.Placement="Right"/>
                <NavigationViewItem x:Name="ImportantItem" AutomationProperties.AutomationId="Nav_Important" x:Uid="Nav_Important" Tag="important" Icon="Favorite" ToolTipService.Placement="Right"/>
                <NavigationViewItem x:Name="PlannedItem" AutomationProperties.AutomationId="Nav_Planned" x:Uid="Nav_Planned" Tag="planned" ToolTipService.Placement="Right">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xED28;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AllTasksItem" AutomationProperties.AutomationId="Nav_AllTasks" x:Uid="Nav_AllTasks" Tag="alltasks" Icon="List" ToolTipService.Placement="Right"/>
                <NavigationViewItemSeparator/>
                <!-- Custom list items injected after this separator by code-behind -->
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NewListFooterItem" Tag="newlist" Content="New list" ToolTipService.Placement="Right">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE710;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame"/>
        </NavigationView>

    </Grid>
</Page>
