<Page
    x:Class="Hatch.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <NavigationView x:Name="NavView" PaneDisplayMode="Auto" SelectionChanged="NavView_SelectionChanged" IsSettingsVisible="True">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="MyDayItem" Content="My Day" Tag="myday" Icon="Calendar"/>
            <NavigationViewItem x:Name="ImportantItem" Content="Important" Tag="important" Icon="Favorite"/>
            <NavigationViewItem x:Name="PlannedItem" Content="Planned" Tag="planned">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xED28;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="AllTasksItem" Content="All Tasks" Tag="alltasks" Icon="List"/>
        </NavigationView.MenuItems>

        <Frame x:Name="ContentFrame"/>
    </NavigationView>
</Page>
