<Page
    x:Class="Hatch.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Hatch.ViewModels"
    xmlns:converters="using:Hatch.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="StatTileStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="MinHeight" Value="104"/>
        </Style>

        <Style x:Key="StatIconBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatNumberStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <DataTemplate x:Key="TaskRowTemplate" x:DataType="vm:UpcomingTaskInfo">
            <Grid Padding="16,12" ColumnSpacing="12"
                  Background="Transparent"
                  Tapped="UpcomingRow_Tapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind Title}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{x:Bind DueLabel}"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20">

            <StackPanel Spacing="4">
                <TextBlock Text="Summary" Style="{ThemeResource TitleLargeTextBlockStyle}"/>
                <TextBlock Text="Computed locally from your tasks. Nothing here ever leaves your device."
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Responsive KPI grid — UniformGridLayout reflows the column count to fill
                 whatever width is available, instead of a fixed column count. -->
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tiles}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="220" MinItemHeight="104"
                                       MinRowSpacing="16" MinColumnSpacing="16"
                                       ItemsStretch="Fill"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatTileInfo">
                        <Border Style="{StaticResource StatTileStyle}" Translation="0,0,16">
                            <Border.Shadow>
                                <ThemeShadow/>
                            </Border.Shadow>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource StatIconBadgeStyle}"
                                        Background="{x:Bind BadgeBackground}">
                                    <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="18"
                                              Foreground="{x:Bind IconForeground}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                               Text="{x:Bind Value}"
                                               Style="{StaticResource StatNumberStyle}"/>
                                    <TextBlock Text="{x:Bind Label}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="WrapWholeWords"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- Today — the daily-agenda glance: what's actually due right now, grouped
                 apart from Upcoming so it reads as "do these today" not "coming up" -->
            <StackPanel Spacing="12">
                <TextBlock Text="Today" Style="{ThemeResource BodyStrongTextBlockStyle}"/>

                <Border Style="{StaticResource StatTileStyle}" Padding="4" MinHeight="0"
                        Visibility="{x:Bind ViewModel.HasTodayTasks, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.TodayTasks}"
                                   ItemTemplate="{StaticResource TaskRowTemplate}"/>
                </Border>

                <Border Style="{StaticResource StatTileStyle}" MinHeight="0"
                        Visibility="{x:Bind ViewModel.HasTodayTasks, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}">
                    <TextBlock Text="Nothing due today."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" Padding="8"/>
                </Border>
            </StackPanel>

            <!-- Upcoming — next non-overdue due tasks, most actionable forward-looking info -->
            <StackPanel Spacing="12">
                <TextBlock Text="Upcoming" Style="{ThemeResource BodyStrongTextBlockStyle}"/>

                <Border Style="{StaticResource StatTileStyle}" Padding="4" MinHeight="0"
                        Visibility="{x:Bind ViewModel.HasUpcomingTasks, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.UpcomingTasks}"
                                   ItemTemplate="{StaticResource TaskRowTemplate}"/>
                </Border>

                <Border Style="{StaticResource StatTileStyle}" MinHeight="0"
                        Visibility="{x:Bind ViewModel.HasUpcomingTasks, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}">
                    <TextBlock Text="Nothing due soon."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" Padding="8"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
