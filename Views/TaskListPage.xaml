<Page
    x:Class="Hatch.Views.TaskListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Hatch.Models"
    xmlns:converters="using:Hatch.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:BoolToStrikethroughConverter x:Key="BoolToStrikethrough"/>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacity"/>
        <converters:DateTimeToStringConverter x:Key="DateTimeToString"/>
        <converters:DueDateToStringConverter x:Key="DueDateToString"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:BoolToStarGlyphConverter x:Key="BoolToStarGlyph"/>
        <converters:DueDateToChipVisibilityConverter x:Key="DueDateToChipVisibility"/>
        <converters:DueDateToChipBrushConverter x:Key="DueDateToChipBrush"/>
        <converters:DueDateToChipForegroundConverter x:Key="DueDateToChipForeground"/>
        <converters:DueDateToChipGlyphConverter x:Key="DueDateToChipGlyph"/>
        <converters:PlannedGroupNameToForegroundConverter x:Key="PlannedGroupNameToForeground"/>
        <converters:BoolToStarTooltipConverter x:Key="BoolToStarTooltip"/>

        <!-- Chip button: preserves the chip color on hover/press instead of flashing WinUI default grey -->
        <Style x:Key="ChipButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid"
                              Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.75"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.55"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <CollectionViewSource x:Name="PlannedGroupsSource"
                              IsSourceGrouped="True"
                              ItemsPath="Items"/>

        <!-- Template for grouped open/completed tasks (flat views) -->
        <DataTemplate x:Key="FlatGroupedTemplate" x:DataType="models:CompletedTaskGroup">
            <StackPanel Spacing="0">
                <Expander x:Name="GroupExpander"
                          IsExpanded="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource Mode=Self}}"
                          HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock Text="{Binding Name}"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   Margin="0,8,0,8"
                                   Opacity="0.85"/>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding Items}"
                                  ItemTemplate="{StaticResource TaskItemTemplate}"
                                  IsTabStop="False"/>
                </Expander>
            </StackPanel>
        </DataTemplate>

        <!-- Shared item template used by both flat and grouped lists -->
        <DataTemplate x:Key="TaskItemTemplate" x:DataType="models:TodoItem">
            <Grid Margin="0,3"
                  Padding="12,10"
                  ColumnSpacing="4"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          IsChecked="{x:Bind IsCompleted, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          x:Uid="Task_CheckBox"/>

                <!-- Title + date chip — fades as a unit when completed -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"
                            Opacity="{x:Bind IsCompleted, Converter={StaticResource BoolToOpacity}, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                               TextDecorations="{x:Bind IsCompleted, Converter={StaticResource BoolToStrikethrough}, Mode=OneWay}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Style="{ThemeResource BodyTextBlockStyle}"/>

                    <!-- Date chip — visible when a due date is set; clicking opens the flyout -->
                    <Button Tag="{x:Bind}"
                            Click="ChipDateButton_Click"
                            Visibility="{x:Bind DueDate, Converter={StaticResource DueDateToChipVisibility}, Mode=OneWay}"
                            Background="{x:Bind DueDate, Converter={StaticResource DueDateToChipBrush}, Mode=OneWay}"
                            Style="{StaticResource ChipButtonStyle}"
                            x:Uid="Task_DateChipButton">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="{x:Bind DueDate, Converter={StaticResource DueDateToChipGlyph}, Mode=OneWay}"
                                      FontSize="11"
                                      Foreground="{x:Bind DueDate, Converter={StaticResource DueDateToChipForeground}, Mode=OneWay}"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind DueDate, Converter={StaticResource DueDateToString}, Mode=OneWay}"
                                       Foreground="{x:Bind DueDate, Converter={StaticResource DueDateToChipForeground}, Mode=OneWay}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- No-date placeholder:
                         outer Border collapses when IsCompleted=true  (done tasks don't need a date prompt)
                         inner Button collapses when DueDate is already set (don't show "Add date" alongside the real chip) -->
                    <Border Visibility="{x:Bind IsCompleted, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}">
                        <Button Tag="{x:Bind}"
                                Click="ChipDateButton_Click"
                                Visibility="{x:Bind DueDate, Converter={StaticResource DueDateToChipVisibility}, ConverterParameter=Invert, Mode=OneWay}"
                                Padding="0" MinWidth="0" MinHeight="0"
                                Background="Transparent" BorderThickness="0"
                                IsTabStop="False"
                                x:Uid="Task_AddDateButton">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE787;" FontSize="11"
                                          Opacity="0.35"
                                          VerticalAlignment="Center"/>
                                <TextBlock x:Uid="Task_AddDateText"
                                           Opacity="0.35"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>

                <!--
                    Always-visible action strip.
                    ☆  star/unstar
                    ✏  edit
                    ⋯  overflow menu — Delete lives here, keeping the trash icon off the main row
                -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="0">

                    <Button Tag="{x:Bind}"
                            Click="StarButton_Click"
                            ToolTipService.ToolTip="{x:Bind IsStarred, Converter={StaticResource BoolToStarTooltip}, Mode=OneWay}"
                            Style="{ThemeResource SubtleButtonStyle}"
                            IsTabStop="False"
                            Padding="8,6" MinWidth="0">
                        <FontIcon Glyph="{x:Bind IsStarred, Converter={StaticResource BoolToStarGlyph}, Mode=OneWay}"
                                  FontSize="14"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Button>

                    <Button Tag="{x:Bind}"
                            Click="EditButton_Click"
                            x:Uid="Task_EditButton"
                            Style="{ThemeResource SubtleButtonStyle}"
                            IsTabStop="False"
                            Padding="8,6" MinWidth="0">
                        <FontIcon Glyph="&#xE70F;" FontSize="14"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Button>

                    <!-- ⋯ overflow — destructive and future actions live here -->
                    <Button Tag="{x:Bind}"
                            Click="OverflowButton_Click"
                            x:Uid="Task_OverflowButton"
                            Style="{ThemeResource SubtleButtonStyle}"
                            IsTabStop="False"
                            Padding="8,6" MinWidth="0">
                        <FontIcon Glyph="&#xE712;" FontSize="14"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Tag="{x:Bind}"
                                                x:Uid="Task_DeleteMenuItem"
                                                Click="DeleteButton_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                </StackPanel>

            </Grid>
        </DataTemplate>

        <Style x:Key="TaskListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter HorizontalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Padding="24,28,16,8" x:Name="HeaderText" Text="My Tasks"
                   Style="{ThemeResource TitleLargeTextBlockStyle}"
                   VerticalAlignment="Center"/>

        <!-- Add task row -->
        <Grid Grid.Row="1" Padding="24,8,24,16" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewTaskTextBox"
                     Grid.Column="0"
                     x:Uid="NewTask_TextBox"
                     Text="{Binding NewTaskText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="NewTaskTextBox_KeyDown"/>
            <Button Grid.Column="1"
                    Content="Add"
                    Command="{Binding AddTaskCommand}"
                    Style="{ThemeResource AccentButtonStyle}"
                    MinWidth="80"
                    x:Uid="NewTask_AddButton"/>
        </Grid>

        <!-- Content area -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Empty state — flat views (My Day, Important, All Tasks) -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            MaxWidth="260"
                            Visibility="{Binding IsTaskListEmpty, Converter={StaticResource BoolToVisibility}}">
                    <FontIcon Glyph="{Binding EmptyStateGlyph, FallbackValue=&#xE762;}"
                              FontSize="48"
                              Foreground="{ThemeResource TextFillColorDisabledBrush}"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding EmptyStateHeadline}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Text="{Binding EmptyStateSubtext}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="WrapWholeWords"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Style="{ThemeResource CaptionTextBlockStyle}"/>
                </StackPanel>

                <!-- Flat list with grouping — My Day, Important, All Tasks -->
            <ItemsControl Grid.Row="0" x:Name="FlatListView"
                          ItemsSource="{Binding FlatGroupedTasks}"
                          Padding="20,0,20,24"
                          Visibility="{Binding IsTaskListEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:CompletedTaskGroup">
                        <StackPanel Spacing="4">
                            <!-- Expander for each group (Open / Completed) -->
                            <Expander x:Name="GroupExpander"
                                      HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <TextBlock Text="{Binding Name}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               Opacity="0.85"/>
                                </Expander.Header>

                                <!-- Tasks in this group -->
                                <ItemsControl ItemsSource="{Binding Items}"
                                              ItemTemplate="{StaticResource TaskItemTemplate}"
                                              IsTabStop="False"/>
                            </Expander>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Grouped list — Planned view only -->
            <ListView Grid.Row="0" x:Name="GroupedListView"
                      ItemsSource="{x:Bind PlannedGroupsSource.View, Mode=OneWay}"
                      SelectionMode="None"
                      Padding="20,0,20,24"
                      ItemTemplate="{StaticResource TaskItemTemplate}"
                      ItemContainerStyle="{StaticResource TaskListViewItemStyle}"
                      Visibility="Collapsed">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection/>
                </ListView.ItemContainerTransitions>
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           Margin="0,12,0,4"
                                           Opacity="0.85"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
            </ListView>

            <!-- Undo snackbar — shown for 4s after a task is completed -->
            <InfoBar Grid.Row="1"
                     x:Name="UndoInfoBar"
                     IsOpen="{Binding IsUndoBarVisible, Mode=OneWay}"
                     IsClosable="True"
                     Severity="Informational"
                     Message="Task completed"
                     Margin="20,8,20,12"
                     Closed="UndoInfoBar_Closed">
                <InfoBar.ActionButton>
                    <Button Content="Undo"
                            Command="{Binding UndoLastCompletionCommand}"
                            Style="{ThemeResource AccentButtonStyle}"/>
                </InfoBar.ActionButton>
            </InfoBar>
        </Grid>
    </Grid>
</Page>
