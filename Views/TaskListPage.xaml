<Page
    x:Class="Hatch.Views.TaskListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Hatch.Models"
    xmlns:converters="using:Hatch.Converters"
    xmlns:vm="using:Hatch.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:BoolToStrikethroughConverter x:Key="BoolToStrikethrough" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacity" />
        <converters:DateTimeToStringConverter x:Key="DateTimeToString" />
        <converters:DueDateToStringConverter x:Key="DueDateToString" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolToStarGlyphConverter x:Key="BoolToStarGlyph" />
        <converters:DueDateToChipVisibilityConverter x:Key="DueDateToChipVisibility" />
        <converters:DueDateToChipBrushConverter x:Key="DueDateToChipBrush" />
        <converters:DueDateToChipForegroundConverter x:Key="DueDateToChipForeground" />
        <converters:DueDateToChipGlyphConverter x:Key="DueDateToChipGlyph" />
        <converters:PlannedGroupNameToForegroundConverter x:Key="PlannedGroupNameToForeground" />
        <converters:BoolToStarTooltipConverter x:Key="BoolToStarTooltip" />
        <converters:TagsToVisibilityConverter x:Key="TagsToVisibility" />
        <converters:TagsPreviewConverter x:Key="TagsPreview" />
        <converters:TagsOverflowCountConverter x:Key="TagsOverflowCount" />
        <converters:TagsOverflowVisibilityConverter x:Key="TagsOverflowVisibility" />

        <!-- Chip button: preserves the chip color on hover/press instead of flashing WinUI default grey -->
        <Style x:Key="ChipButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid"
                              Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.75" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.55" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <CollectionViewSource x:Name="PlannedGroupsSource"
                              IsSourceGrouped="True"
                              ItemsPath="Items" />

        <!-- Shared item template used by both flat and grouped lists -->
        <DataTemplate x:Key="TaskItemTemplate" x:DataType="models:TodoItem">
            <Grid Tag="{x:Bind}"
                  Margin="0,0"
                  Padding="16,12,24,12"
                  ColumnSpacing="8"
                  CornerRadius="0"
                  Background="Transparent"
                  PointerPressed="TaskCard_PointerPressed"
                  Tapped="TaskCard_Tapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          AutomationProperties.AutomationId="Task_CheckBox"
                          IsChecked="{x:Bind IsCompleted, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          x:Uid="Task_CheckBox" />

                <!-- Title + meta row — fades as a unit when completed -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"
                            Opacity="{x:Bind IsCompleted, Converter={StaticResource BoolToOpacity}, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                               TextDecorations="{x:Bind IsCompleted, Converter={StaticResource BoolToStrikethrough}, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Meta row: date chip · tags — all on one line -->
                    <StackPanel Orientation="Horizontal" Spacing="4">

                        <!-- Date chip — clicking opens the date flyout -->
                        <Button Tag="{x:Bind}"
                                AutomationProperties.AutomationId="Task_DateChipButton"
                                Click="ChipDateButton_Click"
                                Visibility="{x:Bind DueDate, Converter={StaticResource DueDateToChipVisibility}, Mode=OneWay}"
                                Background="{x:Bind DueDate, Converter={StaticResource DueDateToChipBrush}, Mode=OneWay}"
                                Style="{StaticResource ChipButtonStyle}"
                                VerticalAlignment="Center"
                                x:Uid="Task_DateChipButton">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <FontIcon Glyph="{x:Bind DueDate, Converter={StaticResource DueDateToChipGlyph}, Mode=OneWay}"
                                          FontSize="11"
                                          Foreground="{x:Bind DueDate, Converter={StaticResource DueDateToChipForeground}, Mode=OneWay}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind DueDate, Converter={StaticResource DueDateToString}, Mode=OneWay}"
                                           Foreground="{x:Bind DueDate, Converter={StaticResource DueDateToChipForeground}, Mode=OneWay}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Add-date ghost — only when not completed and no date -->
                        <Button Tag="{x:Bind}"
                                AutomationProperties.AutomationId="Task_AddDateButton"
                                Click="ChipDateButton_Click"
                                Visibility="{x:Bind ShowAddDateHint, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                Padding="6,2" MinWidth="0" MinHeight="0"
                                Background="Transparent" BorderThickness="0"
                                VerticalAlignment="Center"
                                IsTabStop="False"
                                x:Uid="Task_AddDateButton">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE787;" FontSize="11" Opacity="0.35" VerticalAlignment="Center" />
                                <TextBlock x:Uid="Task_AddDateText" Opacity="0.35"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- · separator — only when both date and tags are present -->
                        <TextBlock Text="·"
                                   Visibility="{x:Bind HasMetaSeparator, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                   Opacity="0.35"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center" />

                        <!-- Tag chips: first 2 -->
                        <ItemsRepeater ItemsSource="{x:Bind Tags, Converter={StaticResource TagsPreview}, Mode=OneWay}"
                                       Visibility="{x:Bind Tags, Converter={StaticResource TagsToVisibility}, Mode=OneWay}"
                                       VerticalAlignment="Center">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="4" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Tag="{x:Bind}"
                                            Click="TagChipInRow_Click"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Padding="6,1">
                                        <TextBlock Text="{x:Bind}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- +N overflow → tapping opens details pane to show all tags -->
                        <Button Tag="{x:Bind}"
                                Click="TagOverflowButton_Click"
                                Visibility="{x:Bind Tags, Converter={StaticResource TagsOverflowVisibility}, Mode=OneWay}"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                Style="{StaticResource ChipButtonStyle}"
                                VerticalAlignment="Center"
                                Padding="6,1">
                            <TextBlock Text="{x:Bind Tags, Converter={StaticResource TagsOverflowCount}, Mode=OneWay}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>

                    </StackPanel>
                </StackPanel>

                <!--
                    Always-visible action strip.
                    ☆  star/unstar
                    ⋯  overflow menu — Delete lives here
                -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Tag="{x:Bind}"
                            AutomationProperties.AutomationId="Task_StarButton"
                            AutomationProperties.Name="{x:Bind IsStarred, Converter={StaticResource BoolToStarTooltip}, Mode=OneWay}"
                            Click="StarButton_Click"
                            ToolTipService.ToolTip="{x:Bind IsStarred, Converter={StaticResource BoolToStarTooltip}, Mode=OneWay}"
                            Style="{ThemeResource SubtleButtonStyle}"
                            IsTabStop="False"
                            Padding="8,6" MinWidth="0">
                        <FontIcon Glyph="{x:Bind IsStarred, Converter={StaticResource BoolToStarGlyph}, Mode=OneWay}"
                                  FontSize="14"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>

                    <!-- ⋯ overflow — destructive and future actions live here -->
                    <Button Tag="{x:Bind}"
                            AutomationProperties.AutomationId="Task_OverflowButton"
                            AutomationProperties.Name="More options"
                            Click="OverflowButton_Click"
                            x:Uid="Task_OverflowButton"
                            Style="{ThemeResource SubtleButtonStyle}"
                            IsTabStop="False"
                            Padding="8,6" MinWidth="0">
                        <FontIcon Glyph="&#xE712;" FontSize="14"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Tag="{x:Bind}"
                                                Text="Focus on this"
                                                Click="FocusMenuItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B0;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Tag="{x:Bind}"
                                                x:Uid="Task_DeleteMenuItem"
                                                Click="DeleteButton_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                </StackPanel>

            </Grid>
        </DataTemplate>

        <Style x:Key="TaskListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0, 2" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid x:Name="ContentBorder"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <!-- 3px accent selection indicator -->
                            <Border x:Name="SelectionBar"
                                    Width="3"
                                    VerticalAlignment="Stretch"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Stretch" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentBorder"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentBorder"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentBorder"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SelectionBar"
                                                                           Storyboard.TargetProperty="Opacity">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="1"
                                                                      KeySpline="0.1,0.9 0.2,1.0" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverSelected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentBorder"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SelectionBar"
                                                                           Storyboard.TargetProperty="Opacity">
                                                <DiscreteDoubleKeyFrame KeyTime="0" Value="1" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PressedSelected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentBorder"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SelectionBar"
                                                                           Storyboard.TargetProperty="Opacity">
                                                <DiscreteDoubleKeyFrame KeyTime="0" Value="1" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- Root: two columns — task list | details pane -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left column: header + add row + task list -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Padding="16,24,16,8" x:Name="HeaderText" Text="My Tasks"
                       Style="{ThemeResource TitleLargeTextBlockStyle}"
                       VerticalAlignment="Center" />

            <!-- Tag filter banner — visible when a tag filter is active -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        Padding="20,0,16,6"
                        Visibility="{x:Bind ViewModel.IsTagFilterActive, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                <TextBlock Text="Showing:"
                           VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Command="{x:Bind ViewModel.ClearTagFilterCommand}"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Style="{StaticResource ChipButtonStyle}"
                        Padding="8,3">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.ActiveTagFilter, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xE711;" FontSize="9"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Add task row -->
            <Grid Grid.Row="2" Padding="16,8,16,16" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewTaskTextBox"
                         AutomationProperties.AutomationId="NewTask_TextBox"
                         Grid.Column="0"
                         x:Uid="NewTask_TextBox"
                         Text="{x:Bind ViewModel.NewTaskText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="NewTaskTextBox_KeyDown" />
                <Button Grid.Column="1"
                        AutomationProperties.AutomationId="NewTask_AddButton"
                        Command="{x:Bind ViewModel.AddTaskCommand}"
                        Style="{ThemeResource AccentButtonStyle}"
                        MinWidth="80"
                        x:Uid="NewTask_AddButton" />
            </Grid>

            <!-- Content area -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Empty state — flat views -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            MaxWidth="260"
                            Visibility="{x:Bind ViewModel.IsTaskListEmpty, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind ViewModel.EmptyStateGlyph, Mode=OneWay, FallbackValue=&#xE762;}"
                              FontSize="48"
                              Foreground="{ThemeResource TextFillColorDisabledBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyStateHeadline, Mode=OneWay}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyStateSubtext, Mode=OneWay}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="WrapWholeWords"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                </StackPanel>

                <!-- Flat list with grouping — My Day, Important, All Tasks -->
                <ScrollViewer Grid.Row="0" x:Name="FlatListView"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.FlatGroupedTasks, Mode=OneWay}"
                                  HorizontalAlignment="Stretch"
                                  Padding="24,0,24,24">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:CompletedTaskGroup">
                                <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                                    <TextBlock Text="{x:Bind EmptyMessage, Mode=OneWay}"
                                               Visibility="{x:Bind ShowEmptyState, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                               HorizontalAlignment="Center"
                                               Padding="0,24,0,8"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <Expander IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              Padding="0"
                                              Margin="16,4"
                                              CornerRadius="{ThemeResource ControlCornerRadius}"
                                              Visibility="{x:Bind HasItems, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <Expander.Resources>
                                            <StaticResource x:Key="ExpanderHeaderBackground"
                                                            ResourceKey="SubtleFillColorSecondaryBrush" />
                                            <StaticResource x:Key="ExpanderHeaderBackgroundPointerOver"
                                                            ResourceKey="SubtleFillColorTertiaryBrush" />
                                        </Expander.Resources>
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="8"
                                                        Padding="0,16" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                           FontWeight="SemiBold"
                                                           Visibility="{x:Bind HasCountLabel, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind CountLabel, Mode=OneWay}"
                                                           Visibility="{x:Bind HasCountLabel, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>

                                        <ListView ItemsSource="{x:Bind Items, Mode=OneWay}"
                                                  ItemTemplate="{StaticResource TaskItemTemplate}"
                                                  ItemContainerStyle="{StaticResource TaskListViewItemStyle}"
                                                  SelectionMode="Single"
                                                  SelectionChanged="TaskListView_SelectionChanged"
                                                  IsTabStop="False"
                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListView.ItemContainerTransitions>
                                                <TransitionCollection />
                                            </ListView.ItemContainerTransitions>
                                        </ListView>
                                    </Expander>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Grouped list — Planned view only -->
                <ListView Grid.Row="0" x:Name="GroupedListView"
                          ItemsSource="{x:Bind PlannedGroupsSource.View, Mode=OneWay}"
                          SelectionMode="Single"
                          SelectionChanged="TaskListView_SelectionChanged"
                          Padding="16,0,16,0"
                          ItemTemplate="{StaticResource TaskItemTemplate}"
                          ItemContainerStyle="{StaticResource TaskListViewItemStyle}"
                          Visibility="Collapsed">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="vm:PlannedGroup">
                                    <TextBlock Text="{x:Bind Name, Mode=OneTime}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,12,0,8" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                </ListView>

                <!-- Undo snackbar -->
                <InfoBar Grid.Row="1"
                         x:Name="UndoInfoBar"
                         x:Uid="UndoInfoBar"
                         AutomationProperties.AutomationId="UndoInfoBar"
                         IsOpen="{x:Bind ViewModel.IsUndoBarVisible, Mode=OneWay}"
                         IsClosable="True"
                         Severity="Informational"
                         Margin="16,8,16,12"
                         Closed="UndoInfoBar_Closed">
                    <InfoBar.ActionButton>
                        <Button x:Uid="UndoButton"
                                AutomationProperties.AutomationId="UndoButton"
                                Command="{x:Bind ViewModel.UndoLastCompletionCommand}"
                                Style="{ThemeResource AccentButtonStyle}" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </Grid>
        </Grid>

        <!-- Scrim — overlay mode only; appears behind the pane over the list -->
        <Border x:Name="PaneScrim"
                Grid.Column="0"
                Background="{ThemeResource SmokeFillColorDefaultBrush}"
                Visibility="Collapsed"
                Tapped="PaneScrim_Tapped" />

        <!-- Details pane — slides in from the right; column set in code-behind -->
        <Border x:Name="DetailsPaneRoot"
                Grid.Column="1"
                Width="280"
                Visibility="Collapsed"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                TabFocusNavigation="Cycle"
                KeyDown="DetailsPaneRoot_KeyDown">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DetailsPaneTranslate" X="280" />
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Pane header -->
                <Grid Grid.Row="0" Padding="16,16,16,8">
                    <TextBlock Text="Details"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <Button x:Name="PaneCloseButton"
                            AutomationProperties.AutomationId="PaneCloseButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Click="PaneCloseButton_Click"
                            ToolTipService.ToolTip="Close (Esc)"
                            Padding="8" MinWidth="0">
                        <FontIcon Glyph="&#xE8BB;" FontSize="12" />
                    </Button>
                </Grid>

                <!-- Pane fields -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="16,8,16,24" Spacing="16">

                        <!-- Title -->
                        <TextBox x:Name="PaneTitleBox"
                                 Header="Title"
                                 PlaceholderText="Task title"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="False"
                                 HorizontalAlignment="Stretch"
                                 TextChanged="PaneTitleBox_TextChanged" />

                        <!-- Notes -->
                        <TextBox x:Name="PaneNotesBox"
                                 AutomationProperties.AutomationId="PaneNotesBox"
                                 Header="Notes"
                                 PlaceholderText="Add a note…"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="100"
                                 MaxHeight="220"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 HorizontalAlignment="Stretch"
                                 TextChanged="PaneNotesBox_TextChanged"
                                 KeyDown="PaneNotesBox_KeyDown" />

                        <!-- My Day toggle -->
                        <ToggleSwitch x:Name="PaneMyDayToggle"
                                      Header="My Day"
                                      OffContent=""
                                      OnContent=""
                                      Toggled="PaneMyDayToggle_Toggled"
                                      Margin="0,-4,0,-4" />

                        <!-- Due date -->
                        <CalendarDatePicker x:Name="PaneDueDatePicker"
                                            Header="Due date"
                                            PlaceholderText="No due date"
                                            HorizontalAlignment="Stretch"
                                            DateChanged="PaneDueDatePicker_DateChanged" />

                        <!-- Tags -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Tags"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollMode="Auto"
                                          VerticalScrollMode="Disabled">
                                <ItemsRepeater x:Name="PaneTagChips">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="6" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10,0,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind}"
                                                               VerticalAlignment="Center"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                    <Button Tag="{x:Bind}"
                                                            Click="PaneTagChipRemove_Click"
                                                            Style="{ThemeResource SubtleButtonStyle}"
                                                            Padding="6"
                                                            MinWidth="32"
                                                            MinHeight="32"
                                                            IsTabStop="False"
                                                            VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE711;"
                                                                  FontSize="10"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                            <TextBox x:Name="PaneTagInput"
                                     PlaceholderText="Add a tag, press Enter"
                                     KeyDown="PaneTagInput_KeyDown" />
                        </StackPanel>

                        <!-- Created at -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Created"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="PaneCreatedAtText"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

    </Grid>
</Page>
