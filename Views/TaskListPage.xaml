<Page
    x:Class="Hatch.Views.TaskListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Hatch.Models"
    xmlns:converters="using:Hatch.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:BoolToStrikethroughConverter x:Key="BoolToStrikethrough"/>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacity"/>
        <converters:DateTimeToStringConverter x:Key="DateTimeToString"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:BoolToStarGlyphConverter x:Key="BoolToStarGlyph"/>

        <CollectionViewSource x:Name="PlannedGroupsSource"
                              IsSourceGrouped="True"
                              ItemsPath="Items"/>

        <!-- Shared item template used by both flat and grouped lists -->
        <DataTemplate x:Key="TaskItemTemplate" x:DataType="models:TodoItem">
            <Grid Margin="0,3"
                  Padding="12,10"
                  ColumnSpacing="4"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          IsChecked="{x:Bind IsCompleted, Mode=TwoWay}"
                          VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                               TextDecorations="{x:Bind IsCompleted, Converter={StaticResource BoolToStrikethrough}, Mode=OneWay}"
                               Opacity="{x:Bind IsCompleted, Converter={StaticResource BoolToOpacity}, Mode=OneWay}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Style="{ThemeResource BodyTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind CreatedAt, Converter={StaticResource DateTimeToString}, Mode=OneTime}"
                               Opacity="0.5"
                               Style="{ThemeResource CaptionTextBlockStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Tag="{x:Bind}"
                            Click="StarButton_Click"
                            ToolTipService.ToolTip="Mark as important"
                            IsTabStop="False"
                            Padding="8,6" MinWidth="0">
                        <FontIcon Glyph="{x:Bind IsStarred, Converter={StaticResource BoolToStarGlyph}, Mode=OneWay}" FontSize="14"/>
                    </Button>
                    <Button Tag="{x:Bind}"
                            Click="EditButton_Click"
                            ToolTipService.ToolTip="Edit task"
                            IsTabStop="False"
                            Padding="8,6" MinWidth="0">
                        <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                    </Button>
                    <Button Tag="{x:Bind}"
                            Click="DeleteButton_Click"
                            ToolTipService.ToolTip="Delete task"
                            IsTabStop="False"
                            Padding="8,6" MinWidth="0">
                        <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="TaskListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter HorizontalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Padding="24,28,16,8" x:Name="HeaderText" Text="My Tasks"
                   Style="{ThemeResource TitleLargeTextBlockStyle}"
                   VerticalAlignment="Center"/>

        <!-- Add task row -->
        <Grid Grid.Row="1" Padding="24,8,24,16" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewTaskTextBox"
                     Grid.Column="0"
                     PlaceholderText="What needs to be done?"
                     Text="{Binding NewTaskText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="NewTaskTextBox_KeyDown"/>
            <Button Grid.Column="1"
                    Content="Add"
                    Command="{Binding AddTaskCommand}"
                    Style="{ThemeResource AccentButtonStyle}"
                    MinWidth="80"/>
        </Grid>

        <!-- Content area -->
        <Grid Grid.Row="2">

            <!-- Empty state — context-aware per nav view -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        MaxWidth="260"
                        Visibility="{Binding IsTaskListEmpty, Converter={StaticResource BoolToVisibility}}">
                <FontIcon Glyph="{Binding EmptyStateGlyph}"
                          FontSize="48"
                          Opacity="0.2"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding EmptyStateHeadline}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Opacity="0.45"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <TextBlock Text="{Binding EmptyStateSubtext}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="WrapWholeWords"
                           Opacity="0.3"
                           Style="{ThemeResource CaptionTextBlockStyle}"/>
            </StackPanel>

            <!-- Flat list — My Day, Important, All Tasks -->
            <ListView x:Name="FlatListView"
                      ItemsSource="{Binding ActiveTasks}"
                      SelectionMode="None"
                      Padding="20,0,20,24"
                      ItemTemplate="{StaticResource TaskItemTemplate}"
                      ItemContainerStyle="{StaticResource TaskListViewItemStyle}"
                      Visibility="{Binding IsTaskListEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection/>
                </ListView.ItemContainerTransitions>
            </ListView>

            <!-- Grouped list — Planned view only -->
            <ListView x:Name="GroupedListView"
                      ItemsSource="{Binding Source={StaticResource PlannedGroupsSource}, Path=View}"
                      SelectionMode="None"
                      Padding="20,0,20,24"
                      ItemTemplate="{StaticResource TaskItemTemplate}"
                      ItemContainerStyle="{StaticResource TaskListViewItemStyle}"
                      Visibility="Collapsed">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection/>
                </ListView.ItemContainerTransitions>
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           Margin="0,12,0,4"
                                           Opacity="0.7"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
            </ListView>
        </Grid>
    </Grid>
</Page>
