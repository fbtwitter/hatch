<Window
    x:Class="Hatch.Views.QuickAddBubbleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="BubbleRoot">
        <Grid.Resources>
            <Storyboard x:Key="ConfirmationFadeIn">
                <DoubleAnimation Storyboard.TargetName="ConfirmationOverlay"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.12"/>
            </Storyboard>

            <Storyboard x:Key="ConfirmationFadeOut">
                <DoubleAnimation Storyboard.TargetName="ConfirmationOverlay"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1" To="0" Duration="0:0:0.1"/>
            </Storyboard>

            <Storyboard x:Key="TipFadeIn">
                <DoubleAnimation Storyboard.TargetName="TipBubble"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.2"/>
            </Storyboard>

            <Storyboard x:Key="TipFadeOut">
                <DoubleAnimation Storyboard.TargetName="TipBubble"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1" To="0" Duration="0:0:0.15"/>
            </Storyboard>
        </Grid.Resources>

        <!-- Confirmation overlay (initially hidden, driven by ShowConfirmationAsync) -->
        <StackPanel x:Name="ConfirmationOverlay"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    Opacity="0"
                    Visibility="Collapsed">

            <!-- Segoe Fluent checkmark inside an accent-tinted circle -->
            <Border Width="56" Height="56"
                    CornerRadius="28"
                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                    HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE73E;"
                          FontSize="26"
                          FontFamily="Segoe Fluent Icons"
                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
            </Border>

            <!-- "Task added!" headline -->
            <TextBlock Text="Task added!"
                       TextAlignment="Center"
                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>

            <!-- Dynamic subtitle set by code-behind; kept as ConfirmationText for compat -->
            <TextBlock x:Name="ConfirmationText"
                       TextAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Form content (shown initially) -->
        <StackPanel x:Name="BubbleContent"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Spacing="12"
                    Padding="16">

            <!-- Contextual tip bubble (shown conditionally) -->
            <Border x:Name="TipBubble"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Opacity="0"
                    Visibility="Collapsed"
                    PointerEntered="TipBubble_PointerEntered"
                    PointerExited="TipBubble_PointerExited">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="TipTextBlock"
                               TextWrapping="Wrap"
                               Style="{ThemeResource BodyTextBlockStyle}"/>
                    <Button x:Name="TipActionButton"
                            Visibility="Collapsed"
                            HorizontalAlignment="Stretch"
                            Padding="8,6"
                            Click="TipActionButton_Click"
                            Style="{ThemeResource AccentButtonStyle}"/>
                </StackPanel>
            </Border>

            <!-- First-run onboarding message (shown only on first run) -->
            <StackPanel x:Name="IntroMessage"
                        Spacing="12"
                        Visibility="Collapsed">
                <TextBlock Text="Welcome to Hatch"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <TextBlock Text="Capture tasks from anywhere in seconds. Click the egg mascot anytime to add a quick task."
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
                <Button Content="Got it!"
                        HorizontalAlignment="Stretch"
                        Padding="8,10"
                        Style="{ThemeResource AccentButtonStyle}"/>
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            </StackPanel>

            <!-- Header with close button -->
            <Grid>
                <TextBlock Text="Add Task" Style="{ThemeResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="2">
                    <Button x:Name="OpenMainWindowButton"
                            ToolTipService.ToolTip="Open main window"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Padding="8"
                            MinWidth="0">
                        <FontIcon Glyph="&#xEB91;" FontSize="12"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Padding="8"
                            MinWidth="0">
                        <FontIcon Glyph="&#xE711;" FontSize="12"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Task title input -->
            <TextBox x:Name="TaskTitleBox"
                     PlaceholderText="What needs to be done?"
                     AcceptsReturn="False"/>

            <!-- List selector -->
            <StackPanel>
                <TextBlock Text="Add to:"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,4"/>
                <ComboBox x:Name="ListSelector"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="No lists yet"/>
            </StackPanel>

            <!-- Due date selector -->
            <StackPanel>
                <TextBlock Text="Due date:"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,4"/>
                <ComboBox x:Name="DatePresetSelector"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="DatePresetSelector_SelectionChanged">
                    <ComboBoxItem x:Name="NoDateItem" Content="No date" IsSelected="True"/>
                    <ComboBoxItem Content="Today"/>
                    <ComboBoxItem Content="Tomorrow"/>
                    <ComboBoxItem Content="This weekend"/>
                    <ComboBoxItem Content="Next week"/>
                </ComboBox>
                </StackPanel>

            <!-- Add button -->
            <Button x:Name="AddButton"
                    Content="Add Task"
                    HorizontalAlignment="Stretch"
                    Padding="8,10"
                    Style="{ThemeResource AccentButtonStyle}"/>

        </StackPanel>

    </Grid>

</Window>
